# EVIE Environment Configuration

# Database
DATABASE_URL=postgresql://evie:evie@postgres:5432/evie?serverVersion=15&charset=utf8

# PostgreSQL Vector Store
PGVECTOR_URL=postgresql://evie:evie@postgres:5432/evie?serverVersion=15&charset=utf8

# Symfony AI
SYMFONY_AI_MISTRAL_URL=https://api.mistral.ai/v1
SYMFONY_AI_MISTRAL_KEY=

# MCP Services
MCP_FILESYSTEM_URL=http://filesystem-mcp:8123
MCP_PLAYWRIGHT_URL=http://playwright-mcp:8931/mcp
MCP_GITHUB_URL=http://github-mcp:8080

# App
APP_ENV=dev
APP_SECRET=
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
TRUSTED_HOSTS='localhost,127.0.0.1'

# Security
SECURITY_GUARD_ALLOWED_SERVICES=App\AI\Skills\Tool\*
SECURITY_GUARD_BLOCKED_RESOURCES=localhost,127.0.0.1,192.168.,10.,172.16.

# Debug
APP_DEBUG=true
MESSENGER_TRANSPORT_DSN=doctrine://default
# Mailer (Symfony Mailer)
MAILER_DSN=smtp://localhost
MAILER_FROM=no-reply@evie.local
