# EVIE Environment Configuration

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://evie:evie@postgres:5432/evie?serverVersion=15&charset=utf8

# PostgreSQL Vector Store
PGVECTOR_URL=postgresql://evie:evie@postgres:5432/evie?serverVersion=15&charset=utf8

# ============================================================================
# SYMFONY AI
# ============================================================================
SYMFONY_AI_MISTRAL_URL=https://api.mistral.ai/v1
SYMFONY_AI_MISTRAL_KEY=

# MCP Services
MCP_FILESYSTEM_URL=http://filesystem-mcp:8123
MCP_PLAYWRIGHT_URL=http://playwright-mcp:8931/mcp
MCP_GITHUB_URL=http://github-mcp:8080

# ============================================================================
# APPLICATION
# ============================================================================
APP_ENV=dev
APP_SECRET=
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
TRUSTED_HOSTS='localhost,127.0.0.1'

# ============================================================================
# SECURITY - SECRET ENCRYPTION (Phase 1)
# ============================================================================
# Master key for AES-256-GCM encryption (32 bytes = 256 bits)
# Generate with: openssl rand -base64 32
# IMPORTANT: This key MUST be kept secret and never committed to version control!
SECRET_ENCRYPTION_KEY=

# Current encryption version (for backward compatibility)
SECRET_ENCRYPTION_VERSION=AES-256-GCM-v1

# Current key version (for key rotation)
SECRET_KEY_VERSION=KEY_V1

# Old key versions (for re-encryption during key rotation)
# SECRET_ENCRYPTION_KEY_KEY_V2=
# SECRET_ENCRYPTION_KEY_KEY_V3=

# ============================================================================
# SECURITY - POLICIES (Phase 14)
# ============================================================================
# JSON-encoded security policies
# Example: {"email:send":"ASK","email:delete":"ASK","database:delete":"DENY"}
# SECURITY_POLICIES=

# ============================================================================
# MESSENGER
# ============================================================================
MESSENGER_TRANSPORT_DSN=doctrine://default

# ============================================================================
# MAILER
# ============================================================================
MAILER_DSN=smtp://localhost
MAILER_FROM=no-reply@evie.local

# ============================================================================
# SECURITY GUARD
# ============================================================================
SECURITY_GUARD_ALLOWED_SERVICES=App\AI\Skills\Tool\*
SECURITY_GUARD_BLOCKED_RESOURCES=localhost,127.0.0.1,192.168.,10.,172.16.

# ============================================================================
# DEBUG
# ============================================================================
APP_DEBUG=true