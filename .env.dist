# EVIE Environment Configuration

# Database
DATABASE_URL=postgresql://evie:evie_password@postgres:5432/evie?serverVersion=15&charset=utf8

# PostgreSQL Vector Store
PGVECTOR_URL=postgresql://evie:evie_password@postgres:5432/evie?serverVersion=15&charset=utf8

# Symfony AI
SYMFONY_AI_MISTRAL_URL=https://api.mistral.ai/v1
SYMFONY_AI_MISTRAL_KEY=

# MCP Services (Docker-Service-Namen siehe docker-compose.yml)
MCP_FILESYSTEM_URL=http://mcp-filesystem:8123
MCP_PLAYWRIGHT_URL=http://mcp-playwright:8931/mcp
MCP_GITHUB_URL=http://github-mcp:8080

# App
APP_ENV=dev
APP_DEBUG=true
APP_SECRET=

TRUSTED_PROXIES='["127.0.0.1","172.16.0.0/12"]'
TRUSTED_HOSTS='["localhost","127.0.0.1"]'

# Security
SECURITY_GUARD_ALLOWED_SERVICES=App\AI\Skills\Tool\*
SECURITY_GUARD_BLOCKED_RESOURCES=localhost,127.0.0.1,192.168.,10.,172.16.
# H-1: Sandbox-Root fuer Datei-Tools (Allowlist). Leer -> Blockliste als Fallback.
FILE_SANDBOX_ROOT=

# Messenger-Transporte
# Dev: alle Transporte teilen sich die Doctrine-DB (queue_name trennt die Queues).
# Prod: Redis (siehe docker-compose.prod.yml) mit separaten Streams pro Transport.
# Mercure (Echtzeit-Streaming, Blueprint Punkt 4). Der Hub laeuft als
# dunglas/mercure:v0.24.2-Container; derselbe Secret signiert Publish- und
# Subscribe-JWTs (MERCURE_PUBLISHER_JWT_KEY bzw. MERCURE_SUBSCRIBER_JWT_KEY).
MERCURE_URL=http://mercure:80/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
MERCURE_JWT_SECRET=change_me
MESSENGER_TRANSPORT_DSN=doctrine://default
MESSENGER_TRANSPORT_DSN_TOOLS=doctrine://default
MESSENGER_TRANSPORT_DSN_STREAMING=doctrine://default
MESSENGER_TRANSPORT_DSN_HITL=doctrine://default
MESSENGER_TRANSPORT_DSN_FAILED=doctrine://default?queue_name=failed

# Mailer (Symfony Mailer)
MAILER_DSN=smtp://localhost
MAILER_FROM=no-reply@evie.local
