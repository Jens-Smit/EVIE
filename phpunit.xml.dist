<?xml version="1.0" encoding="UTF-8"?>
<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<!-- Updated for Phase 3: E2E-Tests for Evolution Flow -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.0/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         requireCoverageMetadata="false"
         beStrictAboutCoverageMetadata="false"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true">
    
    <!-- Test Suites -->
    <testsuites>
        <!-- Haupt-Test-Suite -->
        <testsuite name="Application Test Suite">
            <directory>tests</directory>
            <exclude>tests/Unit/AI</exclude>
            <exclude>tests/Integration/AI</exclude>
            <exclude>tests/Functional/AI</exclude>
            <exclude>tests/E2E</exclude>
        </testsuite>

        <!-- EVIE AI Komponenten Tests -->
        <testsuite name="EVIE AI Unit Tests">
            <directory>tests/Unit/AI</directory>
        </testsuite>

        <testsuite name="EVIE AI Integration Tests">
            <directory>tests/Integration/AI</directory>
        </testsuite>

        <!-- PHASE 3: Neue Test-Suite fuer Evolution-Flow -->
        <testsuite name="EVIE AI Functional Tests">
            <directory>tests/Functional/AI</directory>
        </testsuite>

        <!-- E2E-Tests: Authentifizierungs-Flows (Login, Registrierung, Logout, Navigation, Profil) -->
        <testsuite name="E2E Tests">
            <directory>tests/E2E</directory>
        </testsuite>

        <!-- Spezifische Test-Suites fuer AI-Komponenten -->
        <testsuite name="EVIE AI Security Tests">
            <directory>tests/Unit/AI/Security</directory>
        </testsuite>

        <testsuite name="EVIE AI Skills Tests">
            <directory>tests/Unit/AI/Skills</directory>
        </testsuite>

        <testsuite name="EVIE AI Agent Tests">
            <directory>tests/Unit/AI/Agent</directory>
        </testsuite>

        <!-- PHASE 3: Spezifische Test-Suite fuer Evolution-Flow -->
        <testsuite name="EVIE Phase 3 Tests">
            <file>tests/Functional/AI/ToolEvolutionTest.php</file>
            <file>tests/Unit/AI/Skills/DynamicSkillRegistryTest.php</file>
        </testsuite>
    </testsuites>

    <!-- Source Configuration -->
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <file>src/Kernel.php</file>
        </exclude>
    </source>

    <!-- PHP-Einstellungen: force=false setzt Werte nur, wenn nicht bereits als Umgebungsvariable definiert.
         So kann die E2E-Suite auch gegen dev/prod laufen (APP_ENV=dev + DATABASE_URL von aussen). -->
    <php>
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="false" />
        <server name="APP_SECRET" value="test-secret-for-evie-1234567890abcdef" force="false" />
        <server name="DATABASE_URL" value="sqlite:///%kernel.project_dir%/var/test.db" force="false" />
        <server name="MAILER_DSN" value="null://null" force="false" />
        <server name="MAILER_FROM" value="no-reply@evie.test" force="false" />
        <server name="KERNEL_CLASS" value="App\Kernel" force="false" />
        <server name="SYMFONY_DEPRECATIONS_HELPER" value="weak_vendors" force="false" />
        
        <!-- PHASE 3: Test-Konfiguration fuer AI Bundle -->
        <server name="AI_TEST_MODE" value="true" force="false" />
        <server name="AI_PLATFORM" value="mock" force="false" />
    </php>

</phpunit>
