# EVIE Environment Configuration

# =====================================================================
# Database Configuration (PostgreSQL)
# =====================================================================
DATABASE_URL="postgresql://evie:evie_password@evie-db:5432/evie?serverVersion=15&charset=utf8"

# =====================================================================
# LLM Provider API Keys (for Multi-LLM Support)
# =====================================================================
# Mistral AI
MISTRAL_API_KEY="your_mistral_api_key_here"

# OpenAI
OPENAI_API_KEY="your_openai_api_key_here"

# Google (Gemini)
GOOGLE_API_KEY="your_google_api_key_here"

# Anthropic (Claude)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# =====================================================================
# Default LLM Configuration
# =====================================================================
DEFAULT_LLM_PROVIDER=mistral
DEFAULT_LLM_MODEL=mistral-small-latest

# =====================================================================
# Encryption Key (for User Secrets)
# Must be exactly 32 bytes (256 bits) for AES-256-CBC
# Generate with: openssl rand -base64 32
# =====================================================================
ENCRYPTION_KEY="your_32_byte_encryption_key_here"

# =====================================================================
# Messenger Transport (for Async Sub-Agent Execution)
# =====================================================================
MESSENGER_TRANSPORT_DSN=doctrine://default

# =====================================================================
# MCP Services
# =====================================================================
MCP_FILESYSTEM_URL=http://filesystem-mcp:8123
MCP_PLAYWRIGHT_URL=http://playwright-mcp:8931/mcp
MCP_GITHUB_URL=http://github-mcp:8080

# =====================================================================
# Other API Keys (for Tools)
# =====================================================================
OPENWEATHER_API_KEY="your_openweathermap_api_key_here"
FIRECRAWL_API_KEY="your_firecrawl_api_key_here"
TAVILY_API_KEY="your_tavily_api_key_here"
LINKEDIN_API_TOKEN="your_linkedin_api_token_here"

# =====================================================================
# Application Configuration
# =====================================================================
APP_ENV=dev
APP_SECRET=your_random_secret_here
APP_DEBUG=1

# Trusted Proxies
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
TRUSTED_HOSTS='localhost,127.0.0.1'

# =====================================================================
# Security Configuration
# =====================================================================
SECURITY_GUARD_ALLOWED_SERVICES=App\AI\Skills\Tool\*
SECURITY_GUARD_BLOCKED_RESOURCES=localhost,127.0.0.1,192.168.,10.,172.16.

# =====================================================================
# Mailer Configuration (Symfony Mailer)
# =====================================================================
MAILER_DSN=smtp://localhost
MAILER_FROM=no-reply@evie.local
