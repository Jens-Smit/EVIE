# EVIE Environment Configuration

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://evie:evie_password@evie-db:5432/evie?serverVersion=15&charset=utf8"

# Mistral API Configuration (for Symfony AI Bundle)
MISTRAL_API_KEY="your_mistral_api_key_here"

# OpenWeatherMap API Configuration (for weather tool)
OPENWEATHER_API_KEY="your_openweathermap_api_key_here"

# GitHub MCP URL (if used)
GITHUB_MCP_URL="https://api.github.com"

# Firecrawl API Configuration (for web scraping)
FIRECRAWL_API_KEY="your_firecrawl_api_key_here"

# Tavily API Configuration (for web search)
TAVILY_API_KEY="your_tavily_api_key_here"

# LinkedIn API Configuration (for LinkedIn tool)
LINKEDIN_API_TOKEN="your_linkedin_api_token_here"

# App Environment
APP_ENV=dev
APP_SECRET=your_random_secret_here

# Debug
APP_DEBUG=1
