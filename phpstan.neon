parameters:
    level: 5
    paths:
        - src

    # Pre-existing PHPStan-Fehler, die vor Entfernung des `|| true`-Bypasses
    # verdeckt waren. Diese werden als known issues ignoriert, sodass nur
    # NEUE Fehler (durch kuenftige Aenderungen) das Gate blockieren.
    # Ein PHPStan-Baseline-File sollte langfristig generiert werden.
    ignoreErrors:
        - '#Call to an undefined method App\\AI\\Onboarding\\ContextStoreManager::#'
        - '#Call to an undefined method App\\AI\\Rag\\ContextInjector::injectForSystemPrompt#'
        - '#Call to an undefined method App\\AI\\Security\\SecurityGuard::validateToolConfiguration#'
        - '#Call to an undefined method App\\AI\\Skills\\ToolDefinitionGenerator::generateFromRequest#'
        - '#Call to an undefined method App\\AI\\Skills\\Tool\\DynamicToolExecutor::getAvailableTools#'
        - '#Call to an undefined method App\\AI\\Skills\\Tool\\DynamicToolFactory::createFromDefinition#'
        - '#Call to an undefined method App\\AI\\Skills\\Tool\\DynamicTool::getDefinition#'
        - '#Call to an undefined method App\\AI\\Skills\\Tool\\ToolExecutionResult::getError#'
        - '#Call to an undefined method App\\DataFixtures\\UserProfileFixture::addReference#'
        - '#Call to an undefined method App\\Entity\\ToolCategory::setColor#'
        - '#Call to an undefined method App\\Entity\\ToolDefinition::set#'
        - '#Call to an undefined method App\\Entity\\UserProfile::#'
        - '#Call to an undefined method Doctrine\\DBAL\\Statement::fetchAllAssociative#'
        - '#Call to an undefined method Symfony\\AI\\Platform\\Message\\MessageInterface::asText#'
        - '#Call to an undefined method Symfony\\Component\\Cache\\Adapter\\AdapterInterface::#'
        - '#Property App\\AI\\Agent\\OrchestratorDialogService::\$faultTolerantValidator is never read, only written#'
        - '#Property App\\AI\\Agent\\SubAgentFactory::\$params is never read, only written#'
        - '#Property App\\AI\\Onboarding\\ContextStoreManager::\$logger is never read, only written#'
        - '#Method App\\AI\\Agent\\OrchestratorDialogService::isNoToolFoundResponse\(\) is unused#'
        - '#Method App\\AI\\Agent\\OrchestratorDialogService::isSubAgentSuggested\(\) is unused#'
        - '#PHPDoc tag @implements has invalid value#'
        - '#Method App\\AI\\Mcp\\McpToolExecutor::getActiveServerDefinitions\(\) has invalid return type#'
        - '#Method App\\AI\\Mcp\\McpToolExecutor::getActiveServerDefinitions\(\) should return#'
        - "#Offset 'onboarding_data' on array#"
        - "#Offset 'next_step' on array#"
