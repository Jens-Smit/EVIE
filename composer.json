{
  "name": "jens-smit/evie",
  "description": "Self-evolving AI Agent Platform",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-pdo_pgsql": "*",
    "ext-json": "*",
    "symfony/symfony": "^7.0",
    "symfony/framework-bundle": "^7.0",
    "symfony/security-bundle": "^7.0",
    "symfony/twig-bundle": "^7.0",
    "symfony/webprofiler-bundle": "^7.0",
    "symfony/debug-bundle": "^7.0",
    "symfony/maker-bundle": "^1.50",
    "symfony/ai": "^1.0",
    "symfony/ai-postgres-store": "^1.0",
    "symfony/doctrine-bundle": "^7.0",
    "symfony/doctrine-messenger": "^7.0",
    "symfony/orm-pack": "^7.0",
    "doctrine/doctrine-bundle": "^2.10",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/dbal": "^3.7",
    "pgvector/pgvector": "^0.1",
    "symfony/runtime": "^7.0",
    "symfony/flex": "^2.4",
    "symfony/console": "^7.0",
    "symfony/http-client": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.10",
    "symfony/phpunit-bridge": "^7.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist",
      "symfony/*": "dist"
    },
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true,
      "php-http/discovery": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "auto-scripts-config": {
      "cache:clear": ["@on-change"],
      "assets:install %PUBLIC_DIR%": ["@on-change"]
    }
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "id": "01H5Z5V2K6J7Q8R9S0T1U2V3W4",
      "allow-contrib": false,
      "require": true
    }
  }
}
