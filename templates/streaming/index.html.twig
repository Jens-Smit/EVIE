{# templates/streaming/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Streaming-Sessions - EVIE{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto p-4 sm:p-6 lg:p-8">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-content">
                <i class="ph ph-rainbow"></i>
                Streaming-Sessions
            </h1>
            <p class="text-sm text-content-subtle mt-1">
                Echtzeit-Streaming von Tool-Ausfhrungen und Agenten-Antworten
            </p>
        </div>
        <div class="flex gap-2">
            <a href="{{ path('app_streaming_session_new') }}"
               class="btn btn-primary px-4 py-2 text-sm">
                <i class="ph ph-plus"></i>
                Neue Session
            </a>
            <a href="{{ path('app_streaming_sessions') }}"
               hx-get="{{ path('app_streaming_sessions') }}"
               hx-trigger="every 30s"
               class="btn btn-ghost px-4 py-2 text-sm">
                <i class="ph ph-refresh"></i>
                Aktualisieren
            </a>
        </div>
    </div>

    {# Statistiken #}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-4">
            <div class="flex items-center gap-2 text-content-subtle mb-1">
                <i class="ph ph-rainbow"></i>
                <span class="text-sm">Gesamt</span>
            </div>
            <div class="text-2xl font-bold text-content">{{ sessions|length }}</div>
        </div>
        <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-4">
            <div class="flex items-center gap-2 text-content-subtle mb-1">
                <i class="ph ph-play-circle"></i>
                <span class="text-sm">Aktiv</span>
            </div>
            <div class="text-2xl font-bold text-green-600 dark:text-green-400">{{ activeSessions|length }}</div>
        </div>
        <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-4">
            <div class="flex items-center gap-2 text-content-subtle mb-1">
                <i class="ph ph-check-circle"></i>
                <span class="text-sm">Abgeschlossen</span>
            </div>
            <div class="text-2xl font-bold text-blue-600 dark:text-blue-400">{{ sessions|filter(s => s.status == 'completed')|length }}</div>
        </div>
        <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-4">
            <div class="flex items-center gap-2 text-content-subtle mb-1">
                <i class="ph ph-x-circle"></i>
                <span class="text-sm">Abgebrochen</span>
            </div>
            <div class="text-2xl font-bold text-red-600 dark:text-red-400">{{ sessions|filter(s => s.status == 'cancelled')|length }}</div>
        </div>
    </div>

    {# Aktive Sessions #}
    {% if activeSessions|length > 0 %}
        <div class="mb-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-semibold text-content">
                    <i class="ph ph-play-circle text-green-600"></i>
                    Aktive Sessions ({{ activeSessions|length }})
                </h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for session in activeSessions %}
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-border shadow-sm hover:shadow-md transition-shadow">
                        <div class="p-4">
                            <div class="flex items-start justify-between mb-2">
                                <div class="flex-1">
                                    <h3 class="font-semibold text-content truncate">
                                        Session #{{ session.sessionId|slice(0, 8) }}
                                    </h3>
                                    <p class="text-xs text-content-subtle mt-1">
                                        Tool: <code class="text-primary">{{ session.toolName }}</code>
                                    </p>
                                </div>
                                <span class="px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-xs font-medium rounded-full">
                                    Aktiv
                                </span>
                            </div>
                            <div class="flex items-center gap-4 text-xs text-content-subtle">
                                <span class="flex items-center gap-1">
                                    <i class="ph ph-clock"></i>
                                    {{ session.createdAt|date('H:i:s') }}
                                </span>
                                <span class="flex items-center gap-1">
                                    <i class="ph ph-database"></i>
                                    {{ session.messages|length }} Nachrichten
                                </span>
                            </div>
                        </div>
                        <div class="border-t border-border px-4 py-3">
                            <div class="flex justify-end gap-2">
                                <a href="{{ path('app_streaming_session_show', {'sessionId': session.sessionId}) }}"
                                   class="btn btn-ghost btn-sm text-content-subtle hover:text-content">
                                    <i class="ph ph-eye"></i>
                                    Details
                                </a>
                                <a href="{{ path('api_streaming_session_stream', {'sessionId': session.sessionId}) }}"
                                   class="btn btn-ghost btn-sm text-content-subtle hover:text-content">
                                    <i class="ph ph-rainbow"></i>
                                    Stream
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# Abgeschlossene Sessions #}
    {% if sessions|length > 0 %}
        <div class="mb-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-semibold text-content">
                    <i class="ph ph-archive"></i>
                    Letzte Sessions ({{ sessions|length }})
                </h2>
            </div>
            <div class="bg-white dark:bg-slate-800 rounded-xl border border-border overflow-hidden">
                <table class="w-full">
                    <thead class="bg-slate-50 dark:bg-slate-900">
                        <tr>
                            <th class="text-left p-4 text-xs font-semibold text-content-subtle uppercase">Session ID</th>
                            <th class="text-left p-4 text-xs font-semibold text-content-subtle uppercase">Tool</th>
                            <th class="text-left p-4 text-xs font-semibold text-content-subtle uppercase">Status</th>
                            <th class="text-left p-4 text-xs font-semibold text-content-subtle uppercase">Nachrichten</th>
                            <th class="text-left p-4 text-xs font-semibold text-content-subtle uppercase">Erstellt</th>
                            <th class="text-right p-4 text-xs font-semibold text-content-subtle uppercase">Aktionen</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        {% for session in sessions|slice(0, 20) %}
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/50 transition-colors">
                                <td class="p-4 text-content font-mono text-sm">
                                    {{ session.sessionId|slice(0, 8) }}...
                                </td>
                                <td class="p-4 text-content-subtle">
                                    <code class="text-primary">{{ session.toolName }}</code>
                                </td>
                                <td class="p-4">
                                    {% if session.status == 'active' %}
                                        <span class="px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-xs font-medium rounded-full">
                                            Aktiv
                                        </span>
                                    {% elseif session.status == 'completed' %}
                                        <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 text-xs font-medium rounded-full">
                                            Abgeschlossen
                                        </span>
                                    {% elseif session.status == 'cancelled' %}
                                        <span class="px-2 py-1 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 text-xs font-medium rounded-full">
                                            Abgebrochen
                                        </span>
                                    {% elseif session.status == 'error' %}
                                        <span class="px-2 py-1 bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-400 text-xs font-medium rounded-full">
                                            Fehler
                                        </span>
                                    {% else %}
                                        <span class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-medium rounded-full">
                                            {{ session.status }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="p-4 text-content-subtle">
                                    {{ session.messages|length }}
                                </td>
                                <td class="p-4 text-content-subtle text-xs whitespace-nowrap">
                                    {{ session.createdAt|date('Y-m-d H:i') }}
                                </td>
                                <td class="p-4">
                                    <div class="flex justify-end gap-2">
                                        <a href="{{ path('app_streaming_session_show', {'sessionId': session.sessionId}) }}"
                                           class="btn btn-ghost btn-sm text-content-subtle hover:text-content">
                                            <i class="ph ph-eye"></i>
                                        </a>
                                        <a href="#"
                                           onclick="if(confirm('Soll diese Session gel\u00f6scht werden?')) { fetch('{{ path('api_streaming_session_delete', {'sessionId': session.sessionId}) }}', {method: 'DELETE'}).then(() => location.reload()); }"
                                           class="btn btn-ghost btn-sm text-danger hover:bg-danger-soft">
                                            <i class="ph ph-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="p-8 text-center text-content-subtle">
                                    <i class="ph ph-inbox text-2xl mb-2"></i>
                                    <p>Keine Sessions gefunden.</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    {# Keine Sessions #}
    {% if sessions|length == 0 and activeSessions|length == 0 %}
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-border p-8 text-center">
            <i class="ph ph-rainbow text-4xl text-content-muted mb-4"></i>
            <h2 class="text-xl font-semibold text-content mb-2">Keine Streaming-Sessions</h2>
            <p class="text-content-subtle mb-6">
                Starte eine neue Session, um Tool-Ausfhrungen in Echtzeit zu streamen.
            </p>
            <a href="{{ path('app_streaming_session_new') }}" class="btn btn-primary">
                <i class="ph ph-plus"></i>
                Neue Streaming-Session starten
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Auto-refresh alle 30 Sekunden
        setInterval(() => {
            location.reload();
        }, 30000);
    </script>
{% endblock %}
