{# templates/streaming/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Session #{{ session.sessionId }} - EVIE{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto p-4 sm:p-6 lg:p-8">
    <div class="mb-6">
        <a href="{{ path('app_streaming_sessions') }}"
           class="inline-flex items-center gap-2 text-content-subtle hover:text-content transition-colors">
            <i class="ph ph-caret-left"></i>
            Zurück zu allen Sessions
        </a>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-border overflow-hidden">
        <div class="p-6 border-b border-border">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-xl font-bold text-content">
                        <i class="ph ph-rainbow"></i>
                        Session #{{ session.sessionId }}
                    </h1>
                    <p class="text-sm text-content-subtle mt-1">
                        Tool: <code class="text-primary">{{ session.toolName }}</code>
                    </p>
                </div>
                <div class="flex gap-2" id="session-status-badges">
                    <span id="live-indicator" class="hidden px-3 py-1 bg-slate-100 dark:bg-slate-700 text-content-subtle text-sm font-medium rounded-full">
                        <i class="ph ph-broadcast"></i>
                        Live
                    </span>
                    {% if session.isActive %}
                        <span class="px-3 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-sm font-medium rounded-full">
                            <i class="ph ph-play-circle"></i>
                            Aktiv
                        </span>
                    {% elseif session.status == 'completed' %}
                        <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 text-sm font-medium rounded-full">
                            <i class="ph ph-check-circle"></i>
                            Abgeschlossen
                        </span>
                    {% elseif session.status == 'cancelled' %}
                        <span class="px-3 py-1 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 text-sm font-medium rounded-full">
                            <i class="ph ph-x-circle"></i>
                            Abgebrochen
                        </span>
                    {% elseif session.status == 'failed' %}
                        <span class="px-3 py-1 bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-400 text-sm font-medium rounded-full">
                            <i class="ph ph-warning-circle"></i>
                            Fehler
                        </span>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <h3 class="text-sm font-semibold text-content-subtle uppercase mb-2">
                        Session-Informationen
                    </h3>
                    <dl class="space-y-2">
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">Session-ID</dt>
                            <dd class="text-content font-mono text-sm">{{ session.sessionId }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">Tool</dt>
                            <dd class="text-content">{{ session.toolName }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">Status</dt>
                            <dd class="text-content" id="session-status-value">{{ session.status }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">Erstellt</dt>
                            <dd class="text-content">{{ session.createdAt|date('d.m.Y H:i:s') }}</dd>
                        </div>
                    </dl>
                </div>
                <div>
                    <h3 class="text-sm font-semibold text-content-subtle uppercase mb-2">
                        Statistik
                    </h3>
                    <dl class="space-y-2">
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">Zwischenergebnisse</dt>
                            <dd class="text-content">{{ session.partialResults|length }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">User</dt>
                            <dd class="text-content font-mono text-sm">{{ session.userIdentifier }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">Fehler</dt>
                            <dd class="text-content">{{ session.errorData ? 1 : 0 }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">Dauer</dt>
                            <dd class="text-content">
                                {% if session.duration is not null %}
                                    {{ session.duration }}s
                                {% else %}
                                    Läuft noch...
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            {# Nachrichten #}
            {% if session.partialResults|length > 0 %}
                <div class="mb-6">
                    <h3 class="text-lg font-semibold text-content mb-3">
                        <i class="ph ph-chat-circle"></i>
                        Zwischenergebnisse ({{ session.partialResults|length }})
                    </h3>
                    <div class="bg-slate-50 dark:bg-slate-700 rounded-lg p-4 space-y-4">
                        {% for result in session.partialResults %}
                            <div class="flex gap-3 p-3 bg-white dark:bg-slate-600 rounded-lg border border-border">
                                <div class="flex-shrink-0">
                                    <div class="w-8 h-8 rounded-full bg-success-soft flex items-center justify-center">
                                        <i class="ph ph-robot text-success"></i>
                                    </div>
                                </div>
                                <div class="flex-1">
                                    <div class="text-content whitespace-pre-wrap">{{ result is iterable ? (result|json_encode(constant('JSON_PRETTY_PRINT'))) : result }}</div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {# Fehler #}
            {% if session.errorData is not null %}
                <div class="mb-6">
                    <h3 class="text-lg font-semibold text-danger mb-3">
                        <i class="ph ph-warning-circle"></i>
                        Fehler
                    </h3>
                    <div class="bg-red-50 dark:bg-red-900/20 rounded-lg p-4 space-y-3">
                        <div class="flex gap-3">
                            <div class="flex-shrink-0">
                                <i class="ph ph-x-circle text-danger text-xl"></i>
                            </div>
                            <div class="flex-1">
                                <div class="text-sm text-danger font-medium mb-1">
                                    {{ session.errorData.type ?? session.errorData.error ?? 'Fehler' }}
                                </div>
                                <div class="text-content-subtle text-sm whitespace-pre-wrap">
                                    {{ session.errorData.message ?? session.errorData|json_encode }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Live-Feed: Echtzeit-Events vom Mercure-Hub (Blueprint Punkt 4) #}
            <div id="live-feed" class="hidden mb-6">
                <h3 class="text-lg font-semibold text-content mb-3">
                    <i class="ph ph-broadcast"></i>
                    Live-Feed
                </h3>
                <div class="bg-slate-50 dark:bg-slate-700 rounded-lg p-4">
                    <div id="live-progress-bar" class="hidden w-full bg-slate-200 dark:bg-slate-600 rounded-full h-2 mb-4">
                        <div id="live-progress-fill" class="bg-primary h-2 rounded-full transition-all" style="width: 0%"></div>
                    </div>
                    <div id="live-messages" class="space-y-2"></div>
                </div>
            </div>

            {# Aktionen #}
            <div class="flex justify-end gap-2 pt-4 border-t border-border">
                {% if session.isActive %}
                    <a href="{{ path('api_streaming_session_stream', {'sessionId': session.sessionId}) }}"
                       class="btn btn-primary px-4 py-2 text-sm">
                        <i class="ph ph-rainbow"></i>
                        Live-Stream
                    </a>
                    <a href="{{ path('api_streaming_session_cancel', {'sessionId': session.sessionId}) }}"
                       onclick="if(confirm('Soll diese Session wirklich abgebrochen werden?')) { fetch(this.href, {method: 'POST'}).then(() => location.reload()); return false; }"
                       class="btn btn-ghost text-danger px-4 py-2 text-sm">
                        <i class="ph ph-stop-circle"></i>
                        Abbrechen
                    </a>
                {% endif %}
                <a href="#"
                   onclick="if(confirm('Soll diese Session gel\u00f6scht werden?')) { fetch('{{ path('api_streaming_session_delete', {'sessionId': session.sessionId}) }}', {method: 'DELETE'}).then(() => window.location.href = '{{ path('app_streaming_sessions') }}'); }"
                   class="btn btn-ghost text-danger px-4 py-2 text-sm">
                    <i class="ph ph-trash"></i>
                    Löschen
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            'use strict';

            const statusValue = document.getElementById('session-status-value');
            const liveIndicator = document.getElementById('live-indicator');
            const liveFeed = document.getElementById('live-feed');
            const liveMessages = document.getElementById('live-messages');
            const progressBar = document.getElementById('live-progress-bar');
            const progressFill = document.getElementById('live-progress-fill');

            if (!liveFeed || !['running', 'pending'].includes('{{ session.status }}')) {
                return;
            }

            const topic = '/streaming/sessions/{{ session.sessionId }}';
            const hubUrl = "{{ mercure('/streaming/sessions/' ~ session.sessionId)|escape('js') }}";
            const eventSource = new EventSource(hubUrl);

            liveFeed.classList.remove('hidden');
            liveIndicator.classList.remove('hidden');

            function addLiveMessage(role, content, timestamp) {
                const wrapper = document.createElement('div');
                wrapper.className = 'flex gap-2 items-start';

                const icon = document.createElement('i');
                icon.className = role === 'error'
                    ? 'ph ph-warning-circle text-danger' : 'ph ph-rainbow text-primary';
                wrapper.appendChild(icon);

                const body = document.createElement('div');
                body.className = 'text-content text-sm whitespace-pre-wrap flex-1';
                body.textContent = content;
                wrapper.appendChild(body);

                liveMessages.appendChild(wrapper);
            }

            function setProgress(percentage) {
                if (percentage === null || percentage === undefined) {
                    progressBar.classList.add('hidden');
                    return;
                }
                progressBar.classList.remove('hidden');
                progressFill.style.width = Math.min(100, Math.max(0, Number(percentage))) + '%';
            }

            function markEnded(finalStatus) {
                statusValue.textContent = finalStatus;
                liveIndicator.classList.add('hidden');
                eventSource.close();
            }

            eventSource.onmessage = function (event) {
                let payload;
                try {
                    payload = JSON.parse(event.data);
                } catch (e) {
                    return;
                }

                const eventType = payload.event || 'data';
                const data = payload.data || {};

                switch (eventType) {
                    case 'session_start':
                        if (data.status) {
                            statusValue.textContent = data.status;
                        }
                        setProgress(data.progress);
                        addLiveMessage('info', 'Session gestartet: ' + (data.tool_name || ''));
                        break;
                    case 'progress':
                        if (data.message) {
                            addLiveMessage('info', data.message);
                        }
                        setProgress(data.percentage);
                        break;
                    case 'partial_result':
                    case 'final_result':
                    case 'data':
                    case 'log':
                    case 'status':
                        if (data.message) {
                            addLiveMessage('info', data.message);
                        } else if (data.chunk) {
                            addLiveMessage('info', data.chunk);
                        }
                        if (data.progress !== undefined && data.progress !== null) {
                            setProgress(data.progress * 100);
                        }
                        break;
                    case 'error':
                        addLiveMessage('error', data.error || data.chunk || 'Unbekannter Fehler');
                        break;
                    case 'session_end':
                        if (data.metadata && data.metadata.message) {
                            addLiveMessage('info', data.metadata.message);
                        }
                        setProgress(100);
                        markEnded(data.final_status || 'completed');
                        break;
                    default:
                        if (data.message) {
                            addLiveMessage('info', data.message);
                        }
                }
            };

            eventSource.onerror = function () {
                eventSource.close();
                liveIndicator.classList.add('hidden');
            };
        })();
    </script>
{% endblock %}
