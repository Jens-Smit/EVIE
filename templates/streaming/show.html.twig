{# templates/streaming/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Session #{{ session.sessionId }} - EVIE{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto p-4 sm:p-6 lg:p-8">
    <div class="mb-6">
        <a href="{{ path('app_streaming_sessions') }}"
           class="inline-flex items-center gap-2 text-content-subtle hover:text-content transition-colors">
            <i class="ph ph-caret-left"></i>
            Zurck zu allen Sessions
        </a>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-border overflow-hidden">
        <div class="p-6 border-b border-border">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-xl font-bold text-content">
                        <i class="ph ph-rainbow"></i>
                        Session #{{ session.sessionId }}
                    </h1>
                    <p class="text-sm text-content-subtle mt-1">
                        Tool: <code class="text-primary">{{ session.toolName }}</code>
                    </p>
                </div>
                <div class="flex gap-2">
                    {% if session.status == 'active' %}
                        <span class="px-3 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-sm font-medium rounded-full">
                            <i class="ph ph-play-circle"></i>
                            Aktiv
                        </span>
                    {% elseif session.status == 'completed' %}
                        <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 text-sm font-medium rounded-full">
                            <i class="ph ph-check-circle"></i>
                            Abgeschlossen
                        </span>
                    {% elseif session.status == 'cancelled' %}
                        <span class="px-3 py-1 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 text-sm font-medium rounded-full">
                            <i class="ph ph-x-circle"></i>
                            Abgebrochen
                        </span>
                    {% elseif session.status == 'error' %}
                        <span class="px-3 py-1 bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-400 text-sm font-medium rounded-full">
                            <i class="ph ph-warning-circle"></i>
                            Fehler
                        </span>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div>
                    <h3 class="text-sm font-semibold text-content-subtle uppercase mb-2">
                        Session-Informationen
                    </h3>
                    <dl class="space-y-2">
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">Session-ID</dt>
                            <dd class="text-content font-mono text-sm">{{ session.sessionId }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">Tool</dt>
                            <dd class="text-content">{{ session.toolName }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">Status</dt>
                            <dd class="text-content">{{ session.status }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">Erstellt</dt>
                            <dd class="text-content">{{ session.createdAt|date('d.m.Y H:i:s') }}</dd>
                        </div>
                    </dl>
                </div>
                <div>
                    <h3 class="text-sm font-semibold text-content-subtle uppercase mb-2">
                        Statistik
                    </h3>
                    <dl class="space-y-2">
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">Nachrichten</dt>
                            <dd class="text-content">{{ session.messages|length }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">User</dt>
                            <dd class="text-content font-mono text-sm">{{ session.userIdentifier }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">Fehler</dt>
                            <dd class="text-content">{{ session.errorCount ?? 0 }}</dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-content-subtle">Dauer</dt>
                            <dd class="text-content">
                                {% if session.finishedAt %}
                                    {{ session.finishedAt|date('H:i:s') }} ({{ (session.finishedAt - session.createdAt)|date('H:i:s') }})
                                {% else %}
                                    Luft noch...
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>

            {# Nachrichten #}
            {% if session.messages|length > 0 %}
                <div class="mb-6">
                    <h3 class="text-lg font-semibold text-content mb-3">
                        <i class="ph ph-chat-circle"></i>
                        Nachrichten ({{ session.messages|length }})
                    </h3>
                    <div class="bg-slate-50 dark:bg-slate-700 rounded-lg p-4 space-y-4">
                        {% for message in session.messages %}
                            <div class="flex gap-3 p-3 bg-white dark:bg-slate-600 rounded-lg border border-border">
                                <div class="flex-shrink-0">
                                    {% if message.role == 'user' %}
                                        <div class="w-8 h-8 rounded-full bg-primary-soft flex items-center justify-center">
                                            <i class="ph ph-user text-primary"></i>
                                        </div>
                                    {% else %}
                                        <div class="w-8 h-8 rounded-full bg-success-soft flex items-center justify-center">
                                            <i class="ph ph-robot text-success"></i>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="text-xs font-medium 
                                              {% if message.role == 'user' %}text-primary
                                              {% else %}text-success{% endif %}">
                                            {{ message.role }}
                                        </span>
                                        <span class="text-xs text-content-subtle">
                                            {{ message.timestamp|date('H:i:s') }}
                                        </span>
                                    </div>
                                    <div class="text-content whitespace-pre-wrap">
                                        {{ message.content }}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {# Fehler #}
            {% if session.errors|length > 0 %}
                <div class="mb-6">
                    <h3 class="text-lg font-semibold text-danger mb-3">
                        <i class="ph ph-warning-circle"></i>
                        Fehler ({{ session.errors|length }})
                    </h3>
                    <div class="bg-red-50 dark:bg-red-900/20 rounded-lg p-4 space-y-3">
                        {% for error in session.errors %}
                            <div class="flex gap-3">
                                <div class="flex-shrink-0">
                                    <i class="ph ph-x-circle text-danger text-xl"></i>
                                </div>
                                <div class="flex-1">
                                    <div class="text-sm text-danger font-medium mb-1">
                                        {{ error.type ?? 'Fehler' }}
                                    </div>
                                    <div class="text-content-subtle text-sm whitespace-pre-wrap">
                                        {{ error.message }}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {# Aktionen #}
            <div class="flex justify-end gap-2 pt-4 border-t border-border">
                {% if session.status == 'active' %}
                    <a href="{{ path('api_streaming_session_stream', {'sessionId': session.sessionId}) }}"
                       class="btn btn-primary px-4 py-2 text-sm">
                        <i class="ph ph-rainbow"></i>
                        Live-Stream
                    </a>
                    <a href="{{ path('api_streaming_session_cancel', {'sessionId': session.sessionId}) }}"
                       onclick="if(confirm('Soll diese Session wirklich abgebrochen werden?')) { fetch(this.href, {method: 'POST'}).then(() => location.reload()); return false; }"
                       class="btn btn-ghost text-danger px-4 py-2 text-sm">
                        <i class="ph ph-stop-circle"></i>
                        Abbrechen
                    </a>
                {% endif %}
                <a href="#"
                   onclick="if(confirm('Soll diese Session gel\u00f6scht werden?')) { fetch('{{ path('api_streaming_session_delete', {'sessionId': session.sessionId}) }}', {method: 'DELETE'}).then(() => window.location.href = '{{ path('app_streaming_sessions') }}'); }"
                   class="btn btn-ghost text-danger px-4 py-2 text-sm">
                    <i class="ph ph-trash"></i>
                    Lschen
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
