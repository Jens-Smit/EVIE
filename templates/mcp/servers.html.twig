{# templates/mcp/servers.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}MCP-Server Verwaltung - EVIE{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">MCP-Server</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">
            <i class="fas fa-server me-2"></i>
            MCP-Server Verwaltung
        </h1>
        <a href="{{ path('mcp_server_new') }}" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Neuer MCP-Server
        </a>
    </div>

    {% if app.session.flashBag.has('success') %}
        {% for message in app.session.flashBag.get('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endif %}

    {% if app.session.flashBag.has('error') %}
        {% for message in app.session.flashBag.get('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endif %}

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-list me-2"></i>
                MCP-Server Liste
            </h5>
        </div>
        <div class="card-body p-0">
            {% if servers|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Typ</th>
                                <th>Beschreibung</th>
                                <th>Status</th>
                                <th>Tools</th>
                                <th>Aktionen</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for server in servers %}
                                <tr>
                                    <td>
                                        <strong>{{ server.name }}</strong>
                                        {% if server.description %}
                                            <br>
                                            <small class="text-muted">{{ server.description|truncate(50) }}</small>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge bg-{{ server.type == 'filesystem' ? 'primary' : server.type == 'playwright' ? 'success' : server.type == 'github' ? 'info' : 'secondary' }}">
                                            {{ availableTypes[server.type] ?? server.type }}
                                        </span>
                                    </td>
                                    <td>{{ server.description|default('-')|truncate(100) }}</td>
                                    <td>
                                        {% if server.isActive %}
                                            <span class="badge bg-success">Aktiv</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Inaktiv</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if server.allowedTools|length > 0 %}
                                            <span class="badge bg-info">
                                                {{ server.allowedTools|length }} Tools
                                            </span>
                                        {% else %}
                                            <span class="text-muted">Alle</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a href="{{ path('mcp_server_show', {'name': server.name}) }}" 
                                               class="btn btn-outline-primary" 
                                               title="Anzeigen">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="{{ path('mcp_server_edit', {'name': server.name}) }}" 
                                               class="btn btn-outline-secondary" 
                                               title="Bearbeiten">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            {% if server.isActive %}
                                                <form action="{{ path('mcp_server_toggle', {'name': server.name}) }}" 
                                                      method="post" 
                                                      class="d-inline">
                                                    <input type="hidden" 
                                                           name="_token" 
                                                           value="{{ csrf_token('toggle' ~ server.id.toRfc4122()) }}">
                                                    <button type="submit" 
                                                            class="btn btn-outline-warning" 
                                                            title="Deaktivieren">
                                                        <i class="fas fa-pause"></i>
                                                    </button>
                                                </form>
                                            {% else %}
                                                <form action="{{ path('mcp_server_toggle', {'name': server.name}) }}" 
                                                      method="post" 
                                                      class="d-inline">
                                                    <input type="hidden" 
                                                           name="_token" 
                                                           value="{{ csrf_token('toggle' ~ server.id.toRfc4122()) }}">
                                                    <button type="submit" 
                                                            class="btn btn-outline-success" 
                                                            title="Aktivieren">
                                                        <i class="fas fa-play"></i>
                                                    </button>
                                                </form>
                                            {% endif %}
                                            <form action="{{ path('mcp_server_delete', {'name': server.name}) }}" 
                                                  method="post" 
                                                  class="d-inline"
                                                  onsubmit="return confirm('Möchten Sie diesen MCP-Server wirklich löschen?');">
                                                <input type="hidden" 
                                                       name="_token" 
                                                       value="{{ csrf_token('delete' ~ server.id.toRfc4122()) }}">
                                                <button type="submit" 
                                                        class="btn btn-outline-danger" 
                                                        title="Löschen">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    Keine MCP-Server-Definitionen gefunden. 
                    <a href="{{ path('mcp_server_new') }}">Erstellen Sie einen neuen MCP-Server</a>.
                </div>
            {% endif %}
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between">
                <span>
                    <strong>{{ servers|length }}</strong> MCP-Server
                </span>
                <form action="{{ path('mcp_servers_reload') }}" method="post" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('reload_servers') }}">
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-sync-alt me-1"></i> Neu laden
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-question-circle me-2"></i>
                Informationen
            </h5>
        </div>
        <div class="card-body">
            <p>
                <strong>MCP (Model Context Protocol)</strong> ermöglicht die Integration externer Tools und Dienste 
                in Ihr AI-System. Mit dynamischen MCP-Servern können Sie:
            </p>
            <ul>
                <li>Neue MCP-Server ohne Code-Änderungen hinzufügen</li>
                <li>Server für spezifische Aufgaben konfigurieren</li>
                <li>Sicherheitsrichtlinien pro Server definieren</li>
                <li>Tools und Ressourcen whitelisten/blacklisten</li>
            </ul>
            <p>
                <strong>Verfügbare Server-Typen:</strong>
            </p>
            <div class="d-flex flex-wrap gap-2">
                {% for type, label in availableTypes %}
                    <span class="badge bg-{{ type == 'filesystem' ? 'primary' : type == 'playwright' ? 'success' : type == 'github' ? 'info' : 'secondary' }}">
                        {{ label }}
                    </span>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
