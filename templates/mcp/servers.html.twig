{# templates/mcp/servers.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}MCP-Server Verwaltung - EVIE{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl md:text-3xl font-bold text-content flex items-center gap-3">
            <i class="ph ph-server text-primary"></i>
            MCP-Server Verwaltung
        </h1>
        <a href="{{ path('mcp_server_new') }}" class="btn btn-primary">
            <i class="ph ph-plus"></i>
            Neuer MCP-Server
        </a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="rounded-xl px-4 py-3 border flex items-center gap-2
                        {% if label == 'success' %}bg-success-soft border-success/20 text-success
                        {% else %}bg-danger-soft border-danger/20 text-danger{% endif %}">
                <i class="ph {% if label == 'success' %}ph-check-circle{% else %}ph-warning-circle{% endif %} text-lg"></i>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card">
        <div class="flex items-center gap-2 mb-4">
            <i class="ph ph-list text-primary text-xl"></i>
            <h2 class="card-title">MCP-Server Liste</h2>
        </div>

        {% if servers|length > 0 %}
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-border text-left text-content-muted">
                        <th class="py-3 px-2">Name</th>
                        <th class="py-3 px-2">Typ</th>
                        <th class="py-3 px-2">Beschreibung</th>
                        <th class="py-3 px-2">Status</th>
                        <th class="py-3 px-2">Tools</th>
                        <th class="py-3 px-2">Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    {% for server in servers %}
                    <tr class="border-b border-border hover:bg-surface-muted">
                        <td class="py-3 px-2">
                            <strong class="text-content">{{ server.name }}</strong>
                            {% if server.description %}
                                <br>
                                <small class="text-content-muted">{{ (server.description|slice(0, 50)) ~ (server.description|length > 50 ? '...') }}</small>
                            {% endif %}
                        </td>
                        <td class="py-3 px-2">
                            <span class="badge
                                {% if server.type == 'filesystem' %}badge-approved
                                {% elseif server.type == 'playwright' %}badge-approved
                                {% elseif server.type == 'github' %}badge-pending
                                {% else %}badge-rejected{% endif %}">
                                {{ availableTypes[server.type] ?? server.type }}
                            </span>
                        </td>
                        <td class="py-3 px-2 text-content-muted">{{ server.type }}</td>
                        <td class="py-3 px-2">
                            {% if server.isEnabled %}
                                <span class="badge badge-approved">Aktiv</span>
                            {% else %}
                                <span class="badge badge-rejected">Inaktiv</span>
                            {% endif %}
                        </td>
                        <td class="py-3 px-2 text-content">{{ server.toolsCount|default(0) }}</td>
                        <td class="py-3 px-2">
                            <div class="flex items-center gap-2">
                                <a href="{{ path('mcp_server_show', {'name': server.name}) }}"
                                   class="text-primary hover:text-primary-hover" title="Anzeigen">
                                    <i class="ph ph-eye text-lg"></i>
                                </a>
                                <a href="{{ path('mcp_server_edit', {'name': server.name}) }}"
                                   class="text-content-muted hover:text-primary" title="Bearbeiten">
                                    <i class="ph ph-pencil-simple text-lg"></i>
                                </a>
                                <form method="post" action="{{ path('mcp_server_toggle', {'name': server.name}) }}" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ server.name) }}">
                                    <button type="submit" class="text-content-muted hover:text-warning" title="Aktivieren/Deaktivieren">
                                        <i class="ph ph-power text-lg"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="text-center py-12 text-content-muted">
            <i class="ph ph-server text-4xl mb-2 block"></i>
            <p>Keine MCP-Server konfiguriert.</p>
        </div>
        {% endif %}
    </div>

    <div class="card">
        <a href="{{ path('mcp_servers_reload') }}" class="btn btn-ghost">
            <i class="ph ph-arrow-clockwise"></i>
            MCP-Server neu laden
        </a>
    </div>
</div>
{% endblock %}
