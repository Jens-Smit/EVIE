{# templates/mcp/server_show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ server.name }} - MCP-Server - EVIE{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl md:text-3xl font-bold text-content flex items-center gap-3">
            <i class="ph ph-server text-primary"></i>
            {{ server.name }}
        </h1>
        <div class="flex items-center gap-2">
            <a href="{{ path('mcp_server_edit', {'name': server.name}) }}" class="btn btn-secondary">
                <i class="ph ph-pencil-simple"></i>
                Bearbeiten
            </a>
            <a href="{{ path('mcp_servers_list') }}" class="btn btn-ghost">
                <i class="ph ph-list"></i>
                Zurück zur Liste
            </a>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="rounded-xl px-4 py-3 border flex items-center gap-2
                        {% if label == 'success' %}bg-success-soft border-success/20 text-success
                        {% else %}bg-danger-soft border-danger/20 text-danger{% endif %}">
                <i class="ph {% if label == 'success' %}ph-check-circle{% else %}ph-warning-circle{% endif %} text-lg"></i>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card">
            <div class="flex items-center gap-2 mb-4">
                <i class="ph ph-info text-primary text-xl"></i>
                <h2 class="card-title">Grundinformationen</h2>
            </div>
            <dl class="space-y-3">
                <div class="flex justify-between">
                    <dt class="text-content-muted text-sm">Name:</dt>
                    <dd class="text-content font-medium">{{ server.name }}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-content-muted text-sm">Typ:</dt>
                    <dd><span class="badge badge-approved">{{ server.type }}</span></dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-content-muted text-sm">Status:</dt>
                    <dd>
                        {% if server.isEnabled %}
                            <span class="badge badge-approved">Aktiv</span>
                        {% else %}
                            <span class="badge badge-rejected">Inaktiv</span>
                        {% endif %}
                    </dd>
                </div>
                <div>
                    <dt class="text-content-muted text-sm mb-1">Beschreibung:</dt>
                    <dd class="text-content">{{ server.description|default('—') }}</dd>
                </div>
            </dl>
        </div>

        <div class="card">
            <div class="flex items-center gap-2 mb-4">
                <i class="ph ph-code text-primary text-xl"></i>
                <h2 class="card-title">Konfiguration</h2>
            </div>
            <pre class="bg-surface-muted p-3 rounded-xl text-xs text-content overflow-x-auto border border-border">{{ server.configuration|default('{}') }}</pre>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card">
            <div class="flex items-center gap-2 mb-4">
                <i class="ph ph-check-circle text-success text-xl"></i>
                <h2 class="card-title">Erlaubte Tools</h2>
            </div>
            {% if server.allowedTools and server.allowedTools|length > 0 %}
            <ul class="space-y-1">
                {% for tool in server.allowedTools %}
                <li class="text-sm text-content flex items-center gap-2">
                    <i class="ph ph-check text-success"></i>{{ tool }}
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <p class="text-content-muted text-sm">Alle Tools erlaubt (keine Whitelist)</p>
            {% endif %}
        </div>

        <div class="card">
            <div class="flex items-center gap-2 mb-4">
                <i class="ph ph-prohibit text-danger text-xl"></i>
                <h2 class="card-title">Blockierte Ressourcen</h2>
            </div>
            {% if server.blockedResources and server.blockedResources|length > 0 %}
            <ul class="space-y-1">
                {% for resource in server.blockedResources %}
                <li class="text-sm text-content flex items-center gap-2">
                    <i class="ph ph-x text-danger"></i>{{ resource }}
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <p class="text-content-muted text-sm">Keine Blockierungen</p>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="ph ph-power text-warning text-xl"></i>
                <h2 class="card-title">Server-Steuerung</h2>
            </div>
            <form method="post" action="{{ path('mcp_server_toggle', {'name': server.name}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ server.name) }}">
                <button type="submit" class="btn {% if server.isEnabled %}btn-ghost{% else %}btn-primary{% endif %}">
                    <i class="ph ph-power"></i>
                    {% if server.isEnabled %}Deaktivieren{% else %}Aktivieren{% endif %}
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
