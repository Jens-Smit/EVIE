{# templates/mcp/server_show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ server.name }} - MCP-Server - EVIE{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="{{ path('mcp_servers_list') }}">MCP-Server</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ server.name }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">
            <i class="fas fa-server me-2"></i>
            {{ server.name }}
        </h1>
        <div class="btn-group" role="group">
            <a href="{{ path('mcp_server_edit', {'name': server.name}) }}" class="btn btn-secondary">
                <i class="fas fa-edit me-1"></i> Bearbeiten
            </a>
            <a href="{{ path('mcp_servers_list') }}" class="btn btn-outline-secondary">
                <i class="fas fa-list me-1"></i> Zurück zur Liste
            </a>
        </div>
    </div>

    {% if app.session.flashBag.has('success') %}
        {% for message in app.session.flashBag.get('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endif %}

    {% if app.session.flashBag.has('error') %}
        {% for message in app.session.flashBag.get('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endif %}

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        Grundinformationen
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">{{ server.name }}</dd>

                        <dt class="col-sm-4">Typ</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-{{ server.type == 'filesystem' ? 'primary' : server.type == 'playwright' ? 'success' : server.type == 'github' ? 'info' : 'secondary' }}">
                                {{ server.type }}
                            </span>
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            {% if server.isActive %}
                                <span class="badge bg-success">Aktiv</span>
                            {% else %}
                                <span class="badge bg-secondary">Inaktiv</span>
                            {% endif %}
                        </dd>

                        <dt class="col-sm-4">Beschreibung</dt>
                        <dd class="col-sm-8">{{ server.description|default('-') }}</dd>

                        <dt class="col-sm-4">Erstellt am</dt>
                        <dd class="col-sm-8">{{ server.createdAt|date('d.m.Y H:i:s') }}</dd>

                        <dt class="col-sm-4">Zuletzt aktualisiert</dt>
                        <dd class="col-sm-8">{{ server.updatedAt ? server.updatedAt|date('d.m.Y H:i:s') : '-' }}</dd>
                    </dl>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-cog me-2"></i>
                        Konfiguration
                    </h5>
                </div>
                <div class="card-body">
                    <pre class="bg-light p-3 rounded mb-0">{{ server.configuration|json_encode|raw }}</pre>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-tools me-2"></i>
                        Verfügbare Tools
                    </h5>
                    <span class="badge bg-info">{{ tools|length }} Tools</span>
                </div>
                <div class="card-body">
                    {% if tools|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tool-Name</th>
                                        <th>Beschreibung</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for toolName, toolInfo in tools %}
                                        <tr>
                                            <td>
                                                <code>{{ toolName }}</code>
                                            </td>
                                            <td>{{ toolInfo.description|default('-') }}</td>
                                        </tr>
                                    {% else %}
                                        {% for toolName in tools %}
                                            <tr>
                                                <td>
                                                    <code>{{ toolName }}</code>
                                                </td>
                                                <td>-</td>
                                            </tr>
                                        {% endfor %}
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="alert alert-info mb-0">
                            <i class="fas fa-info-circle me-2"></i>
                            Keine Tools verfügbar oder Server konnte nicht geladen werden.
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-shield-alt me-2"></i>
                        Sicherheitseinstellungen
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6>Erlaubte Tools</h6>
                        {% if server.allowedTools|length > 0 %}
                            <div class="d-flex flex-wrap gap-1">
                                {% for tool in server.allowedTools %}
                                    <span class="badge bg-success">{{ tool }}</span>
                                {% endfor %}
                            </div>
                            <small class="text-muted">Nur diese Tools sind auf diesem Server erlaubt.</small>
                        {% else %}
                            <span class="text-muted">Alle Tools sind erlaubt.</span>
                        {% endif %}
                    </div>

                    <div class="mb-3">
                        <h6>Blockierte Ressourcen</h6>
                        {% if server.blockedResources|length > 0 %}
                            <div class="d-flex flex-wrap gap-1">
                                {% for resource in server.blockedResources %}
                                    <span class="badge bg-danger">{{ resource }}</span>
                                {% endfor %}
                            </div>
                            <small class="text-muted">Diese Ressourcen sind auf diesem Server blockiert.</small>
                        {% else %}
                            <span class="text-muted">Keine Ressourcen blockiert.</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-terminal me-2"></i>
                Test Tool-Ausführung
            </h5>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                Hier können Sie Tools auf diesem MCP-Server testen.
            </div>
            <form action="" method="post" class="row g-3">
                <div class="col-md-4">
                    <label for="toolSelect" class="form-label">Tool auswählen</label>
                    <select class="form-select" id="toolSelect" name="tool" required>
                        <option value="" selected disabled>Tool auswählen...</option>
                        {% if tools|length > 0 %}
                            {% for toolName, toolInfo in tools %}
                                <option value="{{ toolName }}">{{ toolName }} - {{ toolInfo.description|default('') }}</option>
                            {% else %}
                                {% for toolName in tools %}
                                    <option value="{{ toolName }}">{{ toolName }}</option>
                                {% endfor %}
                            {% endfor %}
                        {% endif %}
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="toolArguments" class="form-label">Argumente (JSON)</label>
                    <input type="text" 
                           class="form-control" 
                           id="toolArguments" 
                           name="arguments" 
                           placeholder='{"path": "/test/file.txt"}'
                           value="{}">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-play me-1"></i> Ausführen
                    </button>
                </div>
            </form>
            <div id="testResult" class="mt-3 d-none">
                <div class="alert alert-success">
                    <h6>Ergebnis:</h6>
                    <pre id="resultOutput" class="mb-0"></pre>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.querySelector('form').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const form = e.target;
        const tool = form.elements.tool.value;
        const argumentsInput = form.elements.arguments.value;
        
        if (!tool) {
            alert('Bitte wählen Sie ein Tool aus.');
            return;
        }
        
        try {
            const arguments = JSON.parse(argumentsInput);
            
            fetch('/api/mcp/servers/{{ server.name }}/tools/' + tool + '/execute', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ arguments: arguments })
            })
            .then(response => response.json())
            .then(data => {
                const resultDiv = document.getElementById('testResult');
                const resultOutput = document.getElementById('resultOutput');
                
                resultOutput.textContent = JSON.stringify(data, null, 2);
                resultDiv.classList.remove('d-none');
                
                if (data.status === 'error') {
                    resultDiv.querySelector('.alert').classList.remove('alert-success');
                    resultDiv.querySelector('.alert').classList.add('alert-danger');
                }
            })
            .catch(error => {
                const resultDiv = document.getElementById('testResult');
                const resultOutput = document.getElementById('resultOutput');
                
                resultOutput.textContent = 'Fehler: ' + error.message;
                resultDiv.classList.remove('d-none');
                resultDiv.querySelector('.alert').classList.remove('alert-success');
                resultDiv.querySelector('.alert').classList.add('alert-danger');
            });
        } catch (error) {
            alert('Ungültiges JSON für Argumente: ' + error.message);
        }
    });
</script>
{% endblock %}
