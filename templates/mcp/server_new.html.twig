{# templates/mcp/server_new.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Neuer MCP-Server - EVIE{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl md:text-3xl font-bold text-content flex items-center gap-3">
            <i class="ph ph-plus text-primary"></i>
            Neuer MCP-Server
        </h1>
        <a href="{{ path('mcp_servers_list') }}" class="btn btn-ghost">
            <i class="ph ph-list"></i>
            Zurück zur Liste
        </a>
    </div>

    <div class="card">
        <div class="flex items-center gap-2 mb-4">
            <i class="ph ph-gear text-primary text-xl"></i>
            <h2 class="card-title">MCP-Server-Konfiguration</h2>
        </div>

        <div class="bg-info-soft border border-info/20 text-info px-4 py-3 rounded-xl flex items-center gap-2 mb-6">
            <i class="ph ph-info text-lg"></i>
            <div>
                <strong>Hinweis:</strong>
                <span class="text-content-muted"> MCP-Server ermöglichen die Integration externer Tools und Dienste.</span>
            </div>
        </div>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'space-y-6'}}) }}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-content mb-1'}}) }}
                    {{ form_widget(form.name, {'attr': {'class': 'w-full px-3 py-2 bg-surface-muted border border-border rounded-xl text-content focus:ring-2 focus:ring-primary focus:border-transparent'}}) }}
                    {{ form_errors(form.name) }}
                </div>
                <div>
                    {{ form_label(form.type, null, {'label_attr': {'class': 'block text-sm font-medium text-content mb-1'}}) }}
                    {{ form_widget(form.type, {'attr': {'class': 'w-full px-3 py-2 bg-surface-muted border border-border rounded-xl text-content focus:ring-2 focus:ring-primary focus:border-transparent'}}) }}
                    {{ form_errors(form.type) }}
                </div>
            </div>

            <div>
                {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-content mb-1'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'w-full px-3 py-2 bg-surface-muted border border-border rounded-xl text-content focus:ring-2 focus:ring-primary focus:border-transparent', 'rows': 3}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="bg-surface-muted rounded-xl p-4 border border-border">
                <h3 class="font-semibold text-content mb-3 flex items-center gap-2">
                    <i class="ph ph-code text-primary"></i>
                    Server-Konfiguration (JSON)
                </h3>
                {{ form_widget(form.configuration, {'attr': {'class': 'w-full px-3 py-2 bg-surface border border-border rounded-xl text-content font-mono text-sm focus:ring-2 focus:ring-primary focus:border-transparent', 'rows': 5}}) }}
                {{ form_errors(form.configuration) }}
                <p class="text-xs text-content-muted mt-2">
                    Beispiel für <code class="bg-surface-elevated px-1 rounded">filesystem</code>:
                    <code class="block bg-surface-elevated p-2 rounded mt-1 text-xs">{ "transport": "stdio", "command": "npx", "arguments": ["-y", "@modelcontextprotocol/server-filesystem", "/var/mcp-sandbox"] }</code>
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-surface-muted rounded-xl p-4 border border-border">
                    <h3 class="font-semibold text-content mb-3 flex items-center gap-2">
                        <i class="ph ph-check-circle text-success"></i>
                        Erlaubte Tools (Whitelist)
                    </h3>
                    {{ form_widget(form.allowedTools, {'attr': {'class': 'w-full px-3 py-2 bg-surface border border-border rounded-xl text-content font-mono text-sm focus:ring-2 focus:ring-primary focus:border-transparent', 'rows': 3, 'placeholder': '["read_file", "list_files"]'}}) }}
                    <p class="text-xs text-content-muted mt-2">Leer lassen, um alle Tools zu erlauben.</p>
                </div>
                <div class="bg-surface-muted rounded-xl p-4 border border-border">
                    <h3 class="font-semibold text-content mb-3 flex items-center gap-2">
                        <i class="ph ph-prohibit text-danger"></i>
                        Blockierte Ressourcen (Blacklist)
                    </h3>
                    {{ form_widget(form.blockedResources, {'attr': {'class': 'w-full px-3 py-2 bg-surface border border-border rounded-xl text-content font-mono text-sm focus:ring-2 focus:ring-primary focus:border-transparent', 'rows': 3, 'placeholder': '["/etc/*", "*.env"]'}}) }}
                    <p class="text-xs text-content-muted mt-2">Unterstützt Wildcards (*).</p>
                </div>
            </div>

            <div class="bg-surface-muted rounded-xl p-4 border border-border">
                <h3 class="font-semibold text-content mb-3 flex items-center gap-2">
                    <i class="ph ph-power text-warning"></i>
                    Status
                </h3>
                <label class="flex items-center gap-2 cursor-pointer">
                    {{ form_widget(form.isActive, {'attr': {'class': 'w-4 h-4'}}) }}
                    <span class="text-sm text-content">Server aktivieren</span>
                </label>
                <p class="text-xs text-content-muted mt-2">Deaktivierte Server werden nicht geladen.</p>
            </div>

            <div class="flex justify-end gap-2">
                <a href="{{ path('mcp_servers_list') }}" class="btn btn-ghost">
                    <i class="ph ph-x"></i>
                    Abbrechen
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="ph ph-floppy-disk"></i>
                    Speichern
                </button>
            </div>
        {{ form_end(form) }}
    </div>

    <div class="card">
        <div class="flex items-center gap-2 mb-4">
            <i class="ph ph-question text-primary text-xl"></i>
            <h2 class="card-title">Hilfe zur Konfiguration</h2>
        </div>
        <div class="space-y-4">
            <div>
                <h3 class="font-semibold text-content mb-2">Server-Typen:</h3>
                <ul class="space-y-1 text-sm text-content-muted">
                    <li><strong class="text-content">filesystem:</strong> Zugriff auf das Dateisystem. Benötigt Node.js und npx.</li>
                    <li><strong class="text-content">playwright:</strong> Browser-Automatisierung. Benötigt Node.js und npx.</li>
                    <li><strong class="text-content">github:</strong> Zugriff auf GitHub-Repositories. Benötigt eine URL.</li>
                    <li><strong class="text-content">custom:</strong> Benutzerdefinierter Server. Benötigt eine Klasse.</li>
                </ul>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <h3 class="font-semibold text-content mb-2">Filesystem:</h3>
                    <pre class="bg-surface-muted p-3 rounded-xl text-xs text-content overflow-x-auto">{ "transport": "stdio", "command": "npx", "arguments": ["-y", "@modelcontextprotocol/server-filesystem", "/var/mcp-sandbox"] }</pre>
                </div>
                <div>
                    <h3 class="font-semibold text-content mb-2">GitHub:</h3>
                    <pre class="bg-surface-muted p-3 rounded-xl text-xs text-content overflow-x-auto">{ "transport": "http", "url": "https://api.github.com" }</pre>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
