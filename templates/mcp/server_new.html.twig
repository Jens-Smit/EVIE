{# templates/mcp/server_new.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Neuer MCP-Server - EVIE{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="{{ path('mcp_servers_list') }}">MCP-Server</a></li>
            <li class="breadcrumb-item active" aria-current="page">Neuer MCP-Server</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">
            <i class="fas fa-plus me-2"></i>
            Neuer MCP-Server
        </h1>
        <a href="{{ path('mcp_servers_list') }}" class="btn btn-outline-secondary">
            <i class="fas fa-list me-1"></i> Zurück zur Liste
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-cog me-2"></i>
                MCP-Server-Konfiguration
            </h5>
        </div>
        <div class="card-body">
            <div class="alert alert-info mb-4">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Hinweis:</strong> MCP-Server ermöglichen die Integration externer Tools und Dienste.
                Konfigurieren Sie den Server mit den gewünschten Einstellungen.
            </div>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'row g-3'}}) }}
                <div class="col-md-6">
                    {{ form_row(form.name, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.type, {'attr': {'class': 'form-select'}}) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                </div>

                <div class="col-12">
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-cogs me-2"></i>
                                Server-Konfiguration (JSON)
                            </h6>
                        </div>
                        <div class="card-body">
                            {{ form_row(form.configuration, {'attr': {'class': 'form-control font-mono', 'rows': 5}}) }}
                            <div class="mt-2">
                                <small class="text-muted">
                                    Beispiel für <code>filesystem</code>:
                                    <pre class="mb-0">{ "transport": "stdio", "command": "npx", "arguments": ["-y", "@modelcontextprotocol/server-filesystem", "%kernel.project_dir%/var/mcp-sandbox"] }</pre>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-check-circle me-2"></i>
                                Erlaubte Tools (Whitelist)
                            </h6>
                        </div>
                        <div class="card-body">
                            {{ form_row(form.allowedTools, {'attr': {'class': 'form-control font-mono', 'rows': 3, 'placeholder': '["read_file", "list_files"]'}}) }}
                            <small class="text-muted">
                                Leer lassen, um alle Tools zu erlauben. Beispiel: <code>["read_file", "list_files"]</code>
                            </small>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-ban me-2"></i>
                                Blockierte Ressourcen (Blacklist)
                            </h6>
                        </div>
                        <div class="card-body">
                            {{ form_row(form.blockedResources, {'attr': {'class': 'form-control font-mono', 'rows': 3, 'placeholder': '["/etc/*", "*.env"]'}}) }}
                            <small class="text-muted">
                                Beispiel: <code>["/etc/*", "*.env", "*.key"]</code>. Unterstützt Wildcards (*).
                            </small>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-toggle-on me-2"></i>
                                Status
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="form-check form-switch">
                                {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(form.isActive, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                            <small class="text-muted">
                                Deaktivierte Server werden nicht geladen und können nicht verwendet werden.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ path('mcp_servers_list') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-1"></i> Abbrechen
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Speichern
                        </button>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-question-circle me-2"></i>
                Hilfe zur Konfiguration
            </h5>
        </div>
        <div class="card-body">
            <h6>Server-Typen:</h6>
            <ul>
                <li><strong>filesystem:</strong> Zugriff auf das Dateisystem. Benötigt Node.js und npx.</li>
                <li><strong>playwright:</strong> Browser-Automatisierung. Benötigt Node.js und npx.</li>
                <li><strong>github:</strong> Zugriff auf GitHub-Repositories. Benötigt eine URL.</li>
                <li><strong>custom:</strong> Benutzerdefinierter Server. Benötigt eine Klasse.</li>
            </ul>
            
            <h6 class="mt-3">Beispiel-Konfigurationen:</h6>
            <div class="row">
                <div class="col-md-6">
                    <h6>Filesystem:</h6>
                    <pre class="bg-light p-3 rounded">{ "transport": "stdio", "command": "npx", "arguments": ["-y", "@modelcontextprotocol/server-filesystem", "/var/mcp-sandbox"] }</pre>
                </div>
                <div class="col-md-6">
                    <h6>GitHub:</h6>
                    <pre class="bg-light p-3 rounded">{ "transport": "http", "url": "https://api.github.com" }</pre>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
