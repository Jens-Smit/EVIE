{# templates/mcp/server_edit.html.twig #}
{% extends 'mcp/server_new.html.twig' %}

{% block title %}{{ server.name }} bearbeiten - MCP-Server - EVIE{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="{{ path('mcp_servers_list') }}">MCP-Server</a></li>
            <li class="breadcrumb-item"><a href="{{ path('mcp_server_show', {'name': server.name}) }}">{{ server.name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">Bearbeiten</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">
            <i class="fas fa-edit me-2"></i>
            {{ server.name }} bearbeiten
        </h1>
        <div class="btn-group" role="group">
            <a href="{{ path('mcp_server_show', {'name': server.name}) }}" class="btn btn-outline-secondary">
                <i class="fas fa-eye me-1"></i> Anzeigen
            </a>
            <a href="{{ path('mcp_servers_list') }}" class="btn btn-outline-secondary">
                <i class="fas fa-list me-1"></i> Zurück zur Liste
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-cog me-2"></i>
                MCP-Server-Konfiguration bearbeiten
            </h5>
        </div>
        <div class="card-body">
            <div class="alert alert-warning mb-4">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Vorsicht:</strong> Änderungen an der Konfiguration können die Funktionalität des Servers beeinflussen.
            </div>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'row g-3'}}) }}
                <div class="col-md-6">
                    {{ form_row(form.name, {'attr': {'class': 'form-control', 'readonly': 'readonly'}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.type, {'attr': {'class': 'form-select', 'disabled': 'disabled'}}) }}
                    <small class="text-muted">Der Server-Typ kann nach dem Erstellen nicht mehr geändert werden.</small>
                </div>
                <div class="col-12">
                    {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                </div>

                <div class="col-12">
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-cogs me-2"></i>
                                Server-Konfiguration (JSON)
                            </h6>
                        </div>
                        <div class="card-body">
                            {{ form_row(form.configuration, {'attr': {'class': 'form-control font-mono', 'rows': 5}}) }}
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-check-circle me-2"></i>
                                Erlaubte Tools (Whitelist)
                            </h6>
                        </div>
                        <div class="card-body">
                            {{ form_row(form.allowedTools, {'attr': {'class': 'form-control font-mono', 'rows': 3}}) }}
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-ban me-2"></i>
                                Blockierte Ressourcen (Blacklist)
                            </h6>
                        </div>
                        <div class="card-body">
                            {{ form_row(form.blockedResources, {'attr': {'class': 'form-control font-mono', 'rows': 3}}) }}
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0">
                                <i class="fas fa-toggle-on me-2"></i>
                                Status
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="form-check form-switch">
                                {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(form.isActive, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ path('mcp_server_show', {'name': server.name}) }}" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-1"></i> Abbrechen
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> Speichern
                        </button>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
