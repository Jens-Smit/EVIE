{# templates/settings/secrets.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Secrets verwalten - EVIE{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl md:text-3xl font-bold text-content flex items-center gap-3">
            <i class="ph ph-lock-key text-primary"></i>
            Secrets verwalten
        </h1>
        <a href="{{ path('app_settings') }}" class="btn btn-ghost">
            <i class="ph ph-caret-left"></i>
            Zurück zu Einstellungen
        </a>
    </div>

    <div class="card">
        <div class="flex items-center gap-2 mb-4">
            <i class="ph ph-info text-primary text-xl"></i>
            <h2 class="card-title">Hinweis</h2>
        </div>
        <p class="text-content-muted text-sm">
            Secrets werden verschlüsselt gespeichert und sind nur für Ihren Tenant zugänglich. 
            Die Werte werden nach dem Speichern <strong>nie im Klartext angezeigt</strong>. 
            Sie können Secrets in Tools über Platzhalter wie <code>{{secret:api_key}}</code> referenzieren.
        </p>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="rounded-xl px-4 py-3 border flex items-center gap-2
                        {% if label == 'success' %}bg-success-soft border-success/20 text-success
                        {% else %}bg-danger-soft border-danger/20 text-danger{% endif %}">
                <i class="ph {% if label == 'success' %}ph-check-circle{% else %}ph-warning-circle{% endif %} text-lg"></i>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Neues Secret erstellen -->
    <div class="card">
        <div class="flex items-center gap-2 mb-4">
            <i class="ph ph-plus-circle text-primary text-xl"></i>
            <h2 class="card-title">Neues Secret hinzufügen</h2>
        </div>
        <form method="post" action="{{ path('app_settings_secrets_create') }}" class="space-y-4" id="secret-form">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-content mb-1" for="keyName">
                        Schlüsselname *
                        <span class="text-xs text-content-muted">(z.B. openweather_api_key, mistral_api_key)</span>
                    </label>
                    <input type="text" id="keyName" name="keyName" required
                           placeholder="api_key_name"
                           pattern="[a-zA-Z0-9_-]+"
                           class="w-full px-3 py-2 bg-surface-muted border border-border rounded-xl text-content focus:ring-2 focus:ring-primary focus:border-transparent">
                </div>
                <div>
                    <label class="block text-sm font-medium text-content mb-1" for="scope">
                        Bereich (optional)
                    </label>
                    <input type="text" id="scope" name="scope"
                           placeholder="z.B. weather, llm, integration"
                           class="w-full px-3 py-2 bg-surface-muted border border-border rounded-xl text-content focus:ring-2 focus:ring-primary focus:border-transparent">
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-content mb-1" for="value">
                    Wert *
                </label>
                <textarea id="value" name="value" rows="3" required
                          placeholder="Ihr API-Key oder Secret-Wert"
                          class="w-full px-3 py-2 bg-surface-muted border border-border rounded-xl text-content focus:ring-2 focus:ring-primary focus:border-transparent"></textarea>
                <p class="text-xs text-content-muted mt-1">
                    Der Wert wird verschlüsselt gespeichert und kann nach dem Speichern nicht mehr eingesehen werden.
                </p>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="ph ph-lock-key"></i>
                Secret speichern
            </button>
        </form>
    </div>

    <!-- Bestehende Secrets -->
    <div class="card">
        <div class="flex items-center gap-2 mb-4">
            <i class="ph ph-vault text-primary text-xl"></i>
            <h2 class="card-title">Ihre Secrets</h2>
        </div>

        {% if secretKeys|length > 0 %}
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-border text-left">
                            <th class="pb-3 text-sm font-medium text-content">Schlüsselname</th>
                            <th class="pb-3 text-sm font-medium text-content">Bereich</th>
                            <th class="pb-3 text-sm font-medium text-content">Aktionen</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        {% for keyName in secretKeys %}
                            <tr>
                                <td class="py-3 text-content">
                                    <code class="bg-surface-muted px-2 py-1 rounded">{{ keyName }}</code>
                                </td>
                                <td class="py-3 text-content-muted">
                                    <span class="text-sm">-</span>
                                </td>
                                <td class="py-3">
                                    <form method="post" action="{{ path('app_settings_secrets_delete', {'keyName': keyName}) }}" 
                                          onsubmit="return confirm('Sind Sie sicher, dass Sie dieses Secret löschen möchten?')">
                                        <button type="submit" class="btn btn-ghost btn-sm text-danger hover:bg-danger-soft">
                                            <i class="ph ph-trash"></i>
                                            Löschen
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="text-center py-8 text-content-muted">
                <i class="ph ph-lock-open text-4xl mb-2"></i>
                <p>Keine Secrets vorhanden.</p>
                <p class="text-sm mt-1">Fügen Sie oben ein neues Secret hinzu.</p>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
