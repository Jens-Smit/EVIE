{# templates/onboarding/llm_selection.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}LLM Selection - Onboarding - EVIE{% endblock %}

{% block body %}
<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {# Onboarding Header #}
    <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Configure LLM Provider</h1>
        <p class="text-slate-600 dark:text-slate-400 mt-2">Select and configure a Large Language Model for your AI agents</p>
    </div>

    {# Progress #}
    <div class="evie-onboarding-progress mb-12">
        {% for step in steps %}
            <div class="step {% if step == 'llm_selection' %}active{% elseif steps|indexOf(step) < steps|indexOf('llm_selection') %}completed{% endif %}">
                <div class="circle">
                    {% if step == 'llm_selection' %}
                        4
                    {% elseif steps|indexOf(step) < steps|indexOf('llm_selection') %}
                        <i class="ph ph-check text-white"></i>
                    {% else %}
                        {{ steps|indexOf(step) + 1 }}
                    {% endif %}
                </div>
                <div class="label">{{ step|replace({'_', '-'}, {'_': ' ', '-': ' '})|title }}</div>
            </div>
        {% endfor %}
    </div>

    {# Content #}
    <div class="glass-panel p-8">
        {% if llmConfigs|length > 0 %}
            {# Existing Configurations #}
            <div class="mb-8">
                <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3">Your LLM Configurations</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {% for config in llmConfigs %}
                        <div class="p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg border border-slate-200 dark:border-slate-700">
                            <div class="flex justify-between items-start mb-2">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-primary/10 dark:bg-primary/20 flex items-center justify-center">
                                        <i class="ph ph-cpu text-primary text-sm"></i>
                                    </div>
                                    <div>
                                        <div class="font-medium text-slate-900 dark:text-slate-100">{{ config.provider }}:{{ config.model }}</div>
                                        <div class="text-xs text-slate-500 dark:text-slate-400">
                                            {% if config.isDefault %}
                                                <span class="text-amber-600 dark:text-amber-400">Default</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    {% if config.isConfigured %}
                                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                        <span class="text-xs text-emerald-600 dark:text-emerald-400">Configured</span>
                                    {% else %}
                                        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                        <span class="text-xs text-amber-600 dark:text-amber-400">Needs Config</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {# New Configuration Form #}
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Add New LLM Configuration</h2>
            
            <form method="post" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="provider" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Provider</label>
                        <select id="provider" name="provider" class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50" required>
                            <option value="">Select a provider</option>
                            {% for provider in providers %}
                                <optgroup label="{{ provider.name }}">
                                    {% for model, modelName in provider.models %}
                                        <option value="{{ provider.identifier }}:{{ model }}">{{ modelName }}</option>
                                    {% endfor %}
                                </optgroup>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label for="model" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Model</label>
                        <input type="text" id="model" name="model" class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50" required>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Configuration (Optional)</label>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs text-slate-500 dark:text-slate-400 mb-1">Temperature</label>
                            <input type="number" name="configuration[temperature]" min="0" max="2" step="0.1" value="0.7" class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-500 dark:text-slate-400 mb-1">Max Tokens</label>
                            <input type="number" name="configuration[max_tokens]" min="1" max="32768" value="4096" class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-500 dark:text-slate-400 mb-1">Top P</label>
                            <input type="number" name="configuration[top_p]" min="0" max="1" step="0.1" value="0.9" class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-500 dark:text-slate-400 mb-1">Top K</label>
                            <input type="number" name="configuration[top_k]" min="1" max="100" value="50" class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200">
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="is_default" value="1" class="w-5 h-5 text-primary border-slate-300 dark:border-slate-600 rounded focus:ring-primary/50" {% if not defaultConfig %}checked{% endif %}>
                        <span class="text-slate-700 dark:text-slate-300">Set as default configuration</span>
                    </label>
                </div>

                {# Navigation #}
                <div class="flex justify-between gap-2 pt-4 border-t border-slate-200 dark:border-slate-700">
                    <a href="{{ path('onboarding_system_discovery') }}" class="px-6 py-3 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                        <i class="ph ph-arrow-left"></i>
                        Back
                    </a>
                    <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors">
                        Save & Continue
                        <i class="ph ph-arrow-right"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .evie-onboarding-progress {
        display: flex;
        justify-content: space-between;
        position: relative;
    }
    
    .evie-onboarding-progress::before {
        content: '';
        position: absolute;
        top: 2rem;
        left: 0;
        right: 0;
        height: 2px;
        background-color: #dee2e6;
        z-index: 1;
    }
    
    .evie-onboarding-progress .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 2;
        flex: 1;
    }
    
    .evie-onboarding-progress .circle {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        background-color: #dee2e6;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin-bottom: 0.5rem;
        transition: all 0.3s ease;
    }
    
    .evie-onboarding-progress .label {
        font-size: 0.875rem;
        color: #6c757d;
        text-align: center;
        transition: all 0.3s ease;
    }
    
    .evie-onboarding-progress .step.completed .circle {
        background-color: #2185d0;
        color: white;
    }
    
    .evie-onboarding-progress .step.active .circle {
        background-color: #2185d0;
        color: white;
    }
    
    .evie-onboarding-progress .step.completed .label,
    .evie-onboarding-progress .step.active .label {
        color: #2185d0;
        font-weight: 500;
    }
</style>

{% block javascripts %}
<script>
    // Additional JavaScript for LLM selection
</script>
{% endblock %}
{% endblock %}
