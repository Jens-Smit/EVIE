{# templates/onboarding/user_goals.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}User Goals - Onboarding - EVIE{% endblock %}

{% block body %}
<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {# Onboarding Header #}
    <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">What are your goals?</h1>
        <p class="text-slate-600 dark:text-slate-400 mt-2">Tell us what you want to achieve with EVIE</p>
    </div>

    {# Progress #}
    <div class="evie-onboarding-progress mb-12">
        {% for step in steps %}
            <div class="step {% if step == 'user_goals' %}active{% elseif steps|indexOf(step) < steps|indexOf('user_goals') %}completed{% endif %}">
                <div class="circle">
                    {% if step == 'user_goals' %}
                        2
                    {% elseif steps|indexOf(step) < steps|indexOf('user_goals') %}
                        <i class="ph ph-check text-white"></i>
                    {% else %}
                        {{ steps|indexOf(step) + 1 }}
                    {% endif %}
                </div>
                <div class="label">{{ step|replace({'_', '-'}, {'_': ' ', '-': ' '})|title }}</div>
            </div>
        {% endfor %}
    </div>

    {# Content #}
    <div class="glass-panel p-8">
        <form method="post" class="space-y-6">
            {# User Type Selection #}
            <div>
                <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-2">Select your user type</h2>
                <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">This helps us recommend the right capabilities for you</p>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    {% for type in userTypes %}
                        <label class="flex flex-col items-center gap-2 p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-colors cursor-pointer">
                            <input type="radio" name="user_type" value="{{ type }}" class="hidden" {% if type == userType %}checked{% endif %}>
                            <div class="w-12 h-12 rounded-full bg-primary/10 dark:bg-primary/20 flex items-center justify-center">
                                <i class="ph ph-user text-primary text-xl"></i>
                            </div>
                            <span class="font-medium text-slate-900 dark:text-slate-100">{{ type|title }} User</span>
                        </label>
                    {% endfor %}
                </div>
            </div>

            {# Goals Selection #}
            <div>
                <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-2">Select your goals</h2>
                <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">Choose what you want to achieve with EVIE (select all that apply)</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {% for goal in recommendedGoals %}
                        <label class="flex items-center gap-3 p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-colors cursor-pointer">
                            <input type="checkbox" name="goals[]" value="{{ goal }}" class="w-5 h-5 text-primary border-slate-300 dark:border-slate-600 rounded focus:ring-primary/50" {% if goal in existingGoals %}checked{% endif %}>
                            <span class="text-slate-800 dark:text-slate-200">{{ goal }}</span>
                        </label>
                    {% endfor %}
                </div>
            </div>

            {# Custom Goal #}
            <div>
                <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-2">Add a custom goal</h2>
                <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">Don't see your goal? Add it here</p>
                <div class="flex gap-2">
                    <input 
                        type="text" 
                        name="goals[]" 
                        placeholder="Enter a custom goal..."
                        class="flex-1 px-4 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200 placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-primary/50"
                    >
                    <button type="button" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                        <i class="ph ph-plus"></i>
                        Add
                    </button>
                </div>
            </div>

            {# Navigation #}
            <div class="flex justify-between gap-2 pt-4 border-t border-slate-200 dark:border-slate-700">
                <a href="{{ path('onboarding_dashboard') }}" class="px-6 py-3 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                    <i class="ph ph-arrow-left"></i>
                    Back
                </a>
                <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors">
                    Continue
                    <i class="ph ph-arrow-right"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .evie-onboarding-progress {
        display: flex;
        justify-content: space-between;
        position: relative;
    }
    
    .evie-onboarding-progress::before {
        content: '';
        position: absolute;
        top: 2rem;
        left: 0;
        right: 0;
        height: 2px;
        background-color: #dee2e6;
        z-index: 1;
    }
    
    .evie-onboarding-progress .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 2;
        flex: 1;
    }
    
    .evie-onboarding-progress .circle {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        background-color: #dee2e6;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin-bottom: 0.5rem;
        transition: all 0.3s ease;
    }
    
    .evie-onboarding-progress .label {
        font-size: 0.875rem;
        color: #6c757d;
        text-align: center;
        transition: all 0.3s ease;
    }
    
    .evie-onboarding-progress .step.completed .circle {
        background-color: #2185d0;
        color: white;
    }
    
    .evie-onboarding-progress .step.active .circle {
        background-color: #2185d0;
        color: white;
    }
    
    .evie-onboarding-progress .step.completed .label,
    .evie-onboarding-progress .step.active .label {
        color: #2185d0;
        font-weight: 500;
    }
</style>

{% block javascripts %}
<script>
    // Additional JavaScript for user goals
</script>
{% endblock %}
{% endblock %}
