{# templates/onboarding/integration_setup.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Integration Setup - Onboarding - EVIE{% endblock %}

{% block body %}
<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {# Onboarding Header #}
    <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Configure Integrations</h1>
        <p class="text-slate-600 dark:text-slate-400 mt-2">Integrations allow EVIE to connect with external services</p>
    </div>

    {# Progress #}
    <div class="evie-onboarding-progress mb-12">
        {% for step in steps %}
            <div class="step {% if step == 'integration_setup' %}active{% elseif steps|indexOf(step) < steps|indexOf('integration_setup') %}completed{% endif %}">
                <div class="circle">
                    {% if step == 'integration_setup' %}
                        6
                    {% elseif steps|indexOf(step) < steps|indexOf('integration_setup') %}
                        <i class="ph ph-check text-white"></i>
                    {% else %}
                        {{ steps|indexOf(step) + 1 }}
                    {% endif %}
                </div>
                <div class="label">{{ step|replace({'_', '-'}, {'_': ' ', '-': ' '})|title }}</div>
            </div>
        {% endfor %}
    </div>

    {# Content #}
    <div class="glass-panel p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            {# Required Integrations #}
            <div class="glass-panel p-4">
                <h3 class="text-lg font-medium text-slate-900 dark:text-slate-100 mb-3">Required Integrations</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">{{ requirements.required|length }} integrations required</p>
                
                {% if requirements.required|length > 0 %}
                    <div class="space-y-3">
                        {% for integration in requirements.required %}
                            <div class="p-3 bg-red-50 dark:bg-red-900/10 rounded-lg border border-red-200 dark:border-red-800/30">
                                <div class="flex justify-between items-start mb-1">
                                    <div>
                                        <div class="font-medium text-slate-900 dark:text-slate-100">{{ integration.integration }}</div>
                                        <div class="text-xs text-slate-500 dark:text-slate-400">{{ integration.description }}</div>
                                    </div>
                                    <span class="evie-badge evie-badge-error">Required</span>
                                </div>
                                <div class="text-xs text-slate-500 dark:text-slate-400">
                                    Required by: {{ integration.capability }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center text-emerald-600 dark:text-emerald-400 py-4">
                        <i class="ph ph-check-circle text-3xl mb-2"></i>
                        <p>All required integrations are configured!</p>
                    </div>
                {% endif %}
            </div>

            {# Installed Integrations #}
            <div class="glass-panel p-4">
                <h3 class="text-lg font-medium text-slate-900 dark:text-slate-100 mb-3">Installed Integrations</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">{{ integrations|length }} integrations installed</p>
                
                {% if integrations|length > 0 %}
                    <div class="space-y-3">
                        {% for integration in integrations %}
                            <div class="flex items-center justify-between p-3 bg-slate-50 dark:bg-slate-900/30 rounded-lg">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-secondary/10 dark:bg-secondary/20 flex items-center justify-center">
                                        <i class="ph ph-plug text-secondary text-sm"></i>
                                    </div>
                                    <div>
                                        <div class="font-medium text-slate-900 dark:text-slate-100">{{ integration.name }}</div>
                                        <div class="text-xs text-slate-500 dark:text-slate-400">{{ integration.type }}:{{ integration.identifier }}</div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    {% if integration.isReady %}
                                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                        <span class="text-xs text-emerald-600 dark:text-emerald-400">Ready</span>
                                    {% elseif integration.isConfigured %}
                                        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                        <span class="text-xs text-amber-600 dark:text-amber-400">Configured</span>
                                    {% else %}
                                        <span class="w-2 h-2 rounded-full bg-slate-400"></span>
                                        <span class="text-xs text-slate-500 dark:text-slate-400">Not Ready</span>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center text-slate-500 dark:text-slate-400 py-4">
                        <i class="ph ph-plug text-3xl mb-2"></i>
                        <p>No integrations installed yet</p>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Integration Recommendations #}
        {% if requirements.recommended|length > 0 %}
            <div class="glass-panel p-4 mb-8">
                <h3 class="text-lg font-medium text-slate-900 dark:text-slate-100 mb-3">Recommended Integrations</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Based on your capabilities</p>
                
                <div class="space-y-3">
                    {% for integration in requirements.recommended %}
                        <div class="flex items-center justify-between p-3 bg-slate-50 dark:bg-slate-900/30 rounded-lg border border-slate-200 dark:border-slate-700">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
                                    <i class="ph ph-star text-blue-600 dark:text-blue-400 text-sm"></i>
                                </div>
                                <div>
                                    <div class="font-medium text-slate-900 dark:text-slate-100">{{ integration.integration }}</div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400">{{ integration.description }}</div>
                                </div>
                            </div>
                            <span class="evie-badge evie-badge-info">Recommended</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {# Navigation #}
        <div class="flex justify-between gap-2 pt-4 border-t border-slate-200 dark:border-slate-700">
            <a href="{{ path('onboarding_secret_setup') }}" class="px-6 py-3 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                <i class="ph ph-arrow-left"></i>
                Back
            </a>
            <a href="{{ path('onboarding_permission_setup') }}" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors">
                Continue
                <i class="ph ph-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<style>
    .evie-onboarding-progress {
        display: flex;
        justify-content: space-between;
        position: relative;
    }
    
    .evie-onboarding-progress::before {
        content: '';
        position: absolute;
        top: 2rem;
        left: 0;
        right: 0;
        height: 2px;
        background-color: #dee2e6;
        z-index: 1;
    }
    
    .evie-onboarding-progress .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 2;
        flex: 1;
    }
    
    .evie-onboarding-progress .circle {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        background-color: #dee2e6;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin-bottom: 0.5rem;
        transition: all 0.3s ease;
    }
    
    .evie-onboarding-progress .label {
        font-size: 0.875rem;
        color: #6c757d;
        text-align: center;
        transition: all 0.3s ease;
    }
    
    .evie-onboarding-progress .step.completed .circle {
        background-color: #2185d0;
        color: white;
    }
    
    .evie-onboarding-progress .step.active .circle {
        background-color: #2185d0;
        color: white;
    }
    
    .evie-onboarding-progress .step.completed .label,
    .evie-onboarding-progress .step.active .label {
        color: #2185d0;
        font-weight: 500;
    }
</style>

{% block javascripts %}
<script>
    // Additional JavaScript for integration setup
</script>
{% endblock %}
{% endblock %}
