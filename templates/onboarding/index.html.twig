{# templates/onboarding/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Onboarding - EVIE{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto" x-data="onboardingFlow" x-init="init()">
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
    <div class="lg:col-span-3">
    <div class="card p-8">
        <!-- Header -->
        <div class="flex items-center gap-4 mb-6">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-primary to-secondary flex items-center justify-center shadow-button shrink-0">
                <i class="ph ph-brain text-white text-3xl"></i>
            </div>
            <div>
                <h1 class="text-2xl md:text-3xl font-bold text-content">Willkommen bei EVIE</h1>
                <p class="text-content-muted">Lass uns ein paar Dinge einrichten, damit EVIE optimal f&uuml;r dich arbeitet.</p>
            </div>
        </div>

        <!-- Fortschrittsanzeige (dynamisch, basiert auf totalSteps aus dem Backend) -->
        <div class="flex items-center gap-2 mb-2">
            <template x-for="i in totalSteps" :key="i">
                <div class="flex-1 h-1.5 rounded-full transition-colors duration-300"
                     :class="currentStep >= i ? 'bg-primary' : 'bg-surface-elevated'"></div>
            </template>
        </div>
        <div class="flex items-center justify-between mb-8">
            <span class="text-xs font-medium text-primary" x-text="currentPhase"></span>
            <span class="text-xs text-content-muted">
                Schritt <span x-text="Math.min(currentStep + 1, totalSteps)"></span> / <span x-text="totalSteps"></span>
            </span>
        </div>

        <!-- Loading State -->
        <div x-show="loading" class="flex flex-col items-center justify-center py-12">
            <div class="spinner mb-4"></div>
            <p class="text-content-muted">Lade Onboarding...</p>
        </div>

        <!-- Frage-Bereich -->
        <div x-show="!loading && !completed" class="space-y-6">
            <div>
                <h2 class="text-xl font-semibold text-content mb-2" x-text="currentQuestion"></h2>
                <p x-show="currentHelp" class="text-sm text-content-muted" x-text="currentHelp"></p>
                <p x-show="currentError" class="text-danger text-sm" x-text="currentError"></p>
            </div>

            <!-- Multiple Choice (Einzelauswahl) -->
            <div x-show="currentType === 'multiple_choice'" class="space-y-3">
                <template x-for="(label, key) in currentOptions" :key="key">
                    <button @click="submitResponse(key)"
                            class="w-full text-left p-4 rounded-xl border border-border bg-surface-muted
                                   hover:bg-primary-soft hover:border-primary transition-all
                                   text-content font-medium">
                        <span x-text="label"></span>
                    </button>
                </template>
            </div>

            <!-- Multiselect (Mehrfachauswahl + Freitext) -->
            <div x-show="currentType === 'multiselect'" class="space-y-3">
                <template x-for="(label, key) in currentOptions" :key="key">
                    <button @click="toggleMulti(key)"
                            class="w-full text-left p-4 rounded-xl border bg-surface-muted transition-all
                                   text-content font-medium flex items-center gap-3"
                            :class="multiSelected.includes(key) ? 'border-primary bg-primary-soft' : 'border-border hover:border-primary'">
                        <span class="w-5 h-5 rounded-md border flex items-center justify-center shrink-0"
                              :class="multiSelected.includes(key) ? 'bg-primary border-primary' : 'border-border'">
                            <i x-show="multiSelected.includes(key)" class="ph ph-check text-white text-xs"></i>
                        </span>
                        <span x-text="label"></span>
                    </button>
                </template>

                <!-- Freitext fuer zusaetzliche Bereiche/Use-Cases -->
                <div x-show="allowFreetext" class="space-y-2">
                    <input type="text" x-model="multiFreetext"
                           class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content
                                  focus:ring-2 focus:ring-primary focus:border-transparent"
                           placeholder="Eigene Eingabe (Komma-getrennt fuer mehrere)">
                </div>

                <div class="flex gap-2 pt-2">
                    <button @click="submitMultiselect()"
                            class="btn btn-primary"
                            :disabled="multiSelected.length === 0 && !multiFreetext.trim()">
                        <i class="ph ph-arrow-right"></i>
                        Weiter (<span x-text="multiSelected.length + freetextItems().length"></span> ausgewaehlt)
                    </button>
                    <button x-show="!currentRequired" @click="submitMultiselectSkip()"
                            class="btn btn-ghost">
                        Ohne Auswahl weiter
                    </button>
                </div>
            </div>

            <!-- Text Input -->
            <div x-show="currentType === 'text'" class="space-y-3">
                <textarea x-model="textInput"
                          class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content
                                 focus:ring-2 focus:ring-primary focus:border-transparent"
                          rows="3"
                          placeholder="Deine Antwort..."></textarea>
                <button @click="submitResponse(textInput)"
                        class="btn btn-primary"
                        :disabled="!textInput.trim()">
                    <i class="ph ph-arrow-right"></i>
                    Weiter
                </button>
            </div>

            <!-- Secret Input (API-Key etc.) -->
            <div x-show="currentType === 'secret'" class="space-y-3">
                <input type="password" x-model="textInput"
                       class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content
                              focus:ring-2 focus:ring-primary focus:border-transparent"
                       placeholder="API-Key eingeben..."
                       autocomplete="off">
                <p class="text-xs text-content-muted flex items-center gap-1">
                    <i class="ph ph-lock-key"></i>
                    Wird verschl&uuml;sselt gespeichert und nie im Klartext angezeigt.
                </p>
                <p x-show="currentArea" class="text-xs text-info flex items-center gap-1">
                    <i class="ph ph-shield-check"></i>
                    Der Key wird vor dem Speichern live geprueft.
                </p>
                <div class="flex gap-2">
                    <button @click="submitResponse(textInput)"
                            class="btn btn-primary"
                            :disabled="!textInput.trim()">
                        <i class="ph ph-floppy-disk"></i>
                        Speichern & Weiter
                    </button>
                    <button x-show="!currentRequired" @click="submitResponse('')"
                            class="btn btn-ghost">
                        &Uuml;berspringen
                    </button>
                </div>
            </div>

            <!-- Kombinierte E-Mail-Maske (SMTP + IMAP) -->
            <div x-show="currentType === 'email_combined'" class="space-y-4">
                <div x-show="currentArea" class="text-xs text-info bg-info-soft px-3 py-2 rounded-lg">
                    <i class="ph ph-envelope-simple-open"></i>
                    Eigene Adresse f&uuml;r Bereich: <span x-text="currentAreaLabel"></span> &mdash; optional, du kannst auch die Haupt-Adresse weiter nutzen oder &uuml;berspringen.
                </div>
                <div x-show="!currentArea" class="text-xs text-info bg-info-soft px-3 py-2 rounded-lg">
                    <i class="ph ph-envelope-simple-open"></i>
                    Haupt-E-Mail-Adresse (optional) &mdash; im n&auml;chsten Schritt legst du fest, welche Bereiche sie nutzen sollen.
                </div>

                <div class="space-y-3">
                    <h3 class="font-semibold text-content flex items-center gap-2">
                        <i class="ph ph-paper-plane-tilt text-primary"></i> SMTP (Versand)
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <input type="text" x-model="emailConfig.smtp_host"
                               class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content"
                               placeholder="SMTP-Host (z.B. smtp.gmail.com)">
                        <input type="text" x-model="emailConfig.smtp_port"
                               class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content"
                               placeholder="Port (587)">
                        <input type="text" x-model="emailConfig.smtp_user"
                               class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content"
                               placeholder="Benutzername / E-Mail">
                        <input type="password" x-model="emailConfig.smtp_pass"
                               class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content"
                               placeholder="Passwort / App-Passwort" autocomplete="off">
                        <select x-model="emailConfig.smtp_encryption"
                                class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content">
                            <option value="tls">TLS</option>
                            <option value="ssl">SSL</option>
                            <option value="">Keine</option>
                        </select>
                        <input type="email" x-model="emailConfig.from"
                               class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content"
                               placeholder="Absender-E-Mail">
                    </div>
                </div>

                <div class="space-y-3">
                    <h3 class="font-semibold text-content flex items-center gap-2">
                        <i class="ph ph-inbox text-primary"></i> IMAP (Empfang)
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <input type="text" x-model="emailConfig.imap_host"
                               class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content"
                               placeholder="IMAP-Host (z.B. imap.gmail.com)">
                        <input type="text" x-model="emailConfig.imap_port"
                               class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content"
                               placeholder="Port (993)">
                        <input type="text" x-model="emailConfig.imap_user"
                               class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content"
                               placeholder="Benutzername (leer = wie SMTP)">
                        <input type="password" x-model="emailConfig.imap_pass"
                               class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content"
                               placeholder="Passwort (leer = wie SMTP)" autocomplete="off">
                        <select x-model="emailConfig.imap_encryption"
                                class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content">
                            <option value="ssl">SSL</option>
                            <option value="tls">TLS</option>
                            <option value="">Keine</option>
                        </select>
                    </div>
                </div>

                <p class="text-xs text-content-muted">
                    Die Zugangsdaten werden verschl&uuml;sselt als Secret gespeichert. Bereiche ohne eigene Adresse nutzen die Haupt-Adresse.
                </p>
                <div class="flex gap-2">
                    <button @click="submitEmailCombined()"
                            class="btn btn-primary"
                            :disabled="!emailConfig.smtp_host.trim() && !emailConfig.imap_host.trim()">
                        <i class="ph ph-floppy-disk"></i>
                        Speichern & Weiter
                    </button>
                    <button @click="submitResponse('')"
                            class="btn btn-ghost">
                        &Uuml;berspringen
                    </button>
                </div>
            </div>

            <!-- Freier Dialog (Brainstorming, Pflicht-Freitext) -->
            <div x-show="currentType === 'freeform_dialog'" class="space-y-3">
                <textarea x-model="textInput"
                          class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content focus:ring-2 focus:ring-primary focus:border-transparent"
                          rows="5"
                          placeholder="Was soll EVIE fuer dich tun? Beschreibe deine Aufgabe, Ziele, Alltag..."></textarea>
                <div class="flex gap-2">
                    <button @click="submitResponse(textInput)" class="btn btn-primary" :disabled="!textInput.trim()">
                        <i class="ph ph-arrow-right"></i>
                        Weiter
                    </button>
                </div>
            </div>
            <!-- Strategie-Review -->
            <div x-show="currentType === 'strategy_review'" class="space-y-4">
                <div class="bg-surface-muted rounded-xl p-4 space-y-2">
                    <h3 class="font-semibold text-content" x-text="strategyDraft.title"></h3>
                    <p class="text-sm text-content" x-text="strategyDraft.goal"></p>
                    <div class="text-sm text-content-muted">
                        <span class="font-medium">Erfolgsmetrik:</span> <span x-text="strategyDraft.success_metric"></span>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-content-muted mb-1">Geplante Schritte:</p>
                        <ul class="text-sm text-content list-disc pl-5 space-y-0.5">
                            <template x-for="(s, i) in strategyDraft.steps || []" :key="i">
                                <li x-text="s"></li>
                            </template>
                        </ul>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-content-muted mb-1">Empfohlene Sub-Agenten:</p>
                        <div class="flex flex-wrap gap-1">
                            <template x-for="(s, i) in strategyDraft.sub_agents || []" :key="i">
                                <span class="text-xs bg-primary-soft text-primary px-2 py-0.5 rounded-full" x-text="s"></span>
                            </template>
                        </div>
                    </div>
                </div>
                <textarea x-model="textInput" rows="2"
                          class="w-full p-3 border border-border rounded-xl bg-surface-muted text-content"
                          placeholder="Optional: Korrektur/Freitext (leer lassen = Vorschlag bestaetigen)"></textarea>
                <div class="flex gap-2">
                    <button @click="submitResponse('confirm')" class="btn btn-primary">
                        <i class="ph ph-check"></i>
                        Strategie &uuml;bernehmen
                    </button>
                    <button @click="submitResponse(textInput)" class="btn btn-ghost" :disabled="!textInput.trim()">
                        Korrektur senden
                    </button>
                </div>
            </div>
            <!-- Sub-Agent-Review -->
            <div x-show="currentType === 'sub_agent_review'" class="space-y-4">
                <div class="bg-surface-muted rounded-xl p-4">
                    <p class="text-sm text-content mb-2">Diese Sub-Agenten werden fuer deine Strategie eingerichtet (Abwahl moeglich):</p>
                    <div class="space-y-1">
                        <template x-for="(label, name) in subAgentCatalog || {}" :key="name">
                            <label class="flex items-center gap-2 text-sm text-content"
                                   x-show="(strategyDraft.sub_agents || []).includes(name)">
                                <input type="checkbox" :value="name" x-model="subAgentSelection">
                                <span x-text="name + ' &ndash; ' + label"></span>
                            </label>
                        </template>
                    </div>
                </div>
                <button @click="submitSubAgentSelection()" class="btn btn-primary">
                    <i class="ph ph-robot"></i>
                    Auswahl &uuml;bernehmen
                </button>
            </div>
            <!-- Tool-Review -->
            <div x-show="currentType === 'tool_review'" class="space-y-4">
                <div class="bg-surface-muted rounded-xl p-4">
                    <p class="text-sm text-content mb-2">
                        Fuer Capability-Luecken werden Tool-Definitionen angelegt (Status <span class="font-medium">pending</span>, Freigabe nach dem Onboarding im Frontend):
                    </p>
                    <div x-show="!tools || tools.length === 0" class="text-sm text-content-muted">
                        Keine zusaetzlichen Tools noetig &ndash; deine Faehigkeiten werden von bestehenden Sub-Agenten/Tools abgedeckt.
                    </div>
                    <table x-show="tools && tools.length > 0" class="w-full text-sm">
                        <thead>
                            <tr class="text-left text-xs text-content-muted border-b border-border">
                                <th class="py-1 pr-2">Tool</th>
                                <th class="py-1 pr-2">Security</th>
                                <th class="py-1">Secrets</th>
                            </tr>
                        </thead>
                        <tbody>
                            <template x-for="(t, i) in tools || []" :key="i">
                                <tr class="border-b border-border last:border-0">
                                    <td class="py-1 pr-2 text-content" x-text="t.name"></td>
                                    <td class="py-1 pr-2 text-content-muted" x-text="t.security_level"></td>
                                    <td class="py-1 text-content-muted" x-text="(t.required_secrets || []).join(', ') || '&ndash;'"></td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
                <button @click="submitResponse('confirm')" class="btn btn-primary">
                    <i class="ph ph-check"></i>
                    Tools anlegen &amp; weiter
                </button>
            </div>
            <!-- Summary / Abschluss-Schritt -->
            <div x-show="currentType === 'summary'" class="space-y-4">
                <!-- Readiness-Checkliste -->
                <div class="bg-surface-muted rounded-xl p-4 space-y-1">
                    <template x-for="(c, i) in readiness.checks || []" :key="i">
                        <div class="flex items-center gap-2 text-sm"
                             :class="c.passed ? 'text-success' : (c.blocking ? 'text-danger' : 'text-content-muted')">
                            <i :class="c.passed ? 'ph ph-check-circle' : (c.blocking ? 'ph ph-x-circle' : 'ph ph-info')"></i>
                            <span x-text="c.label"></span>
                            <span x-show="!c.passed && c.blocking" class="text-xs">(Pflicht)</span>
                        </div>
                    </template>
                </div>
                <p class="text-content-muted">Deine Konfiguration wurde gespeichert. Du kannst jetzt loslegen.</p>
                <button @click="submitResponse('confirm')"
                        class="btn btn-primary">
                    <i class="ph ph-check-circle"></i>
                    Onboarding abschlie&szlig;en
                </button>
            </div>

            <!-- Abschluss: jederzeit verfuegbar (Sticky-Footer, G8) -->
            <div class="pt-4 border-t border-border space-y-2">
                <button @click="requestComplete()"
                        class="btn btn-primary w-full"
                        x-show="readiness.ready">
                    <i class="ph ph-check-circle"></i>
                    Onboarding abschlie&szlig;en
                </button>
                <button @click="requestComplete()"
                        class="btn btn-primary w-full opacity-60"
                        x-show="!readiness.ready"
                        :disabled="loading">
                    <i class="ph ph-check-circle"></i>
                    Onboarding abschlie&szlig;en (Pflichtangaben fehlen)
                </button>
                <button @click="skipOnboarding()"
                        class="text-sm text-content-muted hover:text-content">
                    &Uuml;berspringen und sp&auml;ter durchf&uuml;hren
                </button>
            </div>
        </div>

        <!-- Completion State -->
        <div x-show="completed" class="flex flex-col items-center justify-center py-12 space-y-4">
            <div class="w-16 h-16 rounded-full bg-success-soft flex items-center justify-center">
                <i class="ph ph-check-circle text-success text-4xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-content">Onboarding abgeschlossen!</h2>
            <p class="text-content-muted text-center">Danke f&uuml;r deine Angaben. Du kannst jetzt EVIE nutzen.</p>
            <a href="{{ path('app_dashboard') }}" class="btn btn-primary">
                <i class="ph ph-house"></i>
                Zum Dashboard
            </a>
        </div>
    </div>
    </div>
    <!-- Chat-Panel: freies Brainstorming waehrend des Onboardings -->
    <aside class="lg:col-span-2 card p-6 flex flex-col h-fit lg:sticky lg:top-6">
        <h2 class="text-lg font-semibold text-content flex items-center gap-2 mb-1">
            <i class="ph ph-chats-circle text-primary"></i>
            Brainstorming-Chat
        </h2>
        <p class="text-xs text-content-muted mb-4">
            Schreib frei mit EVIE &uuml;ber deine Aufgabe. Erkenntnisse (Branche, Bereiche, Use-Cases) flie&szlig;en automatisch in den Onboarding-Kontext ein.
        </p>
        <div class="overflow-y-auto space-y-3 mb-4 max-h-72" x-ref="chatLog">
            <template x-for="(m, i) in chatMessages" :key="i">
                <div :class="m.role === 'user' ? 'flex justify-end' : 'flex justify-start'">
                    <div :class="m.role === 'user'
                        ? 'bg-primary text-white rounded-xl px-3 py-2 max-w-[85%] text-sm'
                        : 'bg-surface-muted text-content rounded-xl px-3 py-2 max-w-[85%] text-sm'"
                         x-text="m.text"></div>
                </div>
            </template>
            <div x-show="chatLoading" class="text-xs text-content-muted flex items-center gap-2">
                <span class="spinner" style="width:14px;height:14px;"></span> EVIE schreibt...
            </div>
        </div>
        <div class="flex gap-2">
            <input type="text" x-model="chatInput" @keydown.enter="sendChat()"
                   class="flex-1 p-3 border border-border rounded-xl bg-surface-muted text-content focus:ring-2 focus:ring-primary focus:border-transparent"
                   placeholder="z.B. Ich moechte meine Vertriebsmails automatisieren..."
                   :disabled="chatLoading">
            <button @click="sendChat()" class="btn btn-primary shrink-0" :disabled="chatLoading || !chatInput.trim()">
                <i class="ph ph-paper-plane-tilt"></i>
            </button>
        </div>
    </aside>
  </div>
</div>

{% block javascripts %}
<script>
    const factory = () => ({
        loading: true,
        completed: false,
        currentStep: 0,
        totalSteps: 1,
        currentPhase: '',
        currentQuestion: '',
        currentType: 'multiple_choice',
        currentOptions: {},
        currentHelp: '',
        currentRequired: true,
        currentError: '',
        currentArea: null,
        allowFreetext: false,
        textInput: '',
        multiSelected: [],
        multiFreetext: '',
        strategyDraft: {},
        subAgentCatalog: {},
        subAgentSelection: [],
        tools: null,
        readiness: { ready: false, checks: [], missing_blocking: [] },
        chatMessages: [],
        chatInput: '',
        chatLoading: false,
        emailConfig: {
            smtp_host: '', smtp_port: '', smtp_user: '', smtp_pass: '', smtp_encryption: 'tls',
            imap_host: '', imap_port: '', imap_user: '', imap_pass: '', imap_encryption: 'ssl',
            from: ''
        },

        get currentAreaLabel() {
            if (!this.currentArea) return '';
            const labels = {
                sales: 'Vertrieb', support: 'Support / Kundenservice', marketing: 'Marketing',
                hr: 'Personalwesen (HR)', finance: 'Finanzen / Buchhaltung',
                operations: 'Betrieb / Operations', project_management: 'Projektmanagement',
                it: 'IT / Technik'
            };
            return labels[this.currentArea] || this.currentArea;
        },

        freetextItems() {
            return this.multiFreetext.split(',').map(s => s.trim()).filter(s => s !== '');
        },

        async init() {
            try {
                const response = await fetch('{{ path('app_onboarding_start') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({})
                });
                const data = await response.json();
                this.updateStep(data);
            } catch (e) {
                this.currentError = 'Onboarding konnte nicht gestartet werden.';
            } finally {
                this.loading = false;
            }
        },

        toggleMulti(key) {
            const idx = this.multiSelected.indexOf(key);
            if (idx === -1) {
                this.multiSelected.push(key);
            } else {
                this.multiSelected.splice(idx, 1);
            }
        },

        async submitMultiselect() {
            const items = [...this.multiSelected, ...this.freetextItems()];
            if (items.length === 0) {
                this.currentError = 'Bitte mindestens eine Option auswaehlen.';
                return;
            }
            await this.submitResponse(items);
        },

        async submitMultiselectSkip() {
            await this.submitResponse([]);
        },

        async submitResponse(response) {
            this.loading = true;
            this.currentError = '';
            try {
                const res = await fetch('{{ path('app_onboarding_next') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ response: response })
                });
                const data = await res.json();
                this.textInput = '';
                this.resetMulti();
                this.resetEmailConfig();
                if (!res.ok && data.error_type === 'invalid_api_key') {
                    this.currentError = data.error;
                    this.restoreStep();
                    return;
                }
                this.updateStep(data);
            } catch (e) {
                this.currentError = 'Antwort konnte nicht gesendet werden.';
            } finally {
                this.loading = false;
            }
        },

        async submitEmailCombined() {
            const cfg = { ...this.emailConfig };
            // SMTP-User/Pass als Fallback fuer IMAP verwenden, falls leer.
            if (!cfg.imap_user.trim()) cfg.imap_user = cfg.smtp_user;
            if (!cfg.imap_pass.trim()) cfg.imap_pass = cfg.smtp_pass;
            if (!cfg.smtp_host.trim() && !cfg.imap_host.trim()) {
                this.currentError = 'Bitte mindestens einen Host angeben oder ueberspringen.';
                return;
            }
            await this.submitResponse(cfg);
        },

        resetMulti() {
            this.multiSelected = [];
            this.multiFreetext = '';
        },

        resetEmailConfig() {
            this.emailConfig = {
                smtp_host: '', smtp_port: '', smtp_user: '', smtp_pass: '', smtp_encryption: 'tls',
                imap_host: '', imap_port: '', imap_user: '', imap_pass: '', imap_encryption: 'ssl',
                from: ''
            };
        },

        restoreStep() {
            // Bei Validierungsfehler:aktuellen Schritt beibehalten, nur Loading entfernen.
        },

        async sendChat() {
            const message = this.chatInput.trim();
            if (!message || this.chatLoading) return;
            this.chatMessages.push({ role: 'user', text: message });
            this.chatInput = '';
            this.chatLoading = true;
            try {
                const res = await fetch('{{ path('app_onboarding_chat') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ message: message })
                });
                const data = await res.json();
                this.chatMessages.push({ role: 'agent', text: data.response || '(keine Antwort)' });
                if (data.step) this.updateStep(data.step);
                this.$nextTick(() => this.$refs.chatLog && (this.$refs.chatLog.scrollTop = this.$refs.chatLog.scrollHeight));
            } catch (e) {
                this.chatMessages.push({ role: 'agent', text: 'Chat fehlgeschlagen. Bitte erneut versuchen.' });
            } finally {
                this.chatLoading = false;
            }
        },
        openChatHint() {
            this.chatMessages.push({ role: 'agent', text: 'Schreib mir hier einfach, was EVIE fuer dich tun soll.' });
        },
        async submitSubAgentSelection() {
            const selected = this.subAgentSelection.length > 0
                ? this.subAgentSelection.join(',')
                : 'confirm';
            await this.submitResponse(selected);
        },
        async requestComplete() {
            this.loading = true;
            this.currentError = '';
            try {
                const res = await fetch('{{ path('app_onboarding_complete') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({})
                });
                const data = await res.json();
                if (res.ok && data.status === 'completed') {
                    this.completed = true;
                    return;
                }
                if (res.status === 422) {
                    this.readiness = data.readiness || this.readiness;
                    const blocking = (this.readiness.checks || []).filter(c => c.blocking && !c.passed).map(c => c.label);
                    this.currentError = 'Es fehlen noch Pflichtangaben: ' + blocking.join(', ');
                    if (confirm('Ohne LLM-API-Key und Aufgabe ist EVIE nicht funktionsfaehig.\n\nTrotzdem abschliessen (Skip)?')) {
                        await this.forceComplete();
                    }
                    return;
                }
                this.currentError = data.error || 'Abschluss fehlgeschlagen.';
            } catch (e) {
                this.currentError = 'Abschluss fehlgeschlagen.';
            } finally {
                this.loading = false;
            }
        },
        async forceComplete() {
            try {
                const res = await fetch('{{ path('app_onboarding_complete') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ force: true })
                });
                const data = await res.json();
                if (res.ok && data.status === 'completed') {
                    this.completed = true;
                }
            } catch (e) {
                this.currentError = 'Abschluss fehlgeschlagen.';
            }
        },
        async skipOnboarding() {
            if (!confirm('M\u00f6chtest du das Onboarding wirklich \u00fcberspringen? Du kannst es sp\u00e4ter in den Einstellungen nachholen.')) {
                return;
            }
            try {
                await fetch('{{ path('app_onboarding_complete') }}', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                window.location.href = '{{ path("app_dashboard") }}';
            } catch (e) {
                this.currentError = '\u00dcberspringen fehlgeschlagen.';
            }
        },

        updateStep(data) {
            if (data.status === 'completed') {
                this.completed = true;
                return;
            }
            this.strategyDraft = data.strategy_draft || this.strategyDraft || {};
            this.subAgentCatalog = data.sub_agent_catalog || {};
            this.tools = data.tools !== undefined ? data.tools : this.tools;
            this.readiness = data.readiness || this.readiness;
            this.subAgentSelection = (this.strategyDraft.sub_agents || []).slice();
            this.currentStep = data.current_step ?? 0;
            this.totalSteps = data.total_steps ?? (this.currentStep + 1);
            this.currentPhase = data.phase ?? '';
            this.currentQuestion = data.question ?? 'Wie k\u00f6nnen wir dir helfen?';
            this.currentType = data.type ?? 'multiple_choice';
            this.currentOptions = data.options ?? {};
            this.currentHelp = data.help ?? '';
            this.currentRequired = data.required !== false;
            this.currentArea = data.area ?? null;
            this.allowFreetext = data.allow_freetext === true;
        }
    });
    if (typeof Alpine !== 'undefined') {
        Alpine.data('onboardingFlow', factory);
    } else {
        document.addEventListener('alpine:init', () => Alpine.data('onboardingFlow', factory));
    }
</script>
{% endblock %}
{% endblock %}
