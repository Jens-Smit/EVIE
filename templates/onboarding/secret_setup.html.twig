{# templates/onboarding/secret_setup.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Secret Setup - Onboarding - EVIE{% endblock %}

{% block body %}
<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {# Onboarding Header #}
    <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Configure Secrets</h1>
        <p class="text-slate-600 dark:text-slate-400 mt-2">Some capabilities require API keys or other secrets to function properly</p>
    </div>

    {# Progress #}
    <div class="evie-onboarding-progress mb-12">
        {% for step in steps %}
            <div class="step {% if step == 'secret_setup' %}active{% elseif steps|indexOf(step) < steps|indexOf('secret_setup') %}completed{% endif %}">
                <div class="circle">
                    {% if step == 'secret_setup' %}
                        5
                    {% elseif steps|indexOf(step) < steps|indexOf('secret_setup') %}
                        <i class="ph ph-check text-white"></i>
                    {% else %}
                        {{ steps|indexOf(step) + 1 }}
                    {% endif %}
                </div>
                <div class="label">{{ step|replace({'_', '-'}, {'_': ' ', '-': ' '})|title }}</div>
            </div>
        {% endfor %}
    </div>

    {# Content #}
    <div class="glass-panel p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            {# Required Secrets #}
            <div class="glass-panel p-4">
                <h3 class="text-lg font-medium text-slate-900 dark:text-slate-100 mb-3">Required Secrets</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">{{ requirements.required|length }} secrets required</p>
                
                {% if requirements.required|length > 0 %}
                    <div class="space-y-3">
                        {% for secret in requirements.required %}
                            <div class="p-3 bg-red-50 dark:bg-red-900/10 rounded-lg border border-red-200 dark:border-red-800/30">
                                <div class="flex justify-between items-start mb-1">
                                    <div>
                                        <div class="font-medium text-slate-900 dark:text-slate-100">{{ secret.key }}</div>
                                        <div class="text-xs text-slate-500 dark:text-slate-400">{{ secret.description }}</div>
                                    </div>
                                    <span class="evie-badge evie-badge-error">Required</span>
                                </div>
                                <div class="text-xs text-slate-500 dark:text-slate-400">
                                    Required by: {{ secret.capability }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center text-emerald-600 dark:text-emerald-400 py-4">
                        <i class="ph ph-check-circle text-3xl mb-2"></i>
                        <p>All required secrets are configured!</p>
                    </div>
                {% endif %}
            </div>

            {# Configured Secrets #}
            <div class="glass-panel p-4">
                <h3 class="text-lg font-medium text-slate-900 dark:text-slate-100 mb-3">Configured Secrets</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">{{ requirements.configured|length }} secrets configured</p>
                
                {% if requirements.configured|length > 0 %}
                    <div class="space-y-3">
                        {% for secret in requirements.configured %}
                            <div class="p-3 bg-emerald-50 dark:bg-emerald-900/10 rounded-lg border border-emerald-200 dark:border-emerald-800/30">
                                <div class="flex justify-between items-start mb-1">
                                    <div>
                                        <div class="font-medium text-slate-900 dark:text-slate-100">{{ secret.key }}</div>
                                        <div class="text-xs text-slate-500 dark:text-slate-400">{{ secret.description }}</div>
                                    </div>
                                    <span class="evie-badge evie-badge-success">Configured</span>
                                </div>
                                <div class="text-xs text-slate-500 dark:text-slate-400">
                                    Required by: {{ secret.capability }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center text-slate-500 dark:text-slate-400 py-4">
                        <i class="ph ph-lock-simple text-3xl mb-2"></i>
                        <p>No secrets configured yet</p>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Add Secret Form #}
        <div class="glass-panel p-4 mb-8">
            <h3 class="text-lg font-medium text-slate-900 dark:text-slate-100 mb-4">Add New Secret</h3>
            
            <form method="post" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="secret_key" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Secret Key</label>
                        <input type="text" id="secret_key" name="secret_key" class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50" placeholder="e.g., MISTRAL_API_KEY" required>
                    </div>
                    <div>
                        <label for="secret_value" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Secret Value</label>
                        <input type="password" id="secret_value" name="secret_value" class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50" placeholder="Your API key" required>
                    </div>
                </div>
                <div>
                    <label for="description" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Description (Optional)</label>
                    <input type="text" id="description" name="description" class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50" placeholder="e.g., Mistral API Key">
                </div>

                {# Navigation #}
                <div class="flex justify-between gap-2 pt-4 border-t border-slate-200 dark:border-slate-700">
                    <a href="{{ path('onboarding_llm_selection') }}" class="px-6 py-3 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                        <i class="ph ph-arrow-left"></i>
                        Back
                    </a>
                    <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors">
                        Save Secret & Continue
                        <i class="ph ph-arrow-right"></i>
                    </button>
                </div>
            </form>
        </div>

        {# Skip Option #}
        {% if requirements.required|length == 0 %}
            <div class="text-center">
                <a href="{{ path('onboarding_integration_setup') }}" class="px-6 py-3 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                    Skip Secret Setup
                    <i class="ph ph-arrow-right"></i>
                </a>
            </div>
        {% endif %}
    </div>
</div>

<style>
    .evie-onboarding-progress {
        display: flex;
        justify-content: space-between;
        position: relative;
    }
    
    .evie-onboarding-progress::before {
        content: '';
        position: absolute;
        top: 2rem;
        left: 0;
        right: 0;
        height: 2px;
        background-color: #dee2e6;
        z-index: 1;
    }
    
    .evie-onboarding-progress .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 2;
        flex: 1;
    }
    
    .evie-onboarding-progress .circle {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        background-color: #dee2e6;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin-bottom: 0.5rem;
        transition: all 0.3s ease;
    }
    
    .evie-onboarding-progress .label {
        font-size: 0.875rem;
        color: #6c757d;
        text-align: center;
        transition: all 0.3s ease;
    }
    
    .evie-onboarding-progress .step.completed .circle {
        background-color: #2185d0;
        color: white;
    }
    
    .evie-onboarding-progress .step.active .circle {
        background-color: #2185d0;
        color: white;
    }
    
    .evie-onboarding-progress .step.completed .label,
    .evie-onboarding-progress .step.active .label {
        color: #2185d0;
        font-weight: 500;
    }
</style>

{% block javascripts %}
<script>
    // Additional JavaScript for secret setup
</script>
{% endblock %}
{% endblock %}
