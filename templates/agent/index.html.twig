{% extends 'base.html.twig' %}

{% block title %}EVIE - Willkommen{% endblock %}

{% block body %}
<div class="text-center mb-4">
    <h1>Willkommen bei EVIE</h1>
    <p class="mt-2">Dein selbst-evolvierender AI-Agent für komplexe Aufgaben</p>
</div>

<div class="card">
    <h2 class="card-title">Über EVIE</h2>
    <p>
        EVIE ist ein fortschrittliches AI-Agenten-System, das auf dem Symfony AI Bundle basiert.
        Es ermöglicht die Erstellung und Verwaltung von selbstlernenden Agenten, die 
        verschiedene Aufgaben in deinem Unternehmen übernehmen können.
    </p>
    <p>
        Mit EVIE kannst du:
    </p>
    <ul>
        <li>AI-Agenten für spezifische Aufgaben erstellen und trainieren</li>
        <li>Dialoge mit Agenten führen und deren Antworten verwalten</li>
        <li>Tools für Agenten freischalten und verwalten</li>
        <li>Den Verlauf aller Interaktionen einsehen</li>
    </ul>
</div>

<div class="card">
    <h2 class="card-title">Schnellstart</h2>
    <div class="text-center">
        <a href="{{ path('agent_dialog') }}" class="btn btn-primary mt-2">
            AI-Agenten Dialog starten
        </a>
        <a href="{{ path('agent_history') }}" class="btn btn-secondary mt-2">
            Verlauf anzeigen
        </a>
        <a href="{{ path('tools_pending') }}" class="btn btn-secondary mt-2">
            Ausstehende Tools verwalten
        </a>
    </div>
</div>

<div class="card">
    <h2 class="card-title">Systemstatus</h2>
    <div class="text-center">
        <p>System: <span class="badge badge-approved">Operativ</span></p>
        <p>Agenten: <span class="badge badge-approved">Aktiv</span></p>
        <p>Tools: <span class="badge badge-pending">Wartung</span></p>
    </div>
</div>
{% endblock %}