{# templates/agent/llm_configurations.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}LLM Configurations - EVIE{% endblock %}

{% block body %}
<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6" x-data="{
    selectedProvider: '',
    selectedModel: '',
    
    providers: {{ providers|json_encode|raw }},
    
    getProviderModels(providerIdentifier) {
        const provider = this.providers.find(p => p.identifier === providerIdentifier);
        return provider ? Object.entries(provider.models) : [];
    }
}">
    {# Header #}
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">LLM Configurations</h1>
            <p class="text-slate-600 dark:text-slate-400 mt-1">Configure your Large Language Model providers</p>
        </div>
    </div>

    {# Default Configuration Notice #}
    {% if defaultLlmConfig %}
        <div class="mb-6 p-4 bg-primary/10 dark:bg-primary/20 border border-primary/30 rounded-lg">
            <div class="flex items-start gap-3">
                <i class="ph ph-star text-primary text-xl mt-0.5"></i>
                <div>
                    <h3 class="font-semibold text-slate-900 dark:text-slate-100">Default Configuration</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">
                        Your default LLM is <strong>{{ defaultLlmConfig.provider }}:{{ defaultLlmConfig.model }}</strong>.
                        This will be used for all agent executions unless specified otherwise.
                    </p>
                </div>
            </div>
        </div>
    {% endif %}

    {# Existing Configurations #}
    <div class="glass-panel mb-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Your Configurations</h2>
        </div>
        
        {% if llmConfigs|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {% for config in llmConfigs %}
                    <div class="p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg border border-slate-200 dark:border-slate-700">
                        <div class="flex justify-between items-start mb-2">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-primary/10 dark:bg-primary/20 flex items-center justify-center">
                                    <i class="ph ph-cpu text-primary text-sm"></i>
                                </div>
                                <div>
                                    <div class="font-medium text-slate-900 dark:text-slate-100">{{ config.provider }}:{{ config.model }}</div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400">
                                        {% if config.isDefault %}
                                            <span class="text-amber-600 dark:text-amber-400">Default</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                {% if config.isConfigured %}
                                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                    <span class="text-xs text-emerald-600 dark:text-emerald-400">Configured</span>
                                {% else %}
                                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                    <span class="text-xs text-amber-600 dark:text-amber-400">Needs Config</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="text-sm text-slate-600 dark:text-slate-400 mb-2">
                            {% if config.configuration %}
                                <div class="grid grid-cols-2 gap-2">
                                    {% if config.configuration.temperature is defined %}
                                        <div>
                                            <div class="text-xs text-slate-400 dark:text-slate-500">Temperature</div>
                                            <div>{{ config.configuration.temperature }}</div>
                                        </div>
                                    {% endif %}
                                    {% if config.configuration.max_tokens is defined %}
                                        <div>
                                            <div class="text-xs text-slate-400 dark:text-slate-500">Max Tokens</div>
                                            <div>{{ config.configuration.max_tokens }}</div>
                                        </div>
                                    {% endif %}
                                </div>
                            {% else %}
                                <span class="text-slate-400 dark:text-slate-500">No custom configuration</span>
                            {% endif %}
                        </div>
                        <div class="flex justify-end gap-2">
                            {% if not config.isDefault %}
                                <form action="{{ path('agent_llm_set_default', {'id': config.id}) }}" method="post" class="inline">
                                    <button type="submit" class="px-3 py-1 bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-lg hover:bg-amber-200 dark:hover:bg-amber-800/50 transition-colors text-sm">
                                        <i class="ph ph-star"></i>
                                        Set Default
                                    </button>
                                </form>
                            {% endif %}
                            <form action="{{ path('agent_llm_delete', {'id': config.id}) }}" method="post" class="inline" onclick="return confirm('Delete this configuration?')">
                                <button type="submit" class="px-3 py-1 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 rounded-lg hover:bg-red-200 dark:hover:bg-red-800/50 transition-colors text-sm">
                                    <i class="ph ph-trash"></i>
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-8 text-slate-500 dark:text-slate-400">
                <i class="ph ph-cpu text-4xl mb-2"></i>
                <p>No LLM configurations found</p>
            </div>
        {% endif %}
    </div>

    {# New Configuration Form #}
    <div class="glass-panel">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Add New Configuration</h2>
        </div>
        
        <form method="post" action="{{ path('agent_llm_save') }}" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="provider" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Provider</label>
                    <select 
                        id="provider" 
                        name="provider" 
                        x-model="selectedProvider"
                        @change="selectedModel = ''"
                        class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50"
                        required
                    >
                        <option value="">Select a provider</option>
                        {% for provider in providers %}
                            <optgroup label="{{ provider.name }}">
                                {% for model, modelName in provider.models %}
                                    <option value="{{ provider.identifier }}:{{ model }}">{{ modelName }}</option>
                                {% endfor %}
                            </optgroup>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="model" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Model</label>
                    <select 
                        id="model" 
                        name="model" 
                        x-model="selectedModel"
                        class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50"
                        required
                    >
                        <option value="">Select a model</option>
                        <template x-for="[model, modelName] in getProviderModels(selectedProvider.split(':')[0])" :key="model">
                            <option :value="model" x-text="modelName"></option>
                        </template>
                    </select>
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Configuration (Optional)</label>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs text-slate-500 dark:text-slate-400 mb-1">Temperature</label>
                        <input 
                            type="number" 
                            name="configuration[temperature]" 
                            min="0" 
                            max="2" 
                            step="0.1" 
                            value="0.7" 
                            class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200"
                        >
                    </div>
                    <div>
                        <label class="block text-xs text-slate-500 dark:text-slate-400 mb-1">Max Tokens</label>
                        <input 
                            type="number" 
                            name="configuration[max_tokens]" 
                            min="1" 
                            max="32768" 
                            value="4096" 
                            class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200"
                        >
                    </div>
                    <div>
                        <label class="block text-xs text-slate-500 dark:text-slate-400 mb-1">Top P</label>
                        <input 
                            type="number" 
                            name="configuration[top_p]" 
                            min="0" 
                            max="1" 
                            step="0.1" 
                            value="0.9" 
                            class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200"
                        >
                    </div>
                    <div>
                        <label class="block text-xs text-slate-500 dark:text-slate-400 mb-1">Top K</label>
                        <input 
                            type="number" 
                            name="configuration[top_k]" 
                            min="1" 
                            max="100" 
                            value="50" 
                            class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200"
                        >
                    </div>
                </div>
            </div>
            
            <div class="flex items-center gap-4">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input 
                        type="checkbox" 
                        name="is_default" 
                        value="1" 
                        class="w-5 h-5 text-primary border-slate-300 dark:border-slate-600 rounded focus:ring-primary/50"
                        {% if not defaultLlmConfig %}checked{% endif %}
                    >
                    <span class="text-slate-700 dark:text-slate-300">Set as default configuration</span>
                </label>
            </div>
            
            <div class="flex justify-end gap-2 pt-4 border-t border-slate-200 dark:border-slate-700">
                <button type="reset" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                    Reset
                </button>
                <button type="submit" class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors">
                    <i class="ph ph-plus"></i>
                    Save Configuration
                </button>
            </div>
        </form>
    </div>
</div>

{% block javascripts %}
<script>
    // Additional JavaScript for LLM configurations
</script>
{% endblock %}
{% endblock %}
