{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/github-markdown-css@5.2.0/github-markdown-light.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.7.0/styles/github.min.css">
    <style>
        /* Markdown-Stile */
        .markdown-body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }
        .markdown-body h1,
        .markdown-body h2,
        .markdown-body h3 {
            margin-top: 1rem;
            margin-bottom: 0.5rem;
            color: #2563eb;
        }
        .markdown-body pre {
            background: #f3f4f6;
            padding: 1rem;
            border-radius: 0.5rem;
            overflow-x: auto;
        }
        .markdown-body code {
            background: #f3f4f6;
            padding: 0.2rem 0.4rem;
            border-radius: 0.25rem;
            font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
        }
        .markdown-body blockquote {
            border-left: 3px solid #2563eb;
            padding-left: 1rem;
            margin-left: 0;
            color: #6b7280;
            font-style: italic;
        }
        .markdown-body table {
            border-collapse: collapse;
            width: 100%;
            margin: 1rem 0;
        }
        .markdown-body th,
        .markdown-body td {
            border: 1px solid #e5e7eb;
            padding: 0.5rem;
        }
        .markdown-body th {
            background: #f3f4f6;
        }
        
        /* Akkordeon-Stile */
        .response-accordion summary {
            list-style: none;
            padding: 0.5rem;
            background: #f3f4f6;
            border-radius: 0.5rem;
            cursor: pointer;
            font-weight: bold;
        }
        .response-accordion[open] summary {
            background: #e5e7eb;
        }
        .response-accordion .content {
            margin-top: 0.5rem;
            padding: 0.5rem;
        }
        
        /* Chat-Blasen-Stile */
        .chat-message {
            margin-bottom: 1rem;
            max-width: 80%;
        }
        .chat-message.user {
            margin-left: auto;
            text-align: right;
        }
        .chat-message.agent {
            margin-right: auto;
        }
        .message-bubble {
            display: inline-block;
            padding: 1rem;
            border-radius: 0.75rem;
        }
        .message-bubble.user {
            background: #2563eb;
            color: white;
        }
        .message-bubble.agent {
            background: #f3f4f6;
            color: #374151;
        }
        .message-bubble.system {
            background: #fef3c7;
            color: #92400e;
            text-align: center;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/highlight.js@11.7.0/highlight.min.js"></script>
    <script>
        // Konfiguriere marked, um Code-Blöcke mit highlight.js zu rendern
        marked.setOptions({
            highlight: function(code, lang) {
                if (lang && hljs.getLanguage(lang)) {
                    return hljs.highlight(lang, code).value;
                }
                return hljs.highlightAuto(code).value;
            },
            langPrefix: 'language-',
            gfm: true,
            breaks: true
        });
    </script>
{% endblock %}

{% block title %}EVIE - AI Dialog{% endblock %}

{% block body %}
    <div class="bg-white rounded-lg shadow p-6">
        <h1 class="text-2xl font-bold text-secondary mb-4">AI Agent Dialog</h1>
        <p class="text-gray-700 mb-6">Stelle dem EVIE-Agenten eine Frage oder gib ihm eine Aufgabe.</p>
        
        <!-- Chat Container -->
        <div 
            id="chat-container" 
            class="max-h-[600px] overflow-y-auto border border-gray-300 rounded-lg p-4 mb-6 bg-white"
        >
            {% if messages is defined and messages|length > 0 %}
                {% for message in messages %}
                    <div class="chat-message {% if message.role == 'user' %}user{% elseif message.role == 'agent' %}agent{% else %}system{% endif %}">
                        <div class="message-bubble {% if message.role == 'user' %}user{% elseif message.role == 'agent' %}agent{% else %}system{% endif %}">
                            {{ message.content }}
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="text-center text-gray-500 p-4">
                    Starte eine Konversation mit dem AI-Agenten.
                </div>
            {% endif %}
        </div>

        <!-- Chat Form -->
        <form id="chat-form" action="{{ path('agent_dialog') }}" method="post" class="space-y-4">
            <div>
                <label for="prompt" class="block text-sm font-medium text-gray-700 mb-1">Deine Nachricht:</label>
                <textarea 
                    id="prompt" 
                    name="prompt" 
                    class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                    placeholder="Was möchtest du den Agenten fragen?"
                    required
                ></textarea>
            </div>
            <input type="hidden" name="user_identifier" value="default_user">
            <button 
                type="submit" 
                class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-secondary transition flex items-center gap-2"
            >
                <span>Senden</span>
            </button>
        </form>

        <!-- Hinweise -->
        <div class="mt-6 bg-gray-50 rounded-lg p-4">
            <h2 class="text-lg font-bold text-secondary mb-2">Hinweise</h2>
            <ul class="list-disc list-inside text-gray-700 space-y-1">
                <li>Der Agent antwortet basierend auf seinen Trainingsdaten und dem aktuellen Kontext.</li>
                <li>Für komplexe Anfragen kann die Antwort etwas länger dauern.</li>
                <li>Alle Dialoge werden in Ihrem Verlauf gespeichert.</li>
                <li>Markdown, Code-Blöcke und Tabellen werden automatisch formatiert.</li>
            </ul>
        </div>
    </div>
{% endblock %}
