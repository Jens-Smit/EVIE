{# templates/agent/dialog.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}EVIE – AI Dialog{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <div class="card p-6">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-content">AI Agent Dialog</h1>
                <p class="text-content-muted mt-1">Stelle dem EVIE-Agenten eine Frage oder gib ihm eine Aufgabe.</p>
            </div>
            <a href="{{ path('frontend_agent_history') }}" class="btn btn-ghost">
                <i class="ph ph-clock-counter-clockwise"></i>
                Verlauf
            </a>
        </div>
        
        {# Chat Container #}
        <div id="chat-container" class="space-y-4 mb-6 max-h-[500px] overflow-y-auto pr-2">
            {% if messages is defined and messages|length > 0 %}
                {% for message in messages %}
                    {% if message.role == 'system' %}
                        <div class="flex justify-center">
                            <div class="chat-bubble-system rounded-xl px-4 py-2 text-sm">
                                {{ message.content }}
                            </div>
                        </div>
                    {% elseif message.role == 'user' %}
                        <div class="flex justify-end">
                            <div class="chat-bubble-user rounded-xl px-4 py-2 max-w-[75%]">
                                {{ message.content }}
                            </div>
                        </div>
                    {% else %}
                        <div class="flex justify-start">
                            <div class="chat-bubble-agent rounded-xl px-4 py-2 max-w-[75%]">
                                {{ message.content }}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            {% else %}
                <div class="flex justify-center">
                    <div class="chat-bubble-system rounded-xl px-4 py-2 text-sm">
                        Willkommen beim EVIE-Agenten! Wie kann ich dir helfen?
                    </div>
                </div>
            {% endif %}
        </div>

        {# Chat Form #}
        <form id="chat-form" class="space-y-4">
            <div>
                <label for="prompt" class="block text-sm font-medium text-content mb-2">
                    Deine Nachricht:
                </label>
                <textarea id="prompt" name="prompt"
                          class="w-full p-3 border border-border rounded-xl bg-white dark:bg-slate-800
                                 focus:ring-2 focus:ring-primary focus:border-transparent
                                 text-content placeholder-content-subtle"
                          placeholder="Was möchtest du den Agenten fragen?"
                          rows="3" required></textarea>
            </div>
            <input type="hidden" name="user_identifier" value="default_user">
            <div class="flex justify-end">
                <button type="submit" class="btn btn-primary px-6">
                    <i class="ph ph-paper-plane-right"></i>
                    Senden
                </button>
            </div>
        </form>

        {# Hinweise #}
        <div class="mt-6 bg-surface-muted rounded-xl p-4 border border-border">
            <h2 class="font-semibold text-content mb-3 flex items-center gap-2">
                <i class="ph ph-info text-info"></i>
                Hinweise
            </h2>
            <ul class="space-y-2 text-sm text-content-muted">
                <li class="flex items-start gap-2">
                    <i class="ph ph-dot text-primary mt-0.5"></i>
                    Der Agent antwortet basierend auf seinen Trainingsdaten und dem aktuellen Kontext.
                </li>
                <li class="flex items-start gap-2">
                    <i class="ph ph-dot text-primary mt-0.5"></i>
                    Für komplexe Anfragen kann die Antwort etwas länger dauern.
                </li>
                <li class="flex items-start gap-2">
                    <i class="ph ph-dot text-primary mt-0.5"></i>
                    Alle Dialoge werden in der Datenbank gespeichert und im
                    <a href="{{ path('frontend_agent_history') }}" class="text-primary underline">Verlauf</a> angezeigt.
                </li>
                <li class="flex items-start gap-2">
                    <i class="ph ph-dot text-primary mt-0.5"></i>
                    Markdown, Code-Blöcke und Tabellen werden automatisch formatiert.
                </li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('chat-form');
            const chatContainer = document.getElementById('chat-container');
            const prompt = document.getElementById('prompt');

            form.addEventListener('submit', async function (e) {
                e.preventDefault();

                const message = prompt.value.trim();
                if (!message) {
                    return;
                }

                // User-Nachricht im Chat anzeigen
                appendMessage('user', message);
                prompt.value = '';
                prompt.focus();

                // Typing-Indikator anzeigen
                const typingEl = showTyping();

                try {
                    const response = await fetch('{{ path('agent_dialog') }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            message: message,
                            user_identifier: 'default_user'
                        })
                    });

                    const data = await response.json();
                    typingEl.remove();

                    if (!response.ok) {
                        appendMessage('agent', 'Fehler: ' + (data.error || 'Unbekannter Fehler'));
                        return;
                    }

                    appendMessage('agent', data.response || 'Keine Antwort erhalten.');
                } catch (err) {
                    typingEl.remove();
                    appendMessage('agent', 'Fehler: ' + err.message);
                }
            });

            function appendMessage(role, content) {
                const wrapper = document.createElement('div');
                const bubble = document.createElement('div');

                if (role === 'user') {
                    wrapper.className = 'flex justify-end';
                    bubble.className = 'chat-bubble-user rounded-xl px-4 py-2 max-w-[75%] whitespace-pre-wrap';
                } else {
                    wrapper.className = 'flex justify-start';
                    bubble.className = 'chat-bubble-agent rounded-xl px-4 py-2 max-w-[75%] whitespace-pre-wrap';
                }

                bubble.textContent = content;
                wrapper.appendChild(bubble);
                chatContainer.appendChild(wrapper);
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }

            function showTyping() {
                const wrapper = document.createElement('div');
                wrapper.className = 'flex justify-start';
                wrapper.innerHTML = '<div class="chat-bubble-agent rounded-xl px-4 py-2">' +
                    '<span class="typing-dot">.</span>' +
                    '<span class="typing-dot">.</span>' +
                    '<span class="typing-dot">.</span>' +
                    '</div>';
                chatContainer.appendChild(wrapper);
                chatContainer.scrollTop = chatContainer.scrollHeight;
                return wrapper;
            }
        });
    </script>
{% endblock %}