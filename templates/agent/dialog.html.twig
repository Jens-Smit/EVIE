{# templates/agent/dialog.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}EVIE – AI Dialog{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <div class="card p-6">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-content">AI Agent Dialog</h1>
                <p class="text-content-muted mt-1">Stelle dem EVIE-Agenten eine Frage oder gib ihm eine Aufgabe.</p>
            </div>
            <a href="{{ path('frontend_agent_history') }}" class="btn btn-ghost">
                <i class="ph ph-clock-counter-clockwise"></i>
                Verlauf
            </a>
        </div>
        
        {# Chat Container #}
        <div id="chat-container" class="space-y-4 mb-6 max-h-[500px] overflow-y-auto pr-2">
            {% if messages is defined and messages|length > 0 %}
                {% for message in messages %}
                    {% if message.role == 'system' %}
                        <div class="flex justify-center">
                            <div class="chat-bubble-system rounded-xl px-4 py-2 text-sm">
                                {{ message.content }}
                            </div>
                        </div>
                    {% elseif message.role == 'user' %}
                        <div class="flex justify-end">
                            <div class="chat-bubble-user rounded-xl px-4 py-2 max-w-[75%]">
                                {{ message.content }}
                            </div>
                        </div>
                    {% else %}
                        <div class="flex justify-start">
                            <div class="chat-bubble-agent rounded-xl px-4 py-2 max-w-[75%]">
                                {{ message.content }}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            {% else %}
                <div class="flex justify-center">
                    <div class="chat-bubble-system rounded-xl px-4 py-2 text-sm">
                        Willkommen beim EVIE-Agenten! Wie kann ich dir helfen?
                    </div>
                </div>
            {% endif %}
        </div>

        {# Chat Form #}
        <form id="chat-form" action="{{ path('agent_dialog') }}" method="post" class="space-y-4">
            <div>
                <label for="prompt" class="block text-sm font-medium text-content mb-2">
                    Deine Nachricht:
                </label>
                <textarea id="prompt" name="prompt"
                          class="w-full p-3 border border-border rounded-xl bg-surface
                                 focus:ring-2 focus:ring-primary focus:border-transparent
                                 text-content placeholder-content-subtle"
                          placeholder="Was möchtest du den Agenten fragen?"
                          rows="3" required></textarea>
            </div>
            <input type="hidden" name="user_identifier" value="default_user">
            <div class="flex justify-end">
                <button type="submit" class="btn btn-primary px-6">
                    <i class="ph ph-paper-plane-right"></i>
                    Senden
                </button>
            </div>
        </form>

        {# Hinweise #}
        <div class="mt-6 bg-surface-muted rounded-xl p-4 border border-border">
            <h2 class="font-semibold text-content mb-3 flex items-center gap-2">
                <i class="ph ph-info text-info"></i>
                Hinweise
            </h2>
            <ul class="space-y-2 text-sm text-content-muted">
                <li class="flex items-start gap-2">
                    <i class="ph ph-dot text-primary mt-0.5"></i>
                    Der Agent antwortet basierend auf seinen Trainingsdaten und dem aktuellen Kontext.
                </li>
                <li class="flex items-start gap-2">
                    <i class="ph ph-dot text-primary mt-0.5"></i>
                    Für komplexe Anfragen kann die Antwort etwas länger dauern.
                </li>
                <li class="flex items-start gap-2">
                    <i class="ph ph-dot text-primary mt-0.5"></i>
                    Alle Dialoge werden in der Datenbank gespeichert und im
                    <a href="{{ path('frontend_agent_history') }}" class="text-primary underline">Verlauf</a> angezeigt.
                </li>
                <li class="flex items-start gap-2">
                    <i class="ph ph-dot text-primary mt-0.5"></i>
                    Markdown, Code-Blöcke und Tabellen werden automatisch formatiert.
                </li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}