{% extends 'base.html.twig' %}

{% block title %}EVIE - AI Dialog{% endblock %}

{% block body %}
    <div class="bg-white rounded-lg shadow p-6">
        <h1 class="text-2xl font-bold text-secondary mb-4">AI Agent Dialog</h1>
        <p class="text-gray-700 mb-6">Stelle dem EVIE-Agenten eine Frage oder gib ihm eine Aufgabe.</p>
        
        <!-- Chat Container -->
        <div 
            id="chat-container" 
            class="max-h-[600px] overflow-y-auto border border-gray-300 rounded-lg p-4 mb-6 bg-white"
        >
            {% if messages is defined and messages|length > 0 %}
                {% for message in messages %}
                    <div class="mb-4 max-w-[80%] {% if message.role == 'user' %}ml-auto text-right{% else %}mr-auto{% endif %}">
                        <div class="inline-block p-4 rounded-lg 
                            {% if message.role == 'user' %}bg-primary text-white
                            {% elseif message.role == 'agent' %}bg-gray-200 text-gray-800
                            {% else %}bg-accent text-white text-center{% endif %}
                        ">
                            {{ message.content }}
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="text-center text-gray-500 p-4">
                    Starte eine Konversation mit dem AI-Agenten.
                </div>
            {% endif %}
        </div>

        <!-- Chat Form -->
        <form id="chat-form" action="{{ path('agent_dialog') }}" method="post" class="space-y-4">
            <div>
                <label for="prompt" class="block text-sm font-medium text-gray-700 mb-1">Deine Nachricht:</label>
                <textarea 
                    id="prompt" 
                    name="prompt" 
                    class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                    placeholder="Was möchtest du den Agenten fragen?"
                    required
                ></textarea>
            </div>
            <input type="hidden" name="user_identifier" value="default_user">
            <button 
                type="submit" 
                class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-secondary transition flex items-center gap-2"
            >
                <span>Senden</span>
            </button>
        </form>

        <!-- Hinweise -->
        <div class="mt-6 bg-gray-50 rounded-lg p-4">
            <h2 class="text-lg font-bold text-secondary mb-2">Hinweise</h2>
            <ul class="list-disc list-inside text-gray-700 space-y-1">
                <li>Der Agent antwortet basierend auf seinen Trainingsdaten und dem aktuellen Kontext.</li>
                <li>Für komplexe Anfragen kann die Antwort etwas länger dauern.</li>
                <li>Alle Dialoge werden in Ihrem Verlauf gespeichert.</li>
            </ul>
        </div>
    </div>
{% endblock %}
