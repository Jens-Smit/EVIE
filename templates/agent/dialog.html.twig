{% extends 'base.html.twig' %}

{% block title %}EVIE - AI Dialog{% endblock %}

{% block body %}
<div class="container">
    <div class="card">
        <h1 class="card-title">AI Agent Dialog</h1>
        <p>Stelle dem EVIE-Agenten eine Frage oder gib ihm eine Aufgabe.</p>
        
        <div class="chat-container" id="chat-container">
            {% if messages is defined and messages|length > 0 %}
                {% for message in messages %}
                    <div class="message {{ message.role }}">
                        {{ message.content }}
                    </div>
                {% endfor %}
            {% else %}
                <div class="message system">
                    Starte eine Konversation mit dem AI-Agenten.
                </div>
            {% endif %}
        </div>

        <form id="chat-form" action="{{ path('agent_dialog') }}" method="post" class="mt-2">
            <div class="form-group">
                <label for="prompt">Deine Nachricht:</label>
                <textarea 
                    id="prompt" 
                    name="prompt" 
                    class="form-group" 
                    placeholder="Was möchtest du den Agenten fragen?"
                    required
                ></textarea>
            </div>
            <button type="submit" class="btn">Senden</button>
        </form>
    </div>
    
    <div class="card mt-3">
        <h2 class="card-title">Hinweise</h2>
        <ul>
            <li>Der Agent antwortet basierend auf seinen Trainingsdaten und dem aktuellen Kontext.</li>
            <li>Für komplexe Anfragen kann die Antwort etwas länger dauern.</li>
            <li>Alle Dialoge werden in Ihrem Verlauf gespeichert.</li>
        </ul>
    </div>
</div>
{% endblock %}
