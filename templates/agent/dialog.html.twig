{# templates/agent/dialog.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}EVIE – AI Dialog{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <div class="card p-6">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-content">AI Agent Dialog</h1>
                <p class="text-content-muted mt-1">Stelle dem EVIE-Agenten eine Frage oder gib ihm eine Aufgabe.</p>
            </div>
            <div class="flex gap-2">
                <a href="{{ path('frontend_agent_history') }}" class="btn btn-ghost">
                    <i class="ph ph-clock-counter-clockwise"></i>
                    Verlauf
                </a>
                <div id="pending-tools-badge" class="hidden">
                    <span class="badge badge-pending cursor-pointer" id="pending-tools-link" title="Ausstehende Tool-Freigaben">
                        <i class="ph ph-hourglass"></i>
                        <span id="pending-tools-count">0</span> Freigaben
                    </span>
                </div>
            </div>
                {% if continuing_conversation %}
                    <a href="{{ path('frontend_agent_dialog') }}" class="btn btn-ghost text-warning">
                        <i class="ph ph-x-circle"></i>
                        Neue Konversation
                    </a>
                {% endif %}
            </div>
        </div>
        
        {% if continuing_conversation %}
            <div class="bg-info-soft border border-info/20 text-info px-4 py-3 rounded-xl flex items-center gap-2 mb-6">
                <i class="ph ph-chat-circle-dots text-lg"></i>
                <div>
                    <strong>Fortsetzung der Konversation</strong>
                    <span class="text-content-muted"> – Du chattest weiter mit einer vorherigen Unterhaltung.</span>
                </div>
            </div>
        {% endif %}
        
        {# Chat Container #}
        <div id="chat-container" class="space-y-4 mb-6 max-h-[500px] overflow-y-auto pr-2">
            {% if messages is defined and messages|length > 0 %}
                {% for message in messages %}
                    {% if message.role == 'system' %}
                        <div class="flex justify-center">
                            <div class="chat-bubble-system rounded-xl px-4 py-2 text-sm">
                                {{ message.content }}
                            </div>
                        </div>
                    {% elseif message.role == 'user' %}
                        <div class="flex justify-end">
                            <div class="chat-bubble-user rounded-xl px-4 py-2 max-w-[75%]">
                                {{ message.content }}
                            </div>
                        </div>
                    {% else %}
                        <div class="flex justify-start">
                            <div class="chat-bubble-agent rounded-xl px-4 py-2 max-w-[75%]">
                                {{ message.content }}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            {% else %}
                <div class="flex justify-center">
                    <div class="chat-bubble-system rounded-xl px-4 py-2 text-sm">
                        Willkommen beim EVIE-Agenten! Wie kann ich dir helfen?
                    </div>
                </div>
            {% endif %}
        </div>

        {# HITL Inline Approval Container (wird per JS befüllt) #}
        <div id="hitl-approval-container" class="space-y-3"></div>

        {# Chat Form #}
        <form id="chat-form" class="space-y-4" hx-boost="false">
            <div>
                <label for="prompt" class="block text-sm font-medium text-content mb-2">
                    Deine Nachricht:
                </label>
                <textarea id="prompt" name="prompt"
                          class="w-full p-3 border border-border rounded-xl bg-white dark:bg-slate-800
                                 focus:ring-2 focus:ring-primary focus:border-transparent
                                 text-content placeholder-content-subtle"
                          placeholder="Was möchtest du den Agenten fragen?"
                          rows="3" required>{{ prefilled_task is defined ? prefilled_task : '' }}</textarea>
            </div>
            <input type="hidden" name="user_identifier" value="{{ userIdentifier }}">
            {% if conversation_id is defined and conversation_id is not empty %}
                <input type="hidden" name="conversation_id" value="{{ conversation_id }}">
            {% endif %}
            <div class="flex justify-end">
                <button type="submit" class="btn btn-primary px-6">
                    <i class="ph ph-paper-plane-right"></i>
                    Senden
                </button>
            </div>
        </form>

        {# Hinweise #}
        <div class="mt-6 bg-surface-muted rounded-xl p-4 border border-border">
            <h2 class="font-semibold text-content mb-3 flex items-center gap-2">
                <i class="ph ph-info text-info"></i>
                Hinweise
            </h2>
            <ul class="space-y-2 text-sm text-content-muted">
                <li class="flex items-start gap-2">
                    <i class="ph ph-dot text-primary mt-0.5"></i>
                    Der Agent antwortet basierend auf seinen Trainingsdaten und dem aktuellen Kontext.
                </li>
                <li class="flex items-start gap-2">
                    <i class="ph ph-dot text-primary mt-0.5"></i>
                    Für komplexe Anfragen kann die Antwort etwas länger dauern.
                </li>
                <li class="flex items-start gap-2">
                    <i class="ph ph-dot text-primary mt-0.5"></i>
                    Alle Dialoge werden in der Datenbank gespeichert und im
                    <a href="{{ path('frontend_agent_history') }}" class="text-primary underline">Verlauf</a> angezeigt.
                </li>
                <li class="flex items-start gap-2">
                    <i class="ph ph-dot text-primary mt-0.5"></i>
                    Markdown, Code-Blöcke und Tabellen werden automatisch formatiert.
                </li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('chat-form');
            const chatContainer = document.getElementById('chat-container');
            const prompt = document.getElementById('prompt');
            const conversationId = form.querySelector('input[name="conversation_id"]')?.value;

            form.addEventListener('submit', async function (e) {
                e.preventDefault();

                const message = prompt.value.trim();
                if (!message) {
                    return;
                }

                // User-Nachricht im Chat anzeigen
                appendMessage('user', message);
                prompt.value = '';
                prompt.focus();

                // Typing-Indikator anzeigen
                const typingEl = showTyping();

                // Live-Progress: pro Turn eine Session-ID generieren, vor
                // dem fetch() ein Mercure-Topic abonnieren und die Pipeline-
                // Events (Phasen, Subagent-/Tool-Schritte) als Timeline
                // rendern. Ohne laufenden Mercure-Hub fehlert der fetch()
                // weiter normal.
                const sessionId = (crypto.randomUUID ? crypto.randomUUID() : 'turn-' + Date.now() + '-' + Math.random().toString(36).slice(2));
                const liveProgress = createLiveProgress();
                const eventSource = subscribeToProgress(sessionId, liveProgress);

                try {
                    // Kurz warten, bis die SSE-Verbindung offen ist, sonst
                    // koennen die ersten Phasen-Events verpasst werden. Bei
                    // fehlender Verbindung (kein Mercure) laeuft der Timeout
                    // weiter, der Dialog funktioniert trotzdem.
                    await new Promise(resolve => {
                        eventSource.onopen = resolve;
                        setTimeout(resolve, 300);
                    });

                    const url = conversationId 
                        ? `/api/agent/dialog?conversation_id=${conversationId}` 
                        : '{{ path('agent_dialog') }}';
                    
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            message: message,
                            session_id: sessionId,
                            user_identifier: form.querySelector('input[name="user_identifier"]').value
                        })
                    });

                    const contentType = response.headers.get('Content-Type') || '';
                    // Server hat keine JSON-Antwort geliefert (z. B. HTML-
                    // Fehlerseite, Login-Redirect, leere Antwort). Statt
                    // response.json() zu erzwingen (-> JSON.parse-Fehler)
                    // wird der Rohtext ausgelesen und sauber gemeldet.
                    if (!response.ok || !contentType.includes('application/json')) {
                        const text = await response.text();
                        typingEl.remove();
                        eventSource.close();
                        liveProgress.finish();
                        if (response.status === 401) {
                            appendMessage('agent', 'Sitzung abgelaufen. Bitte neu anmelden.');
                            window.location.reload();
                            return;
                        }
                        let detail = 'Unbekannter Fehler (HTTP ' + response.status + ')';
                        if (contentType.includes('application/json')) {
                            try { detail = (JSON.parse(text).error) || detail; } catch (e) {}
                        } else if (text && text.length < 300) {
                            detail = text.trim();
                        }
                        appendMessage('agent', 'Fehler: ' + detail);
                        return;
                    }

                    const data = await response.json();
                    typingEl.remove();
                    eventSource.close();
                    liveProgress.finish();

                    appendMessage('agent', data.response || 'Keine Antwort erhalten.');

                    // Frontend-Audit F8: HITL-Inline-Approval prüfen
                    if (data.requires_tool_approval || data.requires_approval || data.pending_tool) {
                        showHitlApproval(data.pending_tool || data);
                    }
                    refreshPendingToolsBadge();
                } catch (err) {
                    typingEl.remove();
                    eventSource.close();
                    liveProgress.finish();
                    appendMessage('agent', 'Fehler: ' + err.message);
                }
            });

            // Live-Progress (Mercure): Topic /streaming/sessions/{sessionId}
            // abonnieren und empfangene Events an die Timeline weitergeben.
            // subscribe: ['*'] in mercure.yaml erlaubt das Abonnement;
            // ein Aufruf von mercure() setzt zudem das Autorisierungs-Cookie.
            function subscribeToProgress(sessionId, liveProgress) {
                const hubUrl = new URL("{{ mercure('/streaming/sessions/live-progress')|escape('js') }}".split('?')[0]);
                hubUrl.searchParams.set('topic', '/streaming/sessions/' + sessionId);
                const eventSource = new EventSource(hubUrl);
                eventSource.onmessage = function (event) {
                    let payload;
                    try {
                        payload = JSON.parse(event.data);
                    } catch (e) {
                        return;
                    }
                    if ((payload.event || '') === 'progress') {
                        const data = payload.data || {};
                        liveProgress.addStep(data.message || 'Fortschritt', data.percentage);
                    }
                };
                return eventSource;
            }

            function createLiveProgress() {
                const container = document.createElement('div');
                container.className = 'flex justify-start w-full';
                const card = document.createElement('div');
                card.className = 'chat-bubble-agent rounded-xl px-4 py-3 w-full max-w-[75%] space-y-2';
                const stepsList = document.createElement('div');
                stepsList.className = 'space-y-1 text-sm';
                const progressBar = document.createElement('div');
                progressBar.className = 'w-full bg-slate-200 dark:bg-slate-600 rounded-full h-1.5';
                const progressFill = document.createElement('div');
                progressFill.className = 'bg-primary h-1.5 rounded-full transition-all';
                progressFill.style.width = '0%';
                progressBar.appendChild(progressFill);
                card.appendChild(stepsList);
                card.appendChild(progressBar);
                container.appendChild(card);
                chatContainer.appendChild(container);
                chatContainer.scrollTop = chatContainer.scrollHeight;

                return {
                    addStep: function (message, percentage) {
                        const row = document.createElement('div');
                        row.className = 'flex items-center gap-2 text-content';
                        const icon = document.createElement('i');
                        icon.className = 'ph ph-check-circle text-primary';
                        const text = document.createElement('span');
                        text.textContent = message;
                        row.appendChild(icon);
                        row.appendChild(text);
                        stepsList.appendChild(row);
                        if (percentage !== null && percentage !== undefined) {
                            progressFill.style.width = Math.min(100, Math.max(0, Number(percentage))) + '%';
                        }
                        chatContainer.scrollTop = chatContainer.scrollHeight;
                    },
                    finish: function () {
                        progressFill.style.width = '100%';
                        setTimeout(function () { container.remove(); }, 1500);
                    }
                };
            }

            function appendMessage(role, content) {
                const wrapper = document.createElement('div');
                const bubble = document.createElement('div');

                if (role === 'user') {
                    wrapper.className = 'flex justify-end';
                    bubble.className = 'chat-bubble-user rounded-xl px-4 py-2 max-w-[75%] whitespace-pre-wrap';
                } else {
                    wrapper.className = 'flex justify-start';
                    bubble.className = 'chat-bubble-agent rounded-xl px-4 py-2 max-w-[75%] whitespace-pre-wrap';
                }

                bubble.textContent = content;
                wrapper.appendChild(bubble);
                chatContainer.appendChild(wrapper);
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }

            function showTyping() {
                const wrapper = document.createElement('div');
                wrapper.className = 'flex justify-start';
                wrapper.innerHTML = '<div class="chat-bubble-agent rounded-xl px-4 py-2">' +
                    '<span class="typing-dot">.</span>' +
                    '<span class="typing-dot">.</span>' +
                    '<span class="typing-dot">.</span>' +
                    '</div>';
                chatContainer.appendChild(wrapper);
                chatContainer.scrollTop = chatContainer.scrollHeight;
                return wrapper;
            }

            // Frontend-Audit F8: HITL Inline Approval
            function showHitlApproval(tool) {
                const container = document.getElementById('hitl-approval-container');
                const toolId = tool.id || tool.tool_id;
                const toolName = tool.name || tool.tool_name || 'Unbekannt';
                const toolDesc = tool.description || tool.tool_description || '';

                const card = document.createElement('div');
                card.className = 'bg-warning-soft border border-warning/30 rounded-xl p-4 space-y-3';
                card.innerHTML = '<div class="flex items-center gap-2">' +
                    '<i class="ph ph-hourglass text-warning text-xl"></i>' +
                    '<strong class="text-content">Tool-Freigabe erforderlich</strong>' +
                    '</div>' +
                    '<p class="text-sm text-content">Neues Tool <strong>' + escapeHtml(toolName) + '</strong> möchte ausgeführt werden.</p>' +
                    (toolDesc ? '<p class="text-xs text-content-muted">' + escapeHtml(toolDesc) + '</p>' : '') +
                    '<div class="flex gap-2">' +
                    '<button class="btn btn-primary hitl-approve" data-tool-id="' + toolId + '">' +
                    '<i class="ph ph-check"></i> Genehmigen</button>' +
                    '<button class="btn btn-ghost hitl-reject" data-tool-id="' + toolId + '">' +
                    '<i class="ph ph-x"></i> Ablehnen</button>' +
                    '</div>';
                container.appendChild(card);

                card.querySelector('.hitl-approve').addEventListener('click', function() {
                    approveTool(toolId, card);
                });
                card.querySelector('.hitl-reject').addEventListener('click', function() {
                    rejectTool(toolId, card);
                });
            }

            async function approveTool(toolId, cardEl) {
                try {
                    const body = new URLSearchParams();
                    body.set('_token', '{{ csrf_token('tool_approval') }}');
                    const res = await fetch('/tools/pending/' + toolId + '/approve', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: body.toString()
                    });
                    if (res.ok) {
                        cardEl.innerHTML = '<div class="flex items-center gap-2 text-success"><i class="ph ph-check-circle text-lg"></i> Tool genehmigt. Agent wird fortgesetzt.</div>';
                        refreshPendingToolsBadge();
                    } else {
                        console.error('Freigabe fehlgeschlagen: HTTP ' + res.status, await res.text().catch(() => ''));
                        showToast('Freigabe fehlgeschlagen (HTTP ' + res.status + ')', 'error');
                    }
                } catch (e) {
                    console.error('Freigabe fehlgeschlagen (Netzwerkfehler):', e);
                    showToast('Freigabe fehlgeschlagen', 'error');
                }
            }

            async function rejectTool(toolId, cardEl) {
                try {
                    const body = new URLSearchParams();
                    body.set('_token', '{{ csrf_token('tool_approval') }}');
                    const res = await fetch('/tools/pending/' + toolId + '/reject', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: body.toString()
                    });
                    if (res.ok) {
                        cardEl.innerHTML = '<div class="flex items-center gap-2 text-danger"><i class="ph ph-x-circle text-lg"></i> Tool abgelehnt.</div>';
                        refreshPendingToolsBadge();
                    } else {
                        console.error('Ablehnung fehlgeschlagen: HTTP ' + res.status, await res.text().catch(() => ''));
                        showToast('Ablehnung fehlgeschlagen (HTTP ' + res.status + ')', 'error');
                    }
                } catch (e) {
                    console.error('Ablehnung fehlgeschlagen (Netzwerkfehler):', e);
                    showToast('Ablehnung fehlgeschlagen', 'error');
                }
            }

            async function refreshPendingToolsBadge() {
                try {
                    const res = await fetch('{{ path('app_pending_tools_count') }}', {
                        credentials: 'include',
                        headers: {
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });
                    const data = await res.json();
                    const count = data.count || 0;
                    const badge = document.getElementById('pending-tools-badge');
                    const countEl = document.getElementById('pending-tools-count');
                    if (count > 0) {
                        countEl.textContent = count;
                        badge.classList.remove('hidden');
                    } else {
                        badge.classList.add('hidden');
                    }
                } catch (e) { /* silent */ }
            }

            function escapeHtml(str) {
                const div = document.createElement('div');
                div.textContent = str;
                return div.innerHTML;
            }

            // Badge beim Laden aktualisieren
            refreshPendingToolsBadge();
            document.getElementById('pending-tools-link')?.addEventListener('click', function() {
                window.location.href = '{{ path('app_tool_pending_list') }}';
            });
        });
    </script>
{% endblock %}
