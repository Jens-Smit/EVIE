{# templates/agent/dashboard.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Agent Dashboard - EVIE{% endblock %}

{% block body %}
<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6" x-data="{}">
    {# Header #}
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Agent Dashboard</h1>
            <p class="text-slate-600 dark:text-slate-400 mt-1">Configure and manage your AI agents</p>
        </div>
        <div class="flex items-center gap-4">
            {% if not onboardingService.isOnboardingComplete(user) %}
                <a href="{{ path('onboarding_dashboard') }}" class="px-4 py-2 bg-amber-500/10 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400 rounded-lg border border-amber-500/30 hover:bg-amber-500/20 dark:hover:bg-amber-500/30 transition-colors">
                    <i class="ph ph-handshake text-lg"></i>
                    <span class="ml-2">Complete Onboarding</span>
                </a>
            {% endif %}
            <button class="px-4 py-2 bg-primary/10 dark:bg-primary/20 text-primary dark:text-white rounded-lg border border-primary/30 hover:bg-primary/20 dark:hover:bg-primary/30 transition-colors" @click="window.location.reload()">
                <i class="ph ph-arrow-clockwise text-lg"></i>
                <span class="ml-2">Refresh</span>
            </button>
        </div>
    </div>

    {# Onboarding Status Banner #}
    {% if not onboardingService.isOnboardingComplete(user) %}
        <div class="mb-6 p-4 bg-amber-500/10 dark:bg-amber-500/20 border border-amber-500/30 rounded-lg">
            <div class="flex items-start gap-3">
                <i class="ph ph-info text-amber-500 text-xl mt-0.5"></i>
                <div>
                    <h3 class="font-semibold text-amber-800 dark:text-amber-200">Onboarding In Progress</h3>
                    <p class="text-sm text-amber-600 dark:text-amber-400 mt-1">
                        You have {{ progress.completedSteps|length }} of {{ progress.totalSteps }} steps completed.
                        <a href="{{ path('onboarding_dashboard') }}" class="text-primary hover:underline">Continue onboarding</a> to unlock all features.
                    </p>
                </div>
            </div>
        </div>
    {% endif %}

    {# Statistics Cards #}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="glass-panel p-4 flex flex-col justify-between hover:scale-[1.02] transition-transform">
            <div>
                <i class="ph ph-cpu text-2xl text-slate-600 dark:text-slate-400"></i>
                <span class="text-3xl font-bold text-slate-900 dark:text-slate-100 mt-2">{{ llmConfigs|length }}</span>
            </div>
            <div class="text-sm text-slate-600 dark:text-slate-400 mt-2">LLM Configurations</div>
        </div>

        <div class="glass-panel p-4 flex flex-col justify-between hover:scale-[1.02] transition-transform">
            <div>
                <i class="ph ph-puzzle-piece text-2xl text-slate-600 dark:text-slate-400"></i>
                <span class="text-3xl font-bold text-slate-900 dark:text-slate-100 mt-2">{{ capabilities|length }}</span>
            </div>
            <div class="text-sm text-slate-600 dark:text-slate-400 mt-2">Capabilities</div>
        </div>

        <div class="glass-panel p-4 flex flex-col justify-between hover:scale-[1.02] transition-transform">
            <div>
                <i class="ph ph-puzzle-piece text-2xl text-slate-600 dark:text-slate-400"></i>
                <span class="text-3xl font-bold text-emerald-600 dark:text-emerald-400 mt-2">{{ readyCapabilities|length }}</span>
            </div>
            <div class="text-sm text-slate-600 dark:text-slate-400 mt-2">Ready Capabilities</div>
        </div>

        <div class="glass-panel p-4 flex flex-col justify-between hover:scale-[1.02] transition-transform">
            <div>
                <i class="ph ph-chats-circle text-2xl text-slate-600 dark:text-slate-400"></i>
                <span class="text-3xl font-bold text-slate-900 dark:text-slate-100 mt-2">{{ conversations|length }}</span>
            </div>
            <div class="text-sm text-slate-600 dark:text-slate-400 mt-2">Conversations</div>
        </div>

        <div class="glass-panel p-4 flex flex-col justify-between hover:scale-[1.02] transition-transform">
            <div>
                <i class="ph ph-robot text-2xl text-slate-600 dark:text-slate-400"></i>
                <span class="text-3xl font-bold text-slate-900 dark:text-slate-100 mt-2">{{ executions|length }}</span>
            </div>
            <div class="text-sm text-slate-600 dark:text-slate-400 mt-2">Executions</div>
        </div>
    </div>

    {# Main Content Grid #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {# Left Column - LLM Configuration #}
        <div class="glass-panel">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">LLM Configuration</h2>
                <a href="{{ path('agent_llm_configurations') }}" class="text-sm text-primary hover:underline">Manage</a>
            </div>
            
            {% if llmConfigs|length > 0 %}
                <div class="space-y-4">
                    {% for config in llmConfigs %}
                        <div class="flex items-center justify-between p-3 bg-slate-50 dark:bg-slate-900/30 rounded-lg">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-primary/10 dark:bg-primary/20 flex items-center justify-center">
                                    <i class="ph ph-cpu text-primary text-sm"></i>
                                </div>
                                <div>
                                    <div class="font-medium text-slate-900 dark:text-slate-100">{{ config.provider }}:{{ config.model }}</div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400">
                                        {% if config.isDefault %}
                                            <span class="text-amber-600 dark:text-amber-400">Default</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                {% if config.isConfigured %}
                                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                    <span class="text-xs text-emerald-600 dark:text-emerald-400">Configured</span>
                                {% else %}
                                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                    <span class="text-xs text-amber-600 dark:text-amber-400">Needs Config</span>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-8 text-slate-500 dark:text-slate-400">
                    <i class="ph ph-cpu text-4xl mb-2"></i>
                    <p>No LLM configurations found</p>
                    <a href="{{ path('agent_llm_configurations') }}" class="text-primary hover:underline mt-2 inline-block">Set up LLM</a>
                </div>
            {% endif %}
        </div>

        {# Right Column - Capabilities #}
        <div class="glass-panel">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Capabilities</h2>
                <a href="{{ path('agent_capabilities') }}" class="text-sm text-primary hover:underline">Manage</a>
            </div>
            
            {% if capabilities|length > 0 %}
                <div class="space-y-3">
                    {% for capability in capabilities %}
                        <div class="flex items-center justify-between p-3 bg-slate-50 dark:bg-slate-900/30 rounded-lg">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-secondary/10 dark:bg-secondary/20 flex items-center justify-center">
                                    <i class="ph ph-puzzle-piece text-secondary text-sm"></i>
                                </div>
                                <div>
                                    <div class="font-medium text-slate-900 dark:text-slate-100">{{ capability.name }}</div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400">{{ capability.identifier }}</div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                {% if capability.isReady %}
                                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                    <span class="text-xs text-emerald-600 dark:text-emerald-400">Ready</span>
                                {% elseif capability.isInstalled %}
                                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                    <span class="text-xs text-amber-600 dark:text-amber-400">Installed</span>
                                {% else %}
                                    <span class="w-2 h-2 rounded-full bg-slate-400"></span>
                                    <span class="text-xs text-slate-500 dark:text-slate-400">Not Installed</span>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-8 text-slate-500 dark:text-slate-400">
                    <i class="ph ph-puzzle-piece text-4xl mb-2"></i>
                    <p>No capabilities found</p>
                    <a href="{{ path('agent_capabilities') }}" class="text-primary hover:underline mt-2 inline-block">Install capabilities</a>
                </div>
            {% endif %}
        </div>
    </div>

    {# Recent Conversations #}
    <div class="glass-panel mt-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Recent Conversations</h2>
            <a href="{{ path('agent_conversations') }}" class="text-sm text-primary hover:underline">View all</a>
        </div>
        
        {% if conversations|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for conversation in conversations %}
                    <a href="{{ path('agent_conversation_view', {'id': conversation.id}) }}" class="block p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-colors group">
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="font-medium text-slate-900 dark:text-slate-100 group-hover:text-primary transition-colors">{{ conversation.title }}</h3>
                            <span class="text-xs text-slate-500 dark:text-slate-400">{{ conversation.updatedAt|date('M d') }}</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                            <span class="flex items-center gap-1">
                                <i class="ph ph-chat-circle-dots text-xs"></i>
                                {{ conversation.messageCount }} messages
                            </span>
                            <span class="flex items-center gap-1">
                                <i class="ph ph-hash text-xs"></i>
                                {{ conversation.tokenCount }} tokens
                            </span>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-8 text-slate-500 dark:text-slate-400">
                <i class="ph ph-chats-circle text-4xl mb-2"></i>
                <p>No conversations found</p>
                <a href="{{ path('agent_conversation_new') }}" class="text-primary hover:underline mt-2 inline-block">Start a new conversation</a>
            </div>
        {% endif %}
    </div>

    {# Recent Executions #}
    <div class="glass-panel mt-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Recent Executions</h2>
            <a href="{{ path('agent_executions') }}" class="text-sm text-primary hover:underline">View all</a>
        </div>
        
        {% if executions|length > 0 %}
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="text-left text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-700">
                        <tr>
                            <th class="pb-2 pr-4">ID</th>
                            <th class="pb-2 pr-4">Agent</th>
                            <th class="pb-2 pr-4">Status</th>
                            <th class="pb-2 pr-4">Duration</th>
                            <th class="pb-2">Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for execution in executions %}
                            <tr class="border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-900/50">
                                <td class="py-2 pr-4">
                                    <code class="text-xs">{{ execution.id|slice(0, 8) }}</code>
                                </td>
                                <td class="py-2 pr-4 font-medium text-slate-900 dark:text-slate-100">
                                    {{ execution.agent }}
                                </td>
                                <td class="py-2 pr-4">
                                    <span class="px-2 py-1 rounded-full text-xs font-medium {% if execution.status == 'completed' %}bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300{% elseif execution.status == 'failed' %}bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300{% elseif execution.status == 'running' %}bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300{% else %}bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300{% endif %}">
                                        {{ execution.status }}
                                    </span>
                                </td>
                                <td class="py-2 pr-4">
                                    {% if execution.duration %}
                                        {{ execution.duration }}s
                                    {% else %}
                                        <span class="text-slate-400 dark:text-slate-500">-</span>
                                    {% endif %}
                                </td>
                                <td class="py-2 text-slate-500 dark:text-slate-400">
                                    {{ execution.createdAt|date('M d, H:i') }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="text-center py-8 text-slate-500 dark:text-slate-400">
                <i class="ph ph-robot text-4xl mb-2"></i>
                <p>No recent executions found</p>
                <a href="{{ path('agent_conversation_new') }}" class="text-primary hover:underline mt-2 inline-block">Start a conversation</a>
            </div>
        {% endif %}
    </div>

    {# Quick Actions #}
    <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="{{ path('agent_conversation_new') }}" class="glass-panel p-4 text-center hover:scale-[1.02] transition-transform group">
            <i class="ph ph-chat-circle-dots text-3xl text-primary mb-2"></i>
            <div class="font-medium text-slate-900 dark:text-slate-100 group-hover:text-primary transition-colors">New Chat</div>
        </a>
        <a href="{{ path('agent_llm_configurations') }}" class="glass-panel p-4 text-center hover:scale-[1.02] transition-transform group">
            <i class="ph ph-cpu text-3xl text-secondary mb-2"></i>
            <div class="font-medium text-slate-900 dark:text-slate-100 group-hover:text-secondary transition-colors">LLM Settings</div>
        </a>
        <a href="{{ path('agent_capabilities') }}" class="glass-panel p-4 text-center hover:scale-[1.02] transition-transform group">
            <i class="ph ph-puzzle-piece text-3xl text-accent mb-2"></i>
            <div class="font-medium text-slate-900 dark:text-slate-100 group-hover:text-accent transition-colors">Capabilities</div>
        </a>
        <a href="{{ path('agent_executions') }}" class="glass-panel p-4 text-center hover:scale-[1.02] transition-transform group">
            <i class="ph ph-clipboard text-3xl text-slate-600 dark:text-slate-400 mb-2"></i>
            <div class="font-medium text-slate-900 dark:text-slate-100 group-hover:text-slate-600 dark:group-hover:text-slate-400 transition-colors">Executions</div>
        </a>
    </div>
</div>

{% block javascripts %}
<script>
    // Additional JavaScript for the dashboard
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize any additional components
    });
</script>
{% endblock %}
{% endblock %}
