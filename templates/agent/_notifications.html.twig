{# templates/agent/_notifications.html.twig #}
{% if app.session.flashBag.has('pending_tools') %}
<div class="evie-notifications" data-controller="evie-notifications">
    <div class="evie-notification-toast" data-evie-notifications-target="toast">
        {% for tool in app.session.flashBag.get('pending_tools') %}
            <div class="evie-notification evie-notification-pending" 
                 data-tool-id="{{ tool.id }}" 
                 data-tool-name="{{ tool.name }}">
                <div class="evie-notification-header">
                    <span class="evie-notification-icon">🤖</span>
                    <h4 class="evie-notification-title">Neues Tool wartet auf Freigabe</h4>
                </div>
                <div class="evie-notification-body">
                    <div class="evie-notification-message">
                        <p><strong>{{ tool.name }}</strong></p>
                        <p>{{ tool.description|slice(0, 100) }}...</p>
                    </div>
                </div>
                <div class="evie-notification-actions">
                    <button class="btn btn-success btn-sm" 
                            data-action="evie-notifications#approveTool"
                            data-tool-id="{{ tool.id }}">
                        <i class="ph ph-check"></i> Freigeben
                    </button>
                    <button class="btn btn-danger btn-sm" 
                            data-action="evie-notifications#rejectTool"
                            data-tool-id="{{ tool.id }}">
                        <i class="ph ph-x"></i> Ablehnen
                    </button>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endif %}

{# CSS für Benachrichtigungen (design-system-konform) #}
<style>
    .evie-notifications {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 10000;
        max-width: 400px;
    }

    .evie-notification-toast {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .evie-notification {
        background-color: var(--color-surface);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card-hover);
        padding: 16px;
        border-left: 4px solid var(--color-warning);
        animation: slideIn 0.3s ease-out;
        border-top: 1px solid var(--color-border);
        border-right: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
    }

    .evie-notification-pending {
        border-left-color: var(--color-warning);
    }

    .evie-notification-approved {
        border-left-color: var(--color-success);
    }

    .evie-notification-rejected {
        border-left-color: var(--color-danger);
    }

    .evie-notification-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }

    .evie-notification-icon {
        font-size: 20px;
        line-height: 1;
    }

    .evie-notification-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: var(--color-content);
    }

    .evie-notification-body {
        margin-bottom: 15px;
        font-size: 0.875rem;
        color: var(--color-content-muted);
    }

    .evie-notification-body p {
        margin: 5px 0;
    }

    .evie-notification-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    .btn-sm {
        padding: 0.375rem 0.75rem;
        font-size: 0.75rem;
    }

    @keyframes slideIn {
        from {
            transform: translateX(100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    /* Animation für ausblenden */
    .evie-notification.fade-out {
        animation: slideOut 0.3s ease-in forwards;
    }

    @keyframes slideOut {
        from {
            transform: translateX(0);
            opacity: 1;
        }
        to {
            transform: translateX(100%);
            opacity: 0;
        }
    }
</style>