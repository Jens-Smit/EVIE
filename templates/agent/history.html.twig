{% extends 'base.html.twig' %}

{% block title %}EVIE - Verlauf{% endblock %}

{% block body %}
    <div class="bg-white rounded-lg shadow p-6">
        <h1 class="text-2xl font-bold text-secondary mb-4">Agenten-Verlauf</h1>
        <p class="text-gray-700 mb-6">Hier siehst du die letzten Interaktionen mit dem EVIE-Agenten.</p>

        {% if history is defined and history|length > 0 %}
            <div class="max-h-[600px] overflow-y-auto border border-gray-300 rounded-lg p-4 mb-6 bg-white">
                {% for entry in history %}
                    <div class="mb-4">
                        <div class="text-center text-sm text-gray-500 mb-2">
                            <strong>{{ entry.timestamp|date('d.m.Y H:i') }}</strong>
                        </div>
                        {% for message in entry.messages %}
                            <div class="mb-2 max-w-[80%] {% if message.role == 'user' %}ml-auto text-right{% else %}mr-auto{% endif %}">
                                <div class="inline-block p-3 rounded-lg 
                                    {% if message.role == 'user' %}bg-primary text-white
                                    {% elseif message.role == 'agent' %}bg-gray-200 text-gray-800
                                    {% else %}bg-accent text-white text-center{% endif %}
                                ">
                                    {{ message.content }}
                                </div>
                            </div>
                        {% endfor %}
                        <hr class="my-4 border-gray-300">
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded-lg mb-6">
                Noch keine Einträge im Verlauf.
            </div>
        {% endif %}

        <div class="mt-6">
            <a href="{{ path('frontend_agent_dialog') }}" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-secondary transition">
                Neue Konversation starten
            </a>
        </div>
    </div>
{% endblock %}
