{# templates/agent/history.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}EVIE – Agenten-Verlauf{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-content">Agenten-Verlauf</h1>
        <a href="{{ path('frontend_agent_dialog') }}" class="btn btn-primary">
            <i class="ph ph-plus"></i>
            Neue Konversation
        </a>
    </div>

    <div class="card p-6">
        {% if history is defined and history|length > 0 %}
            <div class="space-y-6">
                {% for entry in history %}
                    <div class="border border-border rounded-xl overflow-hidden">
                        <div class="bg-surface-muted px-4 py-2 border-b border-border flex items-center justify-between">
                            <span class="text-sm font-medium text-content-muted">
                                {{ entry.timestamp|date('d.m.Y H:i:s') }}
                            </span>
                            <a href="{{ path('frontend_agent_history_continue', {'id': entry.id}) }}" 
                               class="btn btn-ghost btn-sm text-primary"
                               title="Konversation fortsetzen">
                                <i class="ph ph-chat-circle-dots"></i>
                                Fortsetzen
                            </a>
                        </div>
                        <div class="p-4 space-y-3">
                            {% for message in entry.messages %}
                                {% if message.role == 'user' %}
                                    <div class="flex justify-end">
                                        <div class="chat-bubble-user rounded-xl px-4 py-2 max-w-[75%]">
                                            {{ message.content }}
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="flex justify-start">
                                        <div class="chat-bubble-agent rounded-xl px-4 py-2 max-w-[75%]">
                                            {{ message.content }}
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-12">
                <i class="ph ph-chat-circle-dots text-5xl text-content-muted mb-4"></i>
                <h2 class="text-xl font-semibold text-content mb-2">Noch keine Einträge im Verlauf</h2>
                <p class="text-content-muted mb-6">Starte eine Konversation, um den Verlauf zu füllen.</p>
                <a href="{{ path('frontend_agent_dialog') }}" class="btn btn-primary">
                    <i class="ph ph-chat-circle-dots"></i>
                    Neue Konversation starten
                </a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
