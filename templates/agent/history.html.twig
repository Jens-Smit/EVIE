{% extends 'base.html.twig' %}

{% block title %}EVIE - Verlauf{% endblock %}

{% block body %}
<div class="container">
    <div class="card">
        <h1 class="card-title">Agenten-Verlauf</h1>
        <p>Hier siehst du die letzten Interaktionen mit dem EVIE-Agenten.</p>

        {% if history is defined and history|length > 0 %}
            <div class="chat-container">
                {% for entry in history %}
                    <div class="message system mb-2">
                        <strong>{{ entry.timestamp|date('d.m.Y H:i') }}</strong>
                    </div>
                    {% for message in entry.messages %}
                        <div class="message {{ message.role }}">
                            {{ message.content }}
                        </div>
                    {% endfor %}
                    <hr class="mb-2 mt-2">
                {% endfor %}
            </div>
        {% else %}
            <div class="alert alert-info">
                Noch keine Einträge im Verlauf.
            </div>
        {% endif %}

        <div class="mt-3">
            <a href="{{ path('agent_dialog') }}" class="btn">Neue Konversation starten</a>
        </div>
    </div>
</div>
{% endblock %}
