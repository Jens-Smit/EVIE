{# templates/strategy/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Strategie-Review - EVIE{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl md:text-3xl font-bold text-content flex items-center gap-3">
            <i class="ph ph-chart-line-up text-primary"></i>
            Strategie-Review
        </h1>
        <a href="{{ path('app_settings') }}" class="btn btn-ghost">
            <i class="ph ph-caret-left"></i>
            Zurück
        </a>
    </div>

    <div class="card">
        <div class="flex items-center gap-2 mb-4">
            <i class="ph ph-info text-primary text-xl"></i>
            <h2 class="card-title">Hinweis</h2>
        </div>
        <p class="text-content-muted text-sm">
            Hier sehen Sie die Ergebnisse der Evaluation Ihrer autonomen Agent-Ziele. 
            Basierend auf den Ausführungsergebnissen werden Anpassungsvorschläge generiert, 
            die Sie per HITL (Human-in-the-Loop) genehmigen können.
        </p>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="rounded-xl px-4 py-3 border flex items-center gap-2
                        {% if label == 'success' %}bg-success-soft border-success/20 text-success
                        {% else %}bg-danger-soft border-danger/20 text-danger{% endif %}">
                <i class="ph {% if label == 'success' %}ph-check-circle{% else %}ph-warning-circle{% endif %} text-lg"></i>
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Zusammenfassung -->
    <div class="card">
        <div class="flex items-center gap-2 mb-4">
            <i class="ph ph-chart-pie text-primary text-xl"></i>
            <h2 class="card-title">Zusammenfassung</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-surface-muted rounded-xl p-4 border border-border">
                <p class="text-sm text-content-muted mb-1">Anpassungsvorschläge</p>
                <p class="text-3xl font-bold text-content">{{ suggestions|length }}</p>
            </div>
            <div class="bg-surface-muted rounded-xl p-4 border border-border">
                <p class="text-sm text-content-muted mb-1">Durchschnittliche Erfolgsquote</p>
                <p class="text-3xl font-bold text-content">{{ summary|split('Erfolgsquote: ')|last|split('%')|first }}%</p>
            </div>
            <div class="bg-surface-muted rounded-xl p-4 border border-border">
                <p class="text-sm text-content-muted mb-1">Evaluationshistorie</p>
                <p class="text-3xl font-bold text-content">{{ evaluations|length }}</p>
            </div>
        </div>
        <p class="text-sm text-content-muted mt-4">{{ summary }}</p>
    </div>

    <!-- Anpassungsvorschläge -->
    <div class="card">
        <div class="flex items-center gap-2 mb-4">
            <i class="ph ph-lightbulb text-primary text-xl"></i>
            <h2 class="card-title">Anpassungsvorschläge</h2>
        </div>

        {% if suggestions|length > 0 %}
            <div class="space-y-4">
                {% for suggestion in suggestions %}
                    <div class="bg-surface-muted rounded-xl p-4 border border-border">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex-1">
                                <div class="flex items-center gap-2 mb-2">
                                    <span class="badge 
                                          {% if suggestion.priority == 'high' %}badge-danger
                                          {% elseif suggestion.priority == 'medium' %}badge-warning
                                          {% else %}badge-approved{% endif %}">
                                        {{ suggestion.priority|upper }}
                                    </span>
                                    <h3 class="font-semibold text-content">{{ suggestion.title }}</h3>
                                </div>
                                <p class="text-sm text-content-muted mb-3">{{ suggestion.description }}</p>
                            </div>
                            <div class="flex gap-2">
                                {% if suggestion.action starts with '/agent/goals' %}
                                    <form method="post" action="{{ path('app_strategy_suggestion_apply', {'id': suggestion.goal_id}) }}">
                                        <button type="submit" class="btn btn-primary btn-sm">
                                            <i class="ph ph-check"></i>
                                            Anwenden
                                        </button>
                                    </form>
                                {% endif %}
                                <a href="{{ suggestion.action }}" class="btn btn-ghost btn-sm">
                                    <i class="ph ph-eye"></i>
                                    Anzeigen
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-8 text-content-muted">
                <i class="ph ph-check-circle text-4xl mb-2"></i>
                <p>Keine Anpassungsvorschläge vorhanden.</p>
                <p class="text-sm mt-1">Ihre Strategie ist aktuell optimal eingestellt.</p>
            </div>
        {% endif %}
    </div>

    <!-- Evaluationshistorie -->
    <div class="card">
        <div class="flex items-center gap-2 mb-4">
            <i class="ph ph-clock-counter-clockwise text-primary text-xl"></i>
            <h2 class="card-title">Evaluationshistorie</h2>
        </div>

        {% if evaluations|length > 0 %}
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-border text-left">
                            <th class="pb-3 text-sm font-medium text-content">Ziel</th>
                            <th class="pb-3 text-sm font-medium text-content">Ergebnis</th>
                            <th class="pb-3 text-sm font-medium text-content">Score</th>
                            <th class="pb-3 text-sm font-medium text-content">Feedback</th>
                            <th class="pb-3 text-sm font-medium text-content">Datum</th>
                            <th class="pb-3 text-sm font-medium text-content">Aktionen</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        {% for evaluation in evaluations|slice(0, 10) %}
                            <tr>
                                <td class="py-3 text-content">
                                    {{ evaluation.goal.title }}
                                </td>
                                <td class="py-3">
                                    {% if evaluation.success %}
                                        <span class="badge badge-approved">Erfolgreich</span>
                                    {% else %}
                                        <span class="badge badge-danger">Fehlgeschlagen</span>
                                    {% endif %}
                                </td>
                                <td class="py-3 text-sm text-content-muted">
                                    {% if evaluation.score %}
                                        {{ "%.2f"|format(evaluation.score) }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td class="py-3 text-sm text-content-muted truncate max-w-xs">
                                    {{ evaluation.feedback|slice(0, 50) }}
                                </td>
                                <td class="py-3 text-sm text-content-muted">
                                    {{ evaluation.createdAt|date('Y-m-d H:i') }}
                                </td>
                                <td class="py-3">
                                    <a href="{{ path('app_strategy_evaluation_detail', {'id': evaluation.id}) }}" 
                                       class="btn btn-ghost btn-sm">
                                        <i class="ph ph-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if evaluations|length > 10 %}
                <p class="text-sm text-content-muted mt-4">
                    Zeige 10 von {{ evaluations|length }} Evaluationen
                </p>
            {% endif %}
        {% else %}
            <div class="text-center py-8 text-content-muted">
                <i class="ph ph-file-text text-4xl mb-2"></i>
                <p>Keine Evaluationen vorhanden.</p>
                <p class="text-sm mt-1">Führen Sie autonome Ziele aus, um Evaluationen zu erhalten.</p>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
