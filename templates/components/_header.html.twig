<header class="h-14 md:h-16 glass-panel flex items-center justify-between
        px-4 md:px-6 shrink-0 relative z-20
        border-b border-border
        rounded-none border-x-0 border-t-0">
    
    <div class="flex items-center gap-3">
        {# Mobile Menu Button #}
        <button onclick="toggleSidebar()"
                class="md:hidden text-content-muted
                       hover:text-content p-2 -ml-2
                       rounded-lg bg-transparent hover:bg-surface-elevated
                       transition-colors">
            <i class="ph ph-list text-2xl"></i>
        </button>
        
        {# Search Bar (Desktop) #}
        <div class="hidden sm:flex items-center bg-surface
                    rounded-full px-4 py-1.5 border border-border
                    shadow-card">
            <i class="ph ph-magnifying-glass text-content-muted mr-2"></i>
            <input type="text"
                   placeholder="Suche in Dateien, Chats..."
                   class="bg-transparent border-none outline-none text-sm w-48 md:w-64
                          placeholder-content-subtle
                          text-content focus:ring-0">
            <span class="text-[10px] text-content-subtle border
                         border-border px-1.5 py-0.5 rounded ml-2
                         hidden md:inline-block">⌘K</span>
        </div>
        
        {# Mobile Search Icon #}
        <button class="sm:hidden text-content-muted
                       hover:text-content p-2 rounded-lg">
            <i class="ph ph-magnifying-glass text-xl"></i>
        </button>
    </div>
    
    <div class="flex items-center gap-2 md:gap-4">
        {# Theme Toggle #}
        <button onclick="toggleTheme()"
                class="text-content-muted hover:text-content
                       transition-colors p-2 rounded-lg hover:bg-surface-elevated"
                title="Theme wechseln">
            <i id="theme-icon" class="ph ph-sun text-xl"></i>
        </button>
        
        {# System Status #}
        <div class="flex items-center gap-2 text-[10px] md:text-sm
                    px-2 md:px-3 py-1 md:py-1.5
                    bg-success-soft
                    text-success
                    rounded-full border border-success/20">
            <div class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-success animate-pulse"></div>
            <span class="hidden sm:inline">Systeme </span>Online
        </div>
        
        {# Notifications #}
        <button class="relative text-content-muted
                       hover:text-content transition-colors p-1">
            <i class="ph ph-bell text-xl"></i>
            <span class="absolute top-0 right-1 w-2 h-2 bg-danger rounded-full
                         border-2 border-white dark:border-surface"></span>
        </button>
    </div>
</header>