<header class="h-14 md:h-16 glass-panel flex items-center justify-between px-4 md:px-6 shrink-0 relative z-20 border-b border-slate-200 dark:border-slate-700/50 rounded-none border-x-0 border-t-0">
    <div class="flex items-center gap-3">
        <button onclick="toggleSidebar()" class="md:hidden text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white p-2 -ml-2 rounded-lg bg-transparent hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors">
            <i class="ph ph-list text-2xl"></i>
        </button>
        <div class="hidden sm:flex items-center bg-white dark:bg-slate-950/50 rounded-full px-4 py-1.5 border border-slate-200 dark:border-slate-700/50 shadow-sm dark:shadow-none">
            <i class="ph ph-magnifying-glass text-slate-400 mr-2"></i>
            <input type="text" placeholder="Suche in Dateien, Chats..." class="bg-transparent border-none outline-none text-sm w-48 md:w-64 placeholder-slate-400 dark:placeholder-slate-500 text-slate-900 dark:text-white focus:ring-0">
            <span class="text-[10px] text-slate-400 dark:text-slate-500 border border-slate-200 dark:border-slate-700 px-1.5 py-0.5 rounded ml-2 hidden md:inline-block">⌘K</span>
        </div>
        <!-- Mobile Search Icon -->
        <button class="sm:hidden text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white p-2 rounded-lg">
            <i class="ph ph-magnifying-glass text-xl"></i>
        </button>
    </div>
    
    <div class="flex items-center gap-2 md:gap-4">
        <!-- Theme Toggle -->
        <button onclick="toggleTheme()" class="text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors p-2 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800" title="Theme wechseln">
            <i id="theme-icon" class="ph ph-sun text-xl"></i>
        </button>
        
        <div class="flex items-center gap-2 text-[10px] md:text-sm px-2 md:px-3 py-1 md:py-1.5 bg-emerald-100 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 rounded-full border border-emerald-200 dark:border-emerald-500/20">
            <div class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-emerald-500 animate-pulse"></div>
            <span class="hidden sm:inline">Systeme </span>Online
        </div>
        <button class="relative text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors p-1">
            <i class="ph ph-bell text-xl"></i>
            <span class="absolute top-0 right-1 w-2 h-2 bg-red-500 rounded-full border-2 border-white dark:border-slate-900"></span>
        </button>
    </div>
</header>
