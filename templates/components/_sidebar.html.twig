<aside id="sidebar"
       class="fixed md:relative inset-y-0 left-0 z-50 w-72 md:w-64
              transform -translate-x-full md:translate-x-0 transition-transform
              duration-300 ease-in-out glass-panel flex flex-col justify-between
              shadow-card md:shadow-none bg-surface/95 dark:bg-surface/95
              md:bg-transparent dark:md:bg-transparent">
    <div class="overflow-y-auto overflow-x-hidden flex-1 no-scrollbar">

        {# Logo & Header #}
        <div class="p-5 md:p-6 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-secondary
                            flex items-center justify-center shadow-button shadow-primary/30 shrink-0">
                    <i class="ph ph-brain text-white text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-content tracking-wide">EVIE</h1>
                    <p class="text-xs text-content-muted">Dein digitaler Mitarbeiter</p>
                </div>
            </div>

            {# Close Button (Mobile) #}
            <button onclick="toggleSidebar()"
                    class="md:hidden text-content-muted
                           hover:text-content p-2 rounded-lg
                           bg-surface-elevated">
                <i class="ph ph-x text-xl"></i>
            </button>
        </div>

        {# Navigation Menu #}
        <nav class="mt-2 px-3 md:px-4 space-y-1.5" id="nav-menu">
            {# ================================================== #}
            {# EVIE – Benutzer-Ebene (Workflow des Kunden)        #}
            {# ================================================== #}
            <p class="px-4 pt-3 pb-1 text-[10px] font-bold uppercase tracking-wider text-content-subtle">
                EVIE
            </p>

            {# Dashboard #}
            <a href="{{ path('app_dashboard') }}"
               class="nav-btn {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% else %}inactive{% endif %}
                      border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                      transition-all active:scale-95 font-medium">
                <i class="ph ph-squares-four text-xl"></i>
                <span>Übersicht</span>
            </a>

            {# Agent Chat – Aufgabe stellen #}
            <a href="{{ path('frontend_agent_dialog') }}"
               class="nav-btn {% if app.request.attributes.get('_route') == 'frontend_agent_dialog' %}active{% else %}inactive{% endif %}
                      border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                      transition-all active:scale-95 font-medium">
                <i class="ph ph-chats-teardrop text-xl"></i>
                <span>Agent Chat</span>
                {% if pending_messages is defined and pending_messages > 0 %}
                    <span class="ml-auto bg-primary-soft text-primary text-[10px] font-bold
                             px-2 py-0.5 rounded-full">{{ pending_messages }}</span>
                {% endif %}
            </a>

            {# Zentrale Freigabe-Inbox (Tools + Entscheidungen) #}
            <a href="{{ path('app_approvals') }}"
               class="nav-btn {% if app.request.attributes.get('_route') in ['app_approvals', 'app_tool_pending_list', 'app_tool_pending_show', 'app_decisions'] %}active{% else %}inactive{% endif %}
                      border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                      transition-all active:scale-95 font-medium">
                <i class="ph ph-check-square-offset text-xl"></i>
                <span>Freigaben</span>
                <span id="sidebar-pending-count"
                      data-initial="{{ pending_approval_count|default(0) }}"
                      class="ml-auto bg-warning-soft text-warning text-[10px] font-bold px-2 py-0.5 rounded-full">
                    {{ pending_approval_count|default(0) }}
                </span>
            </a>

            {# Dokumente #}
            <a href="{{ path('app_documents') }}"
               class="nav-btn {% if app.request.attributes.get('_route') == 'app_documents' %}active{% else %}inactive{% endif %}
                      border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                      transition-all active:scale-95 font-medium">
                <i class="ph ph-folders text-xl"></i>
                <span>Dokumente</span>
            </a>

            {# Automatisierungen (Agent Goals in Benutzersprache) #}
            <a href="{{ path('app_agent_goals') }}"
               class="nav-btn {% if app.request.attributes.get('_route') starts with 'app_agent_goals' %}active{% else %}inactive{% endif %}
                      border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                      transition-all active:scale-95 font-medium">
                <i class="ph ph-lightning text-xl"></i>
                <span>Automatisierungen</span>
            </a>

            {# Verlauf #}
            <a href="{{ path('frontend_agent_history') }}"
               class="nav-btn {% if app.request.attributes.get('_route') == 'frontend_agent_history' %}active{% else %}inactive{% endif %}
                      border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                      transition-all active:scale-95 font-medium">
                <i class="ph ph-clock-counter-clockwise text-xl"></i>
                <span>Verlauf</span>
            </a>

            {# ================================================== #}
            {# Administration – nur fuer Administrator/Entwickler #}
            {# ================================================== #}
            {% if is_granted('ROLE_ORG_ADMIN') %}
                <p class="px-4 pt-4 pb-1 text-[10px] font-bold uppercase tracking-wider text-content-subtle">
                    Administration
                </p>

                {# Integrationen (MCP-Server in Benutzersprache) #}
                <a href="{{ path('mcp_servers_list') }}"
                   class="nav-btn {% if app.request.attributes.get('_route') starts with 'mcp_' %}active{% else %}inactive{% endif %}
                          border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                          transition-all active:scale-95 font-medium">
                    <i class="ph ph-plugs-connected text-xl"></i>
                    <span>Integrationen</span>
                </a>
                {# Externe Ziele (Outbound-Allowlist in Benutzersprache) #}
                {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_settings_outbound_allowlist') }}"
                   class="nav-btn {% if app.request.attributes.get('_route') starts with 'app_settings_outbound_allowlist' %}active{% else %}inactive{% endif %}
                          border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                          transition-all active:scale-95 font-medium">
                    <i class="ph ph-shield-star text-xl"></i>
                    <span>Externe Ziele</span>
                </a>
                {% endif %}

                {# Fähigkeiten (Tools in Benutzersprache) #}
                <a href="{{ path('app_tools_list') }}"
                   class="nav-btn {% if app.request.attributes.get('_route') == 'app_tools_list' %}active{% else %}inactive{% endif %}
                          border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                          transition-all active:scale-95 font-medium">
                    <i class="ph ph-wrench text-xl"></i>
                    <span>Fähigkeiten</span>
                </a>

                {# Mitarbeiter / Aufgabenbereiche (Sub-Agenten) #}
                <a href="{{ path('app_subagents') }}"
                   class="nav-btn {% if app.request.attributes.get('_route') starts with 'app_subagents' %}active{% else %}inactive{% endif %}
                          border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                          transition-all active:scale-95 font-medium">
                    <i class="ph ph-users-three text-xl"></i>
                    <span>Mitarbeiter</span>
                </a>

                {# Briefing #}
                <a href="{{ path('app_briefing') }}"
                   class="nav-btn {% if app.request.attributes.get('_route') == 'app_briefing' %}active{% else %}inactive{% endif %}
                          border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                          transition-all active:scale-95 font-medium">
                    <i class="ph ph-chart-bar text-xl"></i>
                    <span>Briefing</span>
                </a>

                {# Strategie #}
                <a href="{{ path('app_strategy') }}"
                   class="nav-btn {% if app.request.attributes.get('_route') starts with 'app_strategy' %}active{% else %}inactive{% endif %}
                          border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                          transition-all active:scale-95 font-medium">
                    <i class="ph ph-chart-line-up text-xl"></i>
                    <span>Strategie</span>
                </a>

                {# Nutzung (Quota in Benutzersprache) #}
                <a href="{{ path('app_settings_quota') }}"
                   class="nav-btn {% if app.request.attributes.get('_route') == 'app_settings_quota' %}active{% else %}inactive{% endif %}
                          border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                          transition-all active:scale-95 font-medium">
                    <i class="ph ph-gauge text-xl"></i>
                    <span>Nutzung</span>
                </a>

                {# Sicherheitsprotokoll (Audit-Logs in Benutzersprache) #}
                <a href="{{ path('app_audit_logs') }}"
                   class="nav-btn {% if app.request.attributes.get('_route') starts with 'app_audit_log' %}active{% else %}inactive{% endif %}
                          border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                          transition-all active:scale-95 font-medium">
                    <i class="ph ph-shield-check text-xl"></i>
                    <span>Sicherheit</span>
                </a>

                {# Streaming-Sessions (diagnostisch, Admin-Ebene) #}
                <a href="{{ path('app_streaming_sessions') }}"
                   class="nav-btn {% if app.request.attributes.get('_route') starts with 'app_streaming' %}active{% else %}inactive{% endif %}
                          border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                          transition-all active:scale-95 font-medium">
                    <i class="ph ph-rainbow text-xl"></i>
                    <span>Streaming</span>
                </a>
            {% endif %}
        </nav>
    </div>

    {# Footer (Einstellungen, Profil, User) #}
    <div class="p-4 shrink-0 bg-surface-muted/50 dark:bg-surface-muted/50
                md:bg-transparent mt-auto border-t border-border">

        {# Einstellungen #}
        <a href="{{ path('app_settings') }}"
           class="nav-btn {% if app.request.attributes.get('_route') == 'app_settings' %}active{% else %}inactive{% endif %}
                  border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                  transition-all active:scale-95 font-medium">
            <i class="ph ph-gear text-xl"></i>
            <span>Einstellungen</span>
        </a>

        {# Zugangsdaten (Secrets in Benutzersprache) #}
        <a href="{{ path('app_settings_secrets') }}"
           class="nav-btn {% if app.request.attributes.get('_route') == 'app_settings_secrets' %}active{% else %}inactive{% endif %}
                  border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                  transition-all active:scale-95 font-medium">
            <i class="ph ph-lock-key text-xl"></i>
            <span>Zugangsdaten</span>
        </a>

        {# User Profile + Aktionen #}
        {% if app.user %}
        <div class="mt-2 border-t border-border">
            <a href="{{ path('app_profile') }}"
               class="nav-btn {% if app.request.attributes.get('_route') == 'app_profile' %}active{% else %}inactive{% endif %} border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                      transition-all active:scale-95 font-medium">
                <i class="ph ph-user-circle text-xl"></i>
                <div class="flex-1 min-w-0 text-left">
                    <p class="text-sm font-medium text-content truncate">
                        {{ app.user.fullName ?: app.user.userIdentifier }}
                    </p>
                    <p class="text-xs text-content-muted truncate">{{ app.user.email }}</p>
                </div>
            </a>
            <a href="{{ path('app_logout') }}"
               class="nav-btn inactive border w-full flex items-center gap-3 px-4 py-3 rounded-xl
                      transition-all active:scale-95 font-medium text-danger hover:text-danger">
                <i class="ph ph-sign-out text-xl"></i>
                <span>Abmelden</span>
            </a>
        </div>
        {% endif %}
    </div>
</aside>
