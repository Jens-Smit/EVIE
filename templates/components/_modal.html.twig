<div id="global-modal"
     class="fixed inset-0 bg-slate-900/60 z-[100] hidden items-center justify-center
            p-4 opacity-0 transition-opacity duration-300 backdrop-blur-sm">
    <div id="modal-container"
         class="bg-surface w-full max-w-2xl rounded-2xl
                shadow-modal border border-border
                transform scale-95 transition-transform duration-300
                flex flex-col max-h-[90vh]">
        
        <div class="p-4 md:p-5 border-b border-border
                    flex justify-between items-center shrink-0">
            <h3 id="modal-title"
                class="font-bold text-lg text-content
                       flex items-center gap-2">
                <i id="modal-icon" class="ph ph-file-text text-primary"></i>
                <span id="modal-title-text">Vorschau</span>
            </h3>
            <button onclick="closeModal()"
                    class="p-2 text-content-muted hover:text-content
                           bg-surface-elevated rounded-lg transition-colors">
                <i class="ph ph-x text-lg"></i>
            </button>
        </div>
        
        <div id="modal-body"
             class="p-4 md:p-6 overflow-y-auto text-sm text-content-muted
                    leading-relaxed font-mono md:font-sans">
        </div>
        
        <div class="p-4 border-t border-border
                    flex justify-end gap-3 shrink-0 bg-surface-muted
                    rounded-b-2xl">
            <button onclick="closeModal()"
                    class="btn btn-ghost">
                Schließen
            </button>
            <button onclick="closeModal(); showToast('Änderungen gespeichert', 'success')"
                    class="btn btn-primary">
                Aktion ausführen
            </button>
        </div>
    </div>
</div>