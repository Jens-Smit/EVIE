<div id="global-modal"
     class="fixed inset-0 bg-slate-900/60 z-[100] hidden items-center justify-center
            p-4 opacity-0 transition-opacity duration-300 backdrop-blur-sm">
    <div id="modal-container"
         class="bg-white dark:bg-slate-900 w-full max-w-2xl rounded-2xl
                shadow-2xl border border-slate-200 dark:border-slate-700
                transform scale-95 transition-transform duration-300
                flex flex-col max-h-[90vh]">
        
        <div class="p-4 md:p-5 border-b border-slate-200 dark:border-slate-700
                    flex justify-between items-center shrink-0">
            <h3 id="modal-title"
                class="font-bold text-lg text-slate-900 dark:text-white
                       flex items-center gap-2">
                <i id="modal-icon" class="ph ph-file-text text-primary"></i>
                <span id="modal-title-text">Vorschau</span>
            </h3>
            <button onclick="closeModal()"
                    class="p-2 text-slate-500 hover:text-slate-900 dark:hover:text-white
                           bg-slate-100 dark:bg-slate-800 rounded-lg transition-colors">
                <i class="ph ph-x text-lg"></i>
            </button>
        </div>
        
        <div id="modal-body"
             class="p-4 md:p-6 overflow-y-auto text-sm text-slate-700 dark:text-slate-300
                    leading-relaxed font-mono md:font-sans">
        </div>
        
        <div class="p-4 border-t border-slate-200 dark:border-slate-700
                    flex justify-end gap-3 shrink-0 bg-slate-50 dark:bg-slate-900/50
                    rounded-b-2xl">
            <button onclick="closeModal()"
                    class="px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-300
                           hover:text-slate-900 dark:hover:text-white transition-colors">
                Schließen
            </button>
            <button onclick="closeModal(); showToast('Änderungen gespeichert', 'success')"
                    class="px-5 py-2 text-sm font-medium bg-primary hover:bg-secondary
                           text-white rounded-lg transition-colors shadow-md shadow-primary/20">
                Aktion ausführen
            </button>
        </div>
    </div>
</div>
