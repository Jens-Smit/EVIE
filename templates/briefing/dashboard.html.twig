{# templates/briefing/dashboard.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}EVIE – Unternehmens-Dashboard{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto space-y-6">
    <h1 class="text-2xl md:text-3xl font-bold text-content">Unternehmens-Dashboard</h1>

    {# Tägliches Briefing #}
    <div class="card p-6">
        <h2 class="card-title flex items-center gap-2">
            <i class="ph ph-calendar text-primary"></i>
            Tägliches Briefing
        </h2>

        {# Abgeschlossene Aufgaben #}
        <div class="mb-6">
            <h3 class="font-semibold text-content mb-3 flex items-center gap-2">
                <i class="ph ph-check-circle text-success"></i>
                Abgeschlossene Aufgaben
            </h3>
            {% if dailyBriefing.sections.completed_tasks|length > 0 %}
                <div class="space-y-2">
                    {% for task in dailyBriefing.sections.completed_tasks %}
                        <div class="bg-surface-muted p-3 rounded-xl border-l-4 border-success">
                            <p class="font-medium text-content">{{ task.description }}</p>
                            <p class="text-sm text-content-muted">
                                Agent: {{ task.agent }} |
                                {{ task.executed_at }} |
                                Dauer: {{ task.duration }}
                            </p>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-content-muted">Keine abgeschlossenen Aufgaben heute.</p>
            {% endif %}
        </div>

        {# Ausstehende Entscheidungen #}
        <div class="mb-6">
            <h3 class="font-semibold text-content mb-3 flex items-center gap-2">
                <i class="ph ph-hourglass text-warning"></i>
                Ausstehende Entscheidungen
            </h3>
            {% if dailyBriefing.sections.pending_decisions|length > 0 %}
                <div class="space-y-2">
                    {% for decision in dailyBriefing.sections.pending_decisions %}
                        <div class="bg-warning-soft p-3 rounded-xl border-l-4 border-warning">
                            <p class="font-medium text-content">{{ decision.description }}</p>
                            <p class="text-sm text-content-muted">
                                Typ: {{ decision.type }} |
                                {{ decision.created_at }}
                            </p>
                            <div class="mt-2 flex gap-2">
                                <button class="btn btn-success btn-sm approve-decision"
                                        data-decision-id="{{ decision.id }}">
                                    <i class="ph ph-check"></i>
                                    Genehmigen
                                </button>
                                <button class="btn btn-danger btn-sm reject-decision"
                                        data-decision-id="{{ decision.id }}">
                                    <i class="ph ph-x"></i>
                                    Ablehnen
                                </button>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-content-muted">Keine ausstehenden Entscheidungen.</p>
            {% endif %}
        </div>

        {# Empfehlungen #}
        <div>
            <h3 class="font-semibold text-content mb-3 flex items-center gap-2">
                <i class="ph ph-lightbulb text-info"></i>
                Empfehlungen
            </h3>
            {% if dailyBriefing.sections.recommendations|length > 0 %}
                <div class="space-y-2">
                    {% for recommendation in dailyBriefing.sections.recommendations %}
                        <div class="bg-info-soft p-3 rounded-xl border-l-4 border-info">
                            <p class="font-medium text-content">{{ recommendation.description }}</p>
                            <p class="text-sm text-content-muted">Priorität: {{ recommendation.priority }}</p>
                            {% if recommendation.action %}
                                <a href="{{ recommendation.action }}" class="text-primary underline mt-1 inline-block">
                                    Zur Aktion
                                </a>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-content-muted">Keine Empfehlungen.</p>
            {% endif %}
        </div>
    </div>

    {# Wöchentliches Strategie-Briefing #}
    <div class="card p-6">
        <h2 class="card-title flex items-center gap-2">
            <i class="ph ph-chart-line text-primary"></i>
            Wöchentliches Strategie-Briefing
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {# Statistiken #}
            <div>
                <h3 class="font-semibold text-content mb-3 flex items-center gap-2">
                    <i class="ph ph-chart-bar text-info"></i>
                    Statistiken
                </h3>
                <canvas id="toolUsageChart" width="400" height="200"></canvas>
            </div>

            {# Strategische Analyse #}
            <div>
                <h3 class="font-semibold text-content mb-3 flex items-center gap-2">
                    <i class="ph ph-target text-primary"></i>
                    Strategische Analyse
                </h3>
                <div class="space-y-4">
                    <div>
                        <h4 class="font-medium text-content mb-2">Chancen:</h4>
                        <ul class="space-y-1 text-sm text-success">
                            {% for opportunity in weeklyBriefing.sections.strategic_analysis.opportunities %}
                                <li class="flex items-start gap-2">
                                    <i class="ph ph-arrow-up-right mt-0.5"></i>
                                    {{ opportunity }}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-medium text-content mb-2">Risiken:</h4>
                        <ul class="space-y-1 text-sm text-danger">
                            {% for risk in weeklyBriefing.sections.strategic_analysis.risks %}
                                <li class="flex items-start gap-2">
                                    <i class="ph ph-arrow-down-right mt-0.5"></i>
                                    {{ risk }}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        {# Anstehende Aufgaben #}
        <div class="mt-6">
            <h3 class="font-semibold text-content mb-3 flex items-center gap-2">
                <i class="ph ph-list-checks text-primary"></i>
                Anstehende Aufgaben
            </h3>
            {% if weeklyBriefing.sections.upcoming_tasks|length > 0 %}
                <div class="space-y-2">
                    {% for task in weeklyBriefing.sections.upcoming_tasks %}
                        <div class="bg-secondary-soft p-3 rounded-xl border-l-4 border-secondary">
                            <p class="font-medium text-content">{{ task.description }}</p>
                            <p class="text-sm text-content-muted">
                                Fällig: {{ task.due_date }} |
                                Priorität: {{ task.priority }}
                            </p>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-content-muted">Keine anstehenden Aufgaben.</p>
            {% endif %}
        </div>
    </div>

    {# Aktive Workflows #}
    <div class="card p-6">
        <h2 class="card-title flex items-center gap-2">
            <i class="ph ph-arrows-clockwise text-primary"></i>
            Aktive Workflows
        </h2>
        {% if dailyBriefing.sections.active_workflows|length > 0 %}
            <div class="space-y-4">
                {% for workflow in dailyBriefing.sections.active_workflows %}
                    <div class="bg-secondary-soft p-4 rounded-xl border-l-4 border-secondary">
                        <h3 class="font-bold text-content">{{ workflow.task }}</h3>
                        <p class="text-sm text-content-muted mt-1">Status: {{ workflow.status }}</p>
                        <div class="mt-2 bg-surface p-2 rounded-lg">
                            <div class="w-full bg-surface-elevated rounded-full h-2.5">
                                <div class="bg-secondary h-2.5 rounded-full"
                                     style="width: {{ workflow.progress }}%"></div>
                            </div>
                            <p class="text-xs text-content-muted mt-1">
                                Fortschritt: {{ workflow.progress }}% |
                                Geschätzte Dauer: {{ workflow.estimated_duration }} |
                                Risikostufe: {{ workflow.risk_level }}
                            </p>
                        </div>
                        <div class="mt-2">
                            <a href="#" class="text-secondary text-sm hover:underline">
                                Details anzeigen →
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-content-muted">Keine aktiven Workflows.</p>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
    // Initialisiere Charts
    document.addEventListener('DOMContentLoaded', function() {
        // Tool-Nutzungs-Chart
        const ctx = document.getElementById('toolUsageChart');
        if (ctx) {
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Genehmigt', 'Ausstehend', 'Abgelehnt'],
                    datasets: [{
                        label: 'Tools',
                        data: [
                            {{ dailyBriefing.sections.tool_statistics.approved_tools }},
                            {{ dailyBriefing.sections.tool_statistics.pending_tools }},
                            {{ dailyBriefing.sections.tool_statistics.rejected_tools }}
                        ],
                        backgroundColor: [
                            'rgba(16, 185, 129, 0.7)',
                            'rgba(245, 158, 11, 0.7)',
                            'rgba(239, 68, 68, 0.7)'
                        ],
                        borderColor: [
                            'rgba(16, 185, 129, 1)',
                            'rgba(245, 158, 11, 1)',
                            'rgba(239, 68, 68, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        // Entscheidung-Handler
        document.querySelectorAll('.approve-decision').forEach(button => {
            button.addEventListener('click', function() {
                const decisionId = this.getAttribute('data-decision-id');
                approveDecision(decisionId, this.closest('.bg-warning-soft'));
            });
        });

        document.querySelectorAll('.reject-decision').forEach(button => {
            button.addEventListener('click', function() {
                const decisionId = this.getAttribute('data-decision-id');
                rejectDecision(decisionId, this.closest('.bg-warning-soft'));
            });
        });
    });

    // Globale Funktionen für Entscheidungen
    function approveDecision(decisionId, container) {
        fetch(`/api/decisions/${decisionId}/approve`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json',
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.status === 'success') {
                showNotification('Entscheidung genehmigt!', 'success');
                if (container) container.remove();
            } else {
                showNotification('Fehler beim Genehmigen', 'error');
            }
        })
        .catch(error => {
            showNotification('Fehler: ' + error.message, 'error');
        });
    }

    function rejectDecision(decisionId, container) {
        const reason = prompt('Begründung für die Ablehnung:');
        if (!reason) return;

        fetch(`/api/decisions/${decisionId}/reject`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json',
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ reason: reason })
        })
        .then(response => response.json())
        .then(data => {
            if (data.status === 'success') {
                showNotification('Entscheidung abgelehnt', 'info');
                if (container) container.remove();
            } else {
                showNotification('Fehler beim Ablehnen', 'error');
            }
        })
        .catch(error => {
            showNotification('Fehler: ' + error.message, 'error');
        });
    }
    </script>
{% endblock %}