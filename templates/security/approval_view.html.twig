{# templates/security/approval_view.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Approval Request - EVIE Security{% endblock %}

{% block body %}
<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    {# Header #}
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Approval Request</h1>
            <p class="text-slate-600 dark:text-slate-400 mt-1">Review and approve/reject this action</p>
        </div>
    </div>

    {# Approval Details #}
    <div class="glass-panel p-8 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Request Information</h2>
                <div class="space-y-4">
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Approval ID</div>
                        <code class="text-slate-800 dark:text-slate-200">{{ approval.id }}</code>
                    </div>
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Status</div>
                        <span class="px-2 py-1 rounded-full text-xs font-medium {% if approval.status == 'pending' %}bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300{% elseif approval.status == 'approved' %}bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300{% elseif approval.status == 'rejected' %}bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300{% else %}bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300{% endif %}">
                            {{ approval.status|title }}
                        </span>
                    </div>
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Requested At</div>
                        <div class="text-slate-800 dark:text-slate-200">{{ approval.requestedAt|date('M d, Y H:i:s') }}</div>
                    </div>
                </div>
            </div>
            <div>
                <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">User Information</h2>
                <div class="space-y-4">
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">User</div>
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center">
                                <i class="ph ph-user text-slate-600 dark:text-slate-400 text-sm"></i>
                            </div>
                            <div>
                                <div class="font-medium text-slate-900 dark:text-slate-100">{{ approval.user.email }}</div>
                                <div class="text-xs text-slate-500 dark:text-slate-400">{{ approval.user.fullName ?? 'N/A' }}</div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Tenant</div>
                        <div class="text-slate-800 dark:text-slate-200">{{ approval.tenant.name }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Action Details #}
    <div class="glass-panel p-8 mb-6">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Action Details</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Action</div>
                <code class="text-slate-800 dark:text-slate-200">{{ approval.action }}</code>
            </div>
            <div>
                <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Resource</div>
                <code class="text-slate-800 dark:text-slate-200">{{ approval.resource }}</code>
            </div>
        </div>
        
        <div class="mt-6">
            <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Risk Level</div>
            <span class="px-3 py-1 rounded-full font-medium {% if approval.riskLevel == 'low' %}bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300{% elseif approval.riskLevel == 'medium' %}bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300{% elseif approval.riskLevel == 'high' %}bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300{% else %}bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300{% endif %}">
                {{ approval.riskLevel|title }}
            </span>
        </div>
    </div>

    {# Context #}
    {% if approval.context|length > 0 %}
        <div class="glass-panel p-8 mb-6">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Context</h2>
            <div class="p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg">
                <pre class="text-xs text-slate-700 dark:text-slate-300 overflow-x-auto">{{ approval.context|json_encode(4)|raw }}</pre>
            </div>
        </div>
    {% endif %}

    {# Actions #}
    {% if approval.status == 'pending' %}
        <div class="glass-panel p-8">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Actions</h2>
            <div class="flex justify-end gap-4">
                <form action="{{ path('security_approval_reject', {'id': approval.id}) }}" method="post" class="flex-1">
                    <div class="flex gap-2">
                        <input 
                            type="text" 
                            name="reason" 
                            placeholder="Reason for rejection (optional)"
                            class="flex-1 px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200 placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-red/50"
                        >
                        <button type="submit" class="px-6 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors">
                            <i class="ph ph-x-circle"></i>
                            Reject
                        </button>
                    </div>
                </form>
                <form action="{{ path('security_approval_approve', {'id': approval.id}) }}" method="post">
                    <button type="submit" class="px-6 py-2 bg-emerald-500 text-white rounded-lg hover:bg-emerald-600 transition-colors">
                        <i class="ph ph-check-circle"></i>
                        Approve
                    </button>
                </form>
            </div>
        </div>
    {% endif %}

    {# Back Link #}
    <div class="mt-6">
        <a href="{{ path('security_approvals') }}" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
            <i class="ph ph-arrow-left"></i>
            Back to Approvals
        </a>
    </div>
</div>

{% block javascripts %}
{% endblock %}
{% endblock %}
