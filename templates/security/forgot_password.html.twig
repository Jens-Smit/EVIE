{% extends 'auth_base.html.twig' %}

{% block title %}EVIE - Passwort vergessen{% endblock %}

{% block body %}
<div class="auth-card p-8">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-1">Passwort vergessen?</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
        Gib deine E-Mail-Adresse ein. Wir senden dir einen Link zum Zurücksetzen deines Passworts.
    </p>

    {% if app.session is not null %}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 flex items-center gap-2 px-4 py-3 rounded-xl text-sm border
                    {% if label == 'success' %}
                        bg-emerald-50 dark:bg-emerald-500/10 border-emerald-200 dark:border-emerald-500/20 text-emerald-700 dark:text-emerald-400
                    {% elseif label == 'error' %}
                        bg-red-50 dark:bg-red-500/10 border-red-200 dark:border-red-500/20 text-red-700 dark:text-red-400
                    {% else %}
                        bg-slate-100 dark:bg-slate-800 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300
                    {% endif %}">
                    <i class="ph {% if label == 'success' %}ph-check-circle{% elseif label == 'error' %}ph-warning-circle{% else %}ph-info{% endif %} text-lg"></i>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
        {% endfor %}
    {% endif %}

    {{ form_start(forgotPasswordForm, { attr: { class: 'space-y-4' } }) }}
    {{ form_row(forgotPasswordForm.email, {
        row_attr: { class: '' },
        label_attr: { class: 'auth-label' }
    }) }}
    {{ form_row(forgotPasswordForm.submit) }}
    {{ form_end(forgotPasswordForm) }}

    <div class="mt-6 text-center text-sm text-slate-600 dark:text-slate-400">
        <a href="{{ path('app_login') }}" class="text-primary font-medium hover:underline">
            <i class="ph ph-arrow-left"></i> Zurück zum Login
        </a>
    </div>
</div>
{% endblock %}
