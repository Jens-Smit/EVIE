{% extends 'auth_base.html.twig' %}

{% block title %}EVIE - Passwort vergessen{% endblock %}

{% block body %}
<div class="auth-card p-8">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-1">Passwort vergessen?</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
        Gib deine E-Mail-Adresse ein. Wir senden dir einen Link zum Zurücksetzen deines Passworts.
    </p>

    {{ form_start(forgotPasswordForm, { attr: { class: 'space-y-4' } }) }}
    {{ form_row(forgotPasswordForm.email, {
        row_attr: { class: '' },
        label_attr: { class: 'auth-label' }
    }) }}
    {{ form_row(forgotPasswordForm.submit) }}
    {{ form_end(forgotPasswordForm) }}

    <div class="mt-6 text-center text-sm text-slate-600 dark:text-slate-400">
        <a href="{{ path('app_login') }}" class="text-primary font-medium hover:underline">
            <i class="ph ph-arrow-left"></i> Zurück zum Login
        </a>
    </div>
</div>
{% endblock %}
