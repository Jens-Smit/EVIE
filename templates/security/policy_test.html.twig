{# templates/security/policy_test.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Test Policy - EVIE Security{% endblock %}

{% block body %}
<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6" x-data="{
    action: '{{ action }}',
    resource: '{{ resource }}',
    context: {{ context|json_encode|raw }},
    effect: '{{ effect }}',
    riskLevel: '{{ riskLevel }}',
    
    sampleActions: {{ sampleActions|json_encode|raw }},
    sampleResources: {{ sampleResources|json_encode|raw }},
    
    getEffectColor(effect) {
        const colors = {
            'allow': 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300',
            'deny': 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300',
            'ask': 'bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300'
        };
        return colors[effect] || 'bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300';
    },
    
    getRiskLevelColor(level) {
        const colors = {
            'low': 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300',
            'medium': 'bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300',
            'high': 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300',
            'critical': 'bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300'
        };
        return colors[level] || 'bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300';
    }
}">
    {# Header #}
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Test Policy</h1>
            <p class="text-slate-600 dark:text-slate-400 mt-1">Evaluate how policies affect actions and resources</p>
        </div>
    </div>

    {# Test Form #}
    <div class="glass-panel p-8 mb-6">
        <form method="post" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="action" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Action *</label>
                    <select id="action" name="action" x-model="action" class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50" required>
                        {% for action in sampleActions %}
                            <option value="{{ action }}" {% if action == action %}selected{% endif %}>{{ action }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label for="resource" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Resource *</label>
                    <select id="resource" name="resource" x-model="resource" class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/50" required>
                        {% for resource in sampleResources %}
                            <option value="{{ resource }}" {% if resource == resource %}selected{% endif %}>{{ resource }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Context (JSON)</label>
                <textarea 
                    name="context" 
                    rows="4"
                    placeholder='e.g., {"userId": "123", "userType": "admin"}'
                    class="w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200 placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-primary/50 resize-none"
                >{{ context|json_encode|raw }}</textarea>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Additional context for policy evaluation</p>
            </div>

            <div class="flex justify-end">
                <button type="submit" class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors">
                    <i class="ph ph-flask"></i>
                    Test Policy
                </button>
            </div>
        </form>
    </div>

    {# Test Results #}
    {% if effect %}
        <div class="glass-panel p-8">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-6">Test Results</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Action</h3>
                    <div class="p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg">
                        <code class="text-slate-800 dark:text-slate-200">{{ action }}</code>
                    </div>
                </div>
                <div>
                    <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Resource</h3>
                    <div class="p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg">
                        <code class="text-slate-800 dark:text-slate-200">{{ resource }}</code>
                    </div>
                </div>
            </div>

            <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Effect</h3>
                    <div class="p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg">
                        <span class="px-3 py-1 rounded-full font-medium {{ getEffectColor(effect) }}">
                            {{ effect|title }}
                        </span>
                    </div>
                </div>
                <div>
                    <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Risk Level</h3>
                    <div class="p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg">
                        <span class="px-3 py-1 rounded-full font-medium {{ getRiskLevelColor(riskLevel) }}">
                            {{ riskLevel|title }}
                        </span>
                    </div>
                </div>
            </div>

            {# Matching Policies #}
            {% if matchingPolicies|length > 0 %}
                <div class="mt-6">
                    <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Matching Policies ({{ matchingPolicies|length }})</h3>
                    <div class="space-y-3">
                        {% for policy in matchingPolicies %}
                            <div class="p-3 bg-slate-50 dark:bg-slate-900/30 rounded-lg border border-slate-200 dark:border-slate-700">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <div class="font-medium text-slate-900 dark:text-slate-100">{{ policy.name }}</div>
                                        <div class="text-xs text-slate-500 dark:text-slate-400">{{ policy.identifier }}</div>
                                    </div>
                                    <span class="px-2 py-1 rounded-full text-xs font-medium {{ getEffectColor(policy.effect) }}">
                                        {{ policy.effect|title }}
                                    </span>
                                </div>
                                <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                                    Priority: {{ policy.priority }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    {% endif %}

    {# Back Link #}
    <div class="mt-6">
        <a href="{{ path('security_policies') }}" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
            <i class="ph ph-arrow-left"></i>
            Back to Policies
        </a>
    </div>
</div>

{% block javascripts %}
{% endblock %}
{% endblock %}
