{% extends 'auth_base.html.twig' %}

{% block title %}EVIE - Login{% endblock %}

{% block body %}
<div class="auth-card p-8">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-1">Willkommen zurück</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">Melde dich bei deinem EVIE-Konto an.</p>

    {% if error %}
        <div class="mb-4 flex items-center gap-2 px-4 py-3 rounded-xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 text-red-700 dark:text-red-400 text-sm">
            <i class="ph ph-warning-circle text-lg"></i>
            <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
        </div>
    {% endif %}

    {% if app.user %}
        <div class="mb-4 text-sm text-slate-600 dark:text-slate-400">
            Du bist angemeldet als {{ app.user.userIdentifier }}.
            <a href="{{ path('app_logout') }}" class="text-primary font-medium">Abmelden</a>
        </div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <input type="hidden" name="_target_path" value="{{ path('app_home') }}">

        <div class="mb-4">
            <label class="auth-label" for="inputEmail">E-Mail-Adresse</label>
            <input type="email" id="inputEmail" name="email" value="{{ last_username }}" required autofocus
                   class="auth-input" autocomplete="email" placeholder="max@beispiel.de">
        </div>

        <div class="mb-4">
            <div class="flex items-center justify-between mb-1">
                <label class="auth-label mb-0" for="inputPassword">Passwort</label>
                <a href="{{ path('app_forgot_password') }}" class="text-xs text-primary font-medium hover:underline">Passwort vergessen?</a>
            </div>
            <input type="password" id="inputPassword" name="password" required
                   class="auth-input" autocomplete="current-password" placeholder="Dein Passwort">
        </div>

        <div class="flex items-center mb-6">
            <input type="checkbox" id="rememberMe" name="_remember_me" class="mr-2 rounded border-slate-300 dark:border-slate-600 text-primary focus:ring-primary" checked>
            <label for="rememberMe" class="text-sm text-slate-600 dark:text-slate-400">Angemeldet bleiben</label>
        </div>

        <button type="submit" class="btn btn-primary w-full">
            <i class="ph ph-sign-in"></i>
            Anmelden
        </button>
    </form>

    <div class="mt-6 text-center text-sm text-slate-600 dark:text-slate-400">
        Noch kein Konto?
        <a href="{{ path('app_register') }}" class="text-primary font-medium hover:underline">Jetzt registrieren</a>
    </div>
</div>
{% endblock %}
