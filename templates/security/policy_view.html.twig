{# templates/security/policy_view.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ policy.name }} - EVIE Security{% endblock %}

{% block body %}
<div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    {# Header #}
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">{{ policy.name }}</h1>
            <p class="text-slate-600 dark:text-slate-400 mt-1">Policy Details</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="{{ path('security_policy_edit', {'id': policy.id}) }}" class="px-4 py-2 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-800/50 transition-colors">
                <i class="ph ph-pencil"></i>
                Edit
            </a>
            {% if policy.isEnabled %}
                <a href="{{ path('security_policy_disable', {'id': policy.id}) }}" class="px-4 py-2 bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-lg hover:bg-amber-200 dark:hover:bg-amber-800/50 transition-colors" onclick="return confirm('Disable this policy?')">
                    <i class="ph ph-eye-closed"></i>
                    Disable
                </a>
            {% else %}
                <a href="{{ path('security_policy_enable', {'id': policy.id}) }}" class="px-4 py-2 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-lg hover:bg-emerald-200 dark:hover:bg-emerald-800/50 transition-colors">
                    <i class="ph ph-eye"></i>
                    Enable
                </a>
            {% endif %}
            <a href="{{ path('security_policy_delete', {'id': policy.id}) }}" class="px-4 py-2 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 rounded-lg hover:bg-red-200 dark:hover:bg-red-800/50 transition-colors" onclick="return confirm('Delete this policy?')">
                <i class="ph ph-trash"></i>
                Delete
            </a>
        </div>
    </div>

    {# Policy Details #}
    <div class="glass-panel p-8 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Basic Information</h2>
                <div class="space-y-4">
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Identifier</div>
                        <div class="font-medium text-slate-900 dark:text-slate-100">{{ policy.identifier }}</div>
                    </div>
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Policy Type</div>
                        <div class="flex items-center gap-2">
                            <i class="ph ph-{{ policy.policyType }} text-slate-400 dark:text-slate-500"></i>
                            <span>{{ policy.policyType|title }}</span>
                        </div>
                    </div>
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Effect</div>
                        <span class="px-2 py-1 rounded-full text-xs font-medium {% if policy.effect == 'allow' %}bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300{% elseif policy.effect == 'deny' %}bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300{% else %}bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300{% endif %}">
                            {{ policy.effect|title }}
                        </span>
                    </div>
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Priority</div>
                        <div class="font-medium text-slate-900 dark:text-slate-100">{{ policy.priority }}</div>
                    </div>
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Status</div>
                        <span class="px-2 py-1 rounded-full text-xs font-medium {% if policy.isEnabled %}bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300{% else %}bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300{% endif %}">
                            {{ policy.isEnabled ? 'Enabled' : 'Disabled' }}
                        </span>
                    </div>
                </div>
            </div>
            <div>
                <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Description</h2>
                <div class="p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg">
                    <p class="text-slate-800 dark:text-slate-200">{{ policy.description }}</p>
                </div>
            </div>
        </div>
    </div>

    {# Policy Rules #}
    <div class="glass-panel p-8 mb-6">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Policy Rules</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Actions</h3>
                <div class="space-y-2">
                    {% if policy.actions is defined and policy.actions|length > 0 %}
                        {% for action in policy.actions %}
                            <span class="px-2 py-1 rounded-full bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300 text-xs">{{ action }}</span>
                        {% endfor %}
                    {% else %}
                        <span class="text-slate-400 dark:text-slate-500 text-xs">All actions (*)</span>
                    {% endif %}
                </div>
            </div>
            <div>
                <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Resources</h3>
                <div class="space-y-2">
                    {% if policy.resources is defined and policy.resources|length > 0 %}
                        {% for resource in policy.resources %}
                            <span class="px-2 py-1 rounded-full bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300 text-xs">{{ resource }}</span>
                        {% endfor %}
                    {% else %}
                        <span class="text-slate-400 dark:text-slate-500 text-xs">All resources</span>
                    {% endif %}
                </div>
            </div>
            <div>
                <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Conditions</h3>
                <div class="p-3 bg-slate-50 dark:bg-slate-900/30 rounded-lg">
                    {% if policy.conditions|length > 0 %}
                        <pre class="text-xs text-slate-700 dark:text-slate-300 overflow-x-auto">{{ policy.conditions|json_encode|raw }}</pre>
                    {% else %}
                        <span class="text-slate-400 dark:text-slate-500 text-xs">No conditions</span>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Exceptions #}
    {% if policy.exceptions|length > 0 %}
        <div class="glass-panel p-8 mb-6">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Exceptions</h2>
            <div class="space-y-4">
                {% for exception in policy.exceptions %}
                    <div class="p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg border border-slate-200 dark:border-slate-700">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Conditions</div>
                                <pre class="text-xs text-slate-700 dark:text-slate-300 overflow-x-auto">{{ exception.conditions|json_encode|raw }}</pre>
                            </div>
                            <div>
                                <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Effect</div>
                                <span class="px-2 py-1 rounded-full text-xs font-medium {% if exception.effect == 'allow' %}bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300{% elseif exception.effect == 'deny' %}bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300{% else %}bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300{% endif %}">
                                    {{ exception.effect|title }}
                                </span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# Metadata #}
    {% if policy.metadata|length > 0 %}
        <div class="glass-panel p-8">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Metadata</h2>
            <div class="p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg">
                <pre class="text-xs text-slate-700 dark:text-slate-300 overflow-x-auto">{{ policy.metadata|json_encode(4)|raw }}</pre>
            </div>
        </div>
    {% endif %}

    {# Back Link #}
    <div class="mt-6">
        <a href="{{ path('security_policies') }}" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
            <i class="ph ph-arrow-left"></i>
            Back to Policies
        </a>
    </div>
</div>

{% block javascripts %}
{% endblock %}
{% endblock %}
