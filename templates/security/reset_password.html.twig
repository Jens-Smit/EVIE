{% extends 'auth_base.html.twig' %}

{% block title %}EVIE - Neues Passwort{% endblock %}

{% block body %}
<div class="auth-card p-8">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-1">Neues Passwort festlegen</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
        Wähle ein neues Passwort für dein EVIE-Konto.
    </p>

    {% if app.session is not null %}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 flex items-center gap-2 px-4 py-3 rounded-xl text-sm border
                    {% if label == 'success' %}
                        bg-emerald-50 dark:bg-emerald-500/10 border-emerald-200 dark:border-emerald-500/20 text-emerald-700 dark:text-emerald-400
                    {% elseif label == 'error' %}
                        bg-red-50 dark:bg-red-500/10 border-red-200 dark:border-red-500/20 text-red-700 dark:text-red-400
                    {% else %}
                        bg-slate-100 dark:bg-slate-800 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300
                    {% endif %}">
                    <i class="ph {% if label == 'success' %}ph-check-circle{% elseif label == 'error' %}ph-warning-circle{% else %}ph-info{% endif %} text-lg"></i>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
        {% endfor %}
    {% endif %}

    {{ form_start(resetPasswordForm, { attr: { class: 'space-y-4' } }) }}
    {{ form_row(resetPasswordForm.plainPassword, { label_attr: { class: 'auth-label' } }) }}
    {{ form_row(resetPasswordForm.submit) }}
    {{ form_end(resetPasswordForm) }}
</div>
{% endblock %}
