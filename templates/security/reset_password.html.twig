{% extends 'auth_base.html.twig' %}

{% block title %}EVIE - Neues Passwort{% endblock %}

{% block body %}
<div class="auth-card p-8">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-1">Neues Passwort festlegen</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
        Wähle ein neues Passwort für dein EVIE-Konto.
    </p>

    {{ form_start(resetPasswordForm, { attr: { class: 'space-y-4' } }) }}
    {{ form_row(resetPasswordForm.plainPassword, { label_attr: { class: 'auth-label' } }) }}
    {{ form_row(resetPasswordForm.submit) }}
    {{ form_end(resetPasswordForm) }}
</div>
{% endblock %}
