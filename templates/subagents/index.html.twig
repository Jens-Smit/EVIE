{% extends 'base.html.twig' %}

{% block title %}Subagenten - EVIE{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto p-4 sm:p-6 lg:p-8">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-content">
                <i class="ph ph-users-three"></i>
                Subagenten
            </h1>
            <p class="text-sm text-content-subtle mt-1">
                Erstellen und verwalten Sie spezielle Agenten fr verschiedene Aufgaben
            </p>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-border p-6 mb-6">
        <h2 class="text-lg font-semibold text-content mb-4">
            <i class="ph ph-plus-circle"></i>
            Neuen Subagenten erstellen
        </h2>
        <form id="createSubAgentForm" class="space-y-4">
            <div>
                <label for="name" class="block text-sm font-medium text-content mb-1">Name</label>
                <input type="text" name="name" id="name" required 
                       class="w-full p-3 border border-border rounded-xl bg-white dark:bg-slate-700 text-content
                              focus:ring-2 focus:ring-primary focus:border-transparent">
            </div>
            <div>
                <label for="description" class="block text-sm font-medium text-content mb-1">Beschreibung</label>
                <textarea name="description" id="description" rows="3" required
                          class="w-full p-3 border border-border rounded-xl bg-white dark:bg-slate-700 text-content
                                 focus:ring-2 focus:ring-primary focus:border-transparent"></textarea>
            </div>
            <div>
                <label for="capabilities" class="block text-sm font-medium text-content mb-1">Fhigkeiten (JSON)</label>
                <textarea name="capabilities" id="capabilities" rows="2"
                          placeholder='["analyse", "zusammenfassen", "generieren"]'
                          class="w-full p-3 border border-border rounded-xl bg-white dark:bg-slate-700 text-content
                                 font-mono text-sm focus:ring-2 focus:ring-primary focus:border-transparent">[]</textarea>
            </div>
            <button type="submit" class="btn btn-primary px-6 py-2">
                <i class="ph ph-plus"></i>
                Erstellen
            </button>
        </form>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-border p-6">
        <h2 class="text-lg font-semibold text-content mb-4">
            <i class="ph ph-list"></i>
            Meine Subagenten
        </h2>
        
        {% if subAgents|length > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for subAgent in subAgents %}
            <div class="bg-slate-50 dark:bg-slate-700 rounded-xl p-4 border border-border hover:border-primary/30 transition-colors">
                <div class="flex justify-between items-start mb-2">
                    <h3 class="text-lg font-semibold text-content">{{ subAgent.name }}</h3>
                    <span class="px-2 py-1 text-xs font-medium rounded-full 
                          {% if subAgent.status == 'active' %}bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400
                          {% else %}bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-400{% endif %}">
                        {{ subAgent.status }}
                    </span>
                </div>
                <p class="text-content-subtle mb-4">{{ subAgent.description }}</p>
                <div class="flex gap-2">
                    <a href="{{ path('api_subagents_get', {'id': subAgent.id}) }}" 
                       class="btn btn-ghost btn-sm text-content-subtle hover:text-content">
                        <i class="ph ph-eye"></i>
                        Details
                    </a>
                    <a href="{{ path('api_subagents_history', {'id': subAgent.id}) }}" 
                       class="btn btn-ghost btn-sm text-content-subtle hover:text-content">
                        <i class="ph ph-clock"></i>
                        Historie
                    </a>
                    <button 
                       class="btn btn-ghost btn-sm text-danger hover:bg-danger-soft"
                       onclick="event.preventDefault(); if(confirm('Subagent l\u00f6schen?')) { fetch('{{ path('api_subagents_delete', {'id': subAgent.id}) }}', { method: 'DELETE' }).then(() => window.location.reload()); }">
                        <i class="ph ph-trash"></i>
                        Lschen
                    </button>
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="bg-slate-50 dark:bg-slate-700 rounded-xl p-8 text-center border border-border">
            <i class="ph ph-users-three text-3xl text-content-muted mb-4"></i>
            <h3 class="text-lg font-semibold text-content mb-2">Keine Subagenten gefunden</h3>
            <p class="text-content-subtle mb-4">
                Erstellen Sie Ihren ersten Subagenten, um spezielle Aufgaben zu automatisieren.
            </p>
        </div>
        {% endif %}
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.getElementById('createSubAgentForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = {
                name: document.getElementById('name').value,
                description: document.getElementById('description').value,
                capabilities: JSON.parse(document.getElementById('capabilities').value || '[]')
            };
            
            fetch('{{ path('api_subagents_create') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content
                },
                body: JSON.stringify(formData)
            }).then(response => {
                if (response.ok) {
                    window.location.reload();
                } else {
                    alert('Fehler beim Erstellen des Subagenten');
                }
            }).catch(error => {
                alert('Fehler: ' + error.message);
            });
        });
    </script>
{% endblock %}
