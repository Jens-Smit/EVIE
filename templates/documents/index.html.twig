{% extends 'base.html.twig' %}

{% block title %}Dokumente - EVIE{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto p-4 sm:p-6 lg:p-8">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-content">
                <i class="ph ph-folders"></i>
                Dokumente
            </h1>
            <p class="text-sm text-content-subtle mt-1">
                Verwalten Sie Ihre Dokumente und Dateien
            </p>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-border p-6 mb-6">
        <h2 class="text-lg font-semibold text-content mb-4">
            <i class="ph ph-upload-simple"></i>
            Dokument hochladen
        </h2>
        <form action="{{ path('api_documents_upload') }}" method="post" enctype="multipart/form-data" class="space-y-4">
            <div>
                <label for="file" class="block text-sm font-medium text-content mb-1">Datei auswhlen</label>
                <input type="file" name="file" id="file" 
                       class="block w-full text-sm text-content
                              file:mr-4 file:py-2 file:px-4
                              file:rounded-xl file:border-0
                              file:text-sm file:font-semibold
                              file:bg-primary-soft file:text-primary
                              hover:file:bg-primary/10">
            </div>
            <button type="submit" class="btn btn-primary px-6 py-2">
                <i class="ph ph-upload"></i>
                Hochladen
            </button>
        </form>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-border p-6">
        <h2 class="text-lg font-semibold text-content mb-4">
            <i class="ph ph-list"></i>
            Meine Dokumente
        </h2>
        
        {% if documents|length > 0 %}
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-slate-50 dark:bg-slate-900">
                    <tr>
                        <th class="text-left p-4 text-xs font-semibold text-content-subtle uppercase">
                            Name
                        </th>
                        <th class="text-left p-4 text-xs font-semibold text-content-subtle uppercase">
                            Typ
                        </th>
                        <th class="text-left p-4 text-xs font-semibold text-content-subtle uppercase">
                            Gre
                        </th>
                        <th class="text-left p-4 text-xs font-semibold text-content-subtle uppercase">
                            Erstellt am
                        </th>
                        <th class="text-right p-4 text-xs font-semibold text-content-subtle uppercase">
                            Aktionen
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    {% for document in documents %}
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/50 transition-colors">
                        <td class="p-4 whitespace-nowrap text-content">
                            <div class="flex items-center gap-2">
                                <i class="ph ph-file-text text-content-subtle"></i>
                                <span>{{ document.name }}</span>
                            </div>
                        </td>
                        <td class="p-4 text-content-subtle text-sm">
                            {{ document.contentType|default('Unbekannt') }}
                        </td>
                        <td class="p-4 text-content-subtle text-sm">
                            {{ document.fileSize|default('N/A') }}
                        </td>
                        <td class="p-4 text-content-subtle text-sm">
                            {{ document.createdAt|date('d.m.Y H:i') }}
                        </td>
                        <td class="p-4">
                            <div class="flex justify-end gap-2">
                                <a href="{{ path('api_documents_get', {'id': document.id}) }}" 
                                   class="btn btn-ghost btn-sm text-content-subtle hover:text-content">
                                    <i class="ph ph-eye"></i>
                                    Anzeigen
                                </a>
                                <a href="#" 
                                   class="btn btn-ghost btn-sm text-danger hover:bg-danger-soft"
                                   onclick="event.preventDefault(); if(confirm('Dokument l\u00f6schen?')) { fetch('{{ path('api_documents_delete', {'id': document.id}) }}', { method: 'DELETE' }).then(() => window.location.reload()); }">
                                    <i class="ph ph-trash"></i>
                                    Lschen
                                </a>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="bg-slate-50 dark:bg-slate-700 rounded-xl p-8 text-center border border-border">
            <i class="ph ph-folders text-3xl text-content-muted mb-4"></i>
            <h3 class="text-lg font-semibold text-content mb-2">Keine Dokumente gefunden</h3>
            <p class="text-content-subtle mb-4">
                Laden Sie Ihr erstes Dokument hoch, um mit der Verarbeitung zu beginnen.
            </p>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
