{# templates/emails/reset_password.html.twig #}
{% block subject %}EVIE - Passwort zurücksetzen{% endblock %}

{% block body_html %}
    <div style="font-family: sans-serif; max-width: 560px; margin: 0 auto; padding: 24px;">
        <h2 style="color: #6366f1;">EVIE - Passwort zurücksetzen</h2>

        <p>Hallo {{ user.fullName ?: user.email }},</p>

        <p>
            du hast angefordert, dein EVIE-Passwort zurückzusetzen.
            Klicke auf den folgenden Button, um ein neues Passwort zu vergeben.
            Der Link ist 1 Stunde gültig.
        </p>

        <p style="text-align: center; margin: 32px 0;">
            <a href="{{ reset_url }}"
               style="background-color: #6366f1; color: #ffffff; text-decoration: none;
                      padding: 12px 24px; border-radius: 8px; font-weight: 600;">
                Passwort zurücksetzen
            </a>
        </p>

        <p style="color: #64748b; font-size: 14px;">
            oder kopiere diesen Link in deinen Browser:<br>
            <a href="{{ reset_url }}">{{ reset_url }}</a>
        </p>

        <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 32px 0;">

        <p style="color: #94a3b8; font-size: 13px;">
            Falls du kein neues Passwort angefordert hast, kannst du diese
            E-Mail ignorieren. Dein Passwort bleibt unverändert.
        </p>
    </div>
{% endblock %}
