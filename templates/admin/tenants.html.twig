{# templates/admin/tenants.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Tenants - EVIE Admin{% endblock %}

{% block body %}
<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6" x-data="{
    searchQuery: '',
    selectedTenant: null,
    
    filteredTenants() {
        if (!this.searchQuery) return {{ tenants|map(t => {id: t.id, name: t.name, identifier: t.identifier, createdAt: t.createdAt.format('c'), userCount: t.users|length})|json_encode|raw }};
        return {{ tenants|map(t => {id: t.id, name: t.name, identifier: t.identifier, createdAt: t.createdAt.format('c'), userCount: t.users|length})|json_encode|raw }}.filter(tenant => 
            tenant.name.toLowerCase().includes(this.searchQuery.toLowerCase()) ||
            tenant.identifier.toLowerCase().includes(this.searchQuery.toLowerCase())
        );
    }
}">
    {# Header #}
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Tenants</h1>
            <p class="text-slate-600 dark:text-slate-400 mt-1">Manage all tenants in the system</p>
        </div>
    </div>

    {# Search & Actions #}
    <div class="flex flex-col md:flex-row gap-4 mb-6">
        <div class="flex-1">
            <div class="relative">
                <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500"></i>
                <input 
                    type="text" 
                    x-model="searchQuery" 
                    placeholder="Search tenants..."
                    class="w-full pl-10 pr-4 py-2 bg-white dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-200 placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-primary/50"
                >
            </div>
        </div>
    </div>

    {# Tenants Table #}
    <div class="glass-panel">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="text-left text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="pb-3 pr-4">Name</th>
                        <th class="pb-3 pr-4">Identifier</th>
                        <th class="pb-3 pr-4">Users</th>
                        <th class="pb-3 pr-4">Created</th>
                        <th class="pb-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <template x-for="tenant in filteredTenants()" :key="tenant.id">
                        <tr class="border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-900/50">
                            <td class="py-3 pr-4">
                                <div class="font-medium text-slate-900 dark:text-slate-100">
                                    <a :href="'{{ path('admin_tenant_detail', {'id': 'TENANT_ID'}) }}'.replace('TENANT_ID', tenant.id)" class="hover:text-primary transition-colors">
                                        <span x-text="tenant.name"></span>
                                    </a>
                                </div>
                            </td>
                            <td class="py-3 pr-4 text-slate-600 dark:text-slate-400">
                                <code x-text="tenant.identifier"></code>
                            </td>
                            <td class="py-3 pr-4">
                                <span class="px-2 py-1 rounded-full bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300" x-text="tenant.userCount"></span>
                            </td>
                            <td class="py-3 pr-4 text-slate-500 dark:text-slate-400">
                                <span x-text="new Date(tenant.createdAt).toLocaleDateString()"></span>
                            </td>
                            <td class="py-3">
                                <div class="flex items-center gap-2">
                                    <a :href="'{{ path('admin_tenant_detail', {'id': 'TENANT_ID'}) }}'.replace('TENANT_ID', tenant.id)" class="px-3 py-1 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors text-sm">
                                        <i class="ph ph-eye"></i>
                                        View
                                    </a>
                                </div>
                            </td>
                        </tr>
                    </template>
                    
                    {% for tenant in tenants %}
                        <tr class="border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-900/50" style="display: none;">
                            <td class="py-3 pr-4">
                                <div class="font-medium text-slate-900 dark:text-slate-100">{{ tenant.name }}</div>
                            </td>
                            <td class="py-3 pr-4 text-slate-600 dark:text-slate-400">
                                <code>{{ tenant.identifier }}</code>
                            </td>
                            <td class="py-3 pr-4">
                                <span class="px-2 py-1 rounded-full bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300">{{ tenant.users|length }}</span>
                            </td>
                            <td class="py-3 pr-4 text-slate-500 dark:text-slate-400">
                                {{ tenant.createdAt|date('M d, Y') }}
                            </td>
                            <td class="py-3">
                                <div class="flex items-center gap-2">
                                    <a href="{{ path('admin_tenant_detail', {'id': tenant.id}) }}" class="px-3 py-1 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors text-sm">
                                        <i class="ph ph-eye"></i>
                                        View
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        {% if tenants|length == 0 %}
            <div class="text-center py-8 text-slate-500 dark:text-slate-400">
                <i class="ph ph-buildings text-4xl mb-2"></i>
                <p>No tenants found</p>
            </div>
        {% endif %}
    </div>
</div>

{% block javascripts %}
<script>
    // Fallback for browsers without Alpine.js
    document.addEventListener('DOMContentLoaded', function() {
        // Show all rows if Alpine.js is not available
        document.querySelectorAll('tr[style="display: none;"]').forEach(function(row) {
            row.style.display = 'table-row';
        });
    });
</script>
{% endblock %}
{% endblock %}
