{# templates/admin/tenant_detail.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ tenant.name }} - EVIE Admin{% endblock %}

{% block body %}
<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    {# Header #}
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">{{ tenant.name }}</h1>
            <p class="text-slate-600 dark:text-slate-400 mt-1">{{ tenant.identifier }}</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="{{ path('admin_tenants') }}" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                <i class="ph ph-arrow-left"></i>
                Back to Tenants
            </a>
        </div>
    </div>

    {# Tenant Statistics #}
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 mb-8">
        <div class="glass-panel p-4 text-center">
            <div class="text-2xl font-bold text-slate-900 dark:text-slate-100">{{ users|length }}</div>
            <div class="text-sm text-slate-500 dark:text-slate-400">Users</div>
        </div>
        <div class="glass-panel p-4 text-center">
            <div class="text-2xl font-bold text-slate-900 dark:text-slate-100">{{ executions|length }}</div>
            <div class="text-sm text-slate-500 dark:text-slate-400">Executions</div>
        </div>
        <div class="glass-panel p-4 text-center">
            <div class="text-2xl font-bold text-slate-900 dark:text-slate-100">{{ conversations|length }}</div>
            <div class="text-sm text-slate-500 dark:text-slate-400">Conversations</div>
        </div>
        <div class="glass-panel p-4 text-center">
            <div class="text-2xl font-bold text-slate-900 dark:text-slate-100">{{ capabilities|length }}</div>
            <div class="text-sm text-slate-500 dark:text-slate-400">Capabilities</div>
        </div>
        <div class="glass-panel p-4 text-center">
            <div class="text-2xl font-bold text-slate-900 dark:text-slate-100">{{ integrations|length }}</div>
            <div class="text-sm text-slate-500 dark:text-slate-400">Integrations</div>
        </div>
        <div class="glass-panel p-4 text-center">
            <div class="text-2xl font-bold text-slate-900 dark:text-slate-100">{{ policies|length }}</div>
            <div class="text-sm text-slate-500 dark:text-slate-400">Policies</div>
        </div>
    </div>

    {# Tenant Information #}
    <div class="glass-panel p-6 mb-6">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Tenant Information</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <div class="space-y-4">
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Name</div>
                        <div class="font-medium text-slate-900 dark:text-slate-100">{{ tenant.name }}</div>
                    </div>
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Identifier</div>
                        <code class="text-slate-800 dark:text-slate-200">{{ tenant.identifier }}</code>
                    </div>
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Created At</div>
                        <div class="text-slate-800 dark:text-slate-200">{{ tenant.createdAt|date('M d, Y H:i') }}</div>
                    </div>
                </div>
            </div>
            <div>
                <div class="space-y-4">
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Status</div>
                        <span class="px-2 py-1 rounded-full text-xs font-medium {% if tenant.isActive %}bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300{% else %}bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300{% endif %}">
                            {{ tenant.isActive ? 'Active' : 'Inactive' }}
                        </span>
                    </div>
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Subscription</div>
                        <div class="font-medium text-slate-900 dark:text-slate-100">{{ tenant.subscriptionPlan|title }}</div>
                    </div>
                    <div>
                        <div class="text-sm text-slate-500 dark:text-slate-400 mb-1">Max Users</div>
                        <div class="font-medium text-slate-900 dark:text-slate-100">{{ tenant.maxUsers }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Users Section #}
    <div class="glass-panel p-6 mb-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Users</h2>
            <a href="{{ path('admin_users') }}?tenant={{ tenant.id }}" class="text-sm text-primary hover:underline">View all users</a>
        </div>
        
        {% if users|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for user in users|slice(0, 6) %}
                    <a href="{{ path('admin_user_detail', {'id': user.id}) }}" class="block p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-colors group">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-primary/10 dark:bg-primary/20 flex items-center justify-center">
                                <i class="ph ph-user text-primary text-lg"></i>
                            </div>
                            <div>
                                <div class="font-medium text-slate-900 dark:text-slate-100 group-hover:text-primary transition-colors">{{ user.fullName ?? user.email }}</div>
                                <div class="text-xs text-slate-500 dark:text-slate-400">{{ user.email }}</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 mt-2">
                            <span class="px-2 py-0.5 rounded-full text-xs font-medium {% if user.isActive %}bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300{% else %}bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300{% endif %}">
                                {{ user.isActive ? 'Active' : 'Inactive' }}
                            </span>
                            {% for role in user.roles %}
                                <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300">{{ role }}</span>
                            {% endfor %}
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-8 text-slate-500 dark:text-slate-400">
                <i class="ph ph-users text-4xl mb-2"></i>
                <p>No users found for this tenant</p>
            </div>
        {% endif %}
    </div>

    {# Recent Executions #}
    <div class="glass-panel p-6 mb-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Recent Executions</h2>
            <a href="{{ path('admin_executions') }}?tenant={{ tenant.id }}" class="text-sm text-primary hover:underline">View all executions</a>
        </div>
        
        {% if executions|length > 0 %}
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="text-left text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-700">
                        <tr>
                            <th class="pb-2 pr-4">ID</th>
                            <th class="pb-2 pr-4">Agent</th>
                            <th class="pb-2 pr-4">User</th>
                            <th class="pb-2 pr-4">Status</th>
                            <th class="pb-2">Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for execution in executions|slice(0, 5) %}
                            <tr class="border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-900/50">
                                <td class="py-2 pr-4">
                                    <code class="text-xs">{{ execution.id|slice(0, 8) }}</code>
                                </td>
                                <td class="py-2 pr-4 font-medium text-slate-900 dark:text-slate-100">{{ execution.agent }}</td>
                                <td class="py-2 pr-4 text-slate-600 dark:text-slate-400">
                                    {% if execution.user %}{{ execution.user.email }}{% else %}System{% endif %}
                                </td>
                                <td class="py-2 pr-4">
                                    <span class="px-2 py-1 rounded-full text-xs font-medium {% if execution.status == 'completed' %}bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300{% elseif execution.status == 'failed' %}bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300{% else %}bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300{% endif %}">
                                        {{ execution.status }}
                                    </span>
                                </td>
                                <td class="py-2 text-slate-500 dark:text-slate-400">
                                    {{ execution.createdAt|date('M d, H:i') }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="text-center py-8 text-slate-500 dark:text-slate-400">
                <i class="ph ph-clipboard text-4xl mb-2"></i>
                <p>No executions found for this tenant</p>
            </div>
        {% endif %}
    </div>

    {# Recent Conversations #}
    <div class="glass-panel p-6 mb-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Recent Conversations</h2>
            <a href="{{ path('admin_conversations') }}?tenant={{ tenant.id }}" class="text-sm text-primary hover:underline">View all conversations</a>
        </div>
        
        {% if conversations|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for conversation in conversations|slice(0, 6) %}
                    <a href="{{ path('admin_conversation_detail', {'id': conversation.id}) }}" class="block p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-colors group">
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="font-medium text-slate-900 dark:text-slate-100 group-hover:text-primary transition-colors">{{ conversation.title }}</h3>
                            <span class="px-2 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300">
                                {{ conversation.messageCount }} messages
                            </span>
                        </div>
                        <div class="text-sm text-slate-500 dark:text-slate-400">
                            {{ conversation.updatedAt|date('M d, H:i') }}
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-8 text-slate-500 dark:text-slate-400">
                <i class="ph ph-chats-circle text-4xl mb-2"></i>
                <p>No conversations found for this tenant</p>
            </div>
        {% endif %}
    </div>

    {# Capabilities #}
    <div class="glass-panel p-6 mb-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Capabilities</h2>
            <a href="{{ path('admin_capabilities') }}?tenant={{ tenant.id }}" class="text-sm text-primary hover:underline">View all capabilities</a>
        </div>
        
        {% if capabilities|length > 0 %}
            <div class="flex flex-wrap gap-2">
                {% for capability in capabilities|slice(0, 20) %}
                    <span class="px-3 py-1 bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300 rounded-full text-sm">
                        {{ capability.name }}
                    </span>
                {% endfor %}
                {% if capabilities|length > 20 %}
                    <span class="px-3 py-1 bg-slate-100 dark:bg-slate-800/30 text-slate-500 dark:text-slate-400 rounded-full text-sm">
                        +{{ capabilities|length - 20 }} more
                    </span>
                {% endif %}
            </div>
        {% else %}
            <div class="text-center py-4 text-slate-500 dark:text-slate-400">
                <i class="ph ph-puzzle-piece text-2xl mb-2"></i>
                <p>No capabilities found for this tenant</p>
            </div>
        {% endif %}
    </div>

    {# Integrations #}
    <div class="glass-panel p-6 mb-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Integrations</h2>
            <a href="{{ path('admin_integrations') }}?tenant={{ tenant.id }}" class="text-sm text-primary hover:underline">View all integrations</a>
        </div>
        
        {% if integrations|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for integration in integrations|slice(0, 6) %}
                    <div class="p-4 bg-slate-50 dark:bg-slate-900/30 rounded-lg">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-8 h-8 rounded-full bg-secondary/10 dark:bg-secondary/20 flex items-center justify-center">
                                <i class="ph ph-plug text-secondary text-sm"></i>
                            </div>
                            <div>
                                <div class="font-medium text-slate-900 dark:text-slate-100">{{ integration.name }}</div>
                                <div class="text-xs text-slate-500 dark:text-slate-400">{{ integration.type }}</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            {% if integration.isReady %}
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                <span class="text-xs text-emerald-600 dark:text-emerald-400">Ready</span>
                            {% elseif integration.isConnected %}
                                <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                                <span class="text-xs text-blue-600 dark:text-blue-400">Connected</span>
                            {% else %}
                                <span class="w-2 h-2 rounded-full bg-slate-400"></span>
                                <span class="text-xs text-slate-500 dark:text-slate-400">Not Connected</span>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-8 text-slate-500 dark:text-slate-400">
                <i class="ph ph-plug text-4xl mb-2"></i>
                <p>No integrations found for this tenant</p>
            </div>
        {% endif %}
    </div>

    {# Policies #}
    <div class="glass-panel p-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Policies</h2>
            <a href="{{ path('admin_policies') }}?tenant={{ tenant.id }}" class="text-sm text-primary hover:underline">View all policies</a>
        </div>
        
        {% if policies|length > 0 %}
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="text-left text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-700">
                        <tr>
                            <th class="pb-2 pr-4">Name</th>
                            <th class="pb-2 pr-4">Type</th>
                            <th class="pb-2 pr-4">Effect</th>
                            <th class="pb-2 pr-4">Priority</th>
                            <th class="pb-2">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for policy in policies|slice(0, 5) %}
                            <tr class="border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-900/50">
                                <td class="py-2 pr-4 font-medium text-slate-900 dark:text-slate-100">{{ policy.name }}</td>
                                <td class="py-2 pr-4 text-slate-600 dark:text-slate-400">{{ policy.policyType|title }}</td>
                                <td class="py-2 pr-4">
                                    <span class="px-2 py-1 rounded-full text-xs font-medium {% if policy.effect == 'allow' %}bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300{% elseif policy.effect == 'deny' %}bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300{% else %}bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300{% endif %}">
                                        {{ policy.effect|title }}
                                    </span>
                                </td>
                                <td class="py-2 pr-4">{{ policy.priority }}</td>
                                <td class="py-2">
                                    <span class="px-2 py-1 rounded-full text-xs font-medium {% if policy.isEnabled %}bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300{% else %}bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300{% endif %}">
                                        {{ policy.isEnabled ? 'Enabled' : 'Disabled' }}
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="text-center py-8 text-slate-500 dark:text-slate-400">
                <i class="ph ph-file-text text-4xl mb-2"></i>
                <p>No policies found for this tenant</p>
            </div>
        {% endif %}
    </div>
</div>

{% block javascripts %}
{% endblock %}
{% endblock %}
