{# templates/admin/dashboard.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - EVIE{% endblock %}

{% block body %}
<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6" x-data="{}">
    {# Header #}
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">Admin Dashboard</h1>
            <p class="text-slate-600 dark:text-slate-400 mt-1">System overview and management</p>
        </div>
        <div class="flex items-center gap-4">
            <button class="px-4 py-2 bg-primary/10 dark:bg-primary/20 text-primary dark:text-white rounded-lg border border-primary/30 hover:bg-primary/20 dark:hover:bg-primary/30 transition-colors" @click="window.location.reload()">
                <i class="ph ph-arrow-clockwise text-lg"></i>
                <span class="ml-2">Refresh</span>
            </button>
        </div>
    </div>

    {# Statistics Cards #}
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 mb-8">
        <div class="glass-panel p-4 flex flex-col justify-between hover:scale-[1.02] transition-transform">
            <div>
                <i class="ph ph-buildings text-2xl text-slate-600 dark:text-slate-400"></i>
                <span class="text-3xl font-bold text-slate-900 dark:text-slate-100 mt-2">{{ stats.tenants }}</span>
            </div>
            <div class="text-sm text-slate-600 dark:text-slate-400 mt-2">Tenants</div>
        </div>

        <div class="glass-panel p-4 flex flex-col justify-between hover:scale-[1.02] transition-transform">
            <div>
                <i class="ph ph-users text-2xl text-slate-600 dark:text-slate-400"></i>
                <span class="text-3xl font-bold text-slate-900 dark:text-slate-100 mt-2">{{ stats.users }}</span>
            </div>
            <div class="text-sm text-slate-600 dark:text-slate-400 mt-2">Users</div>
        </div>

        <div class="glass-panel p-4 flex flex-col justify-between hover:scale-[1.02] transition-transform">
            <div>
                <i class="ph ph-robot text-2xl text-slate-600 dark:text-slate-400"></i>
                <span class="text-3xl font-bold text-slate-900 dark:text-slate-100 mt-2">{{ stats.executions }}</span>
            </div>
            <div class="text-sm text-slate-600 dark:text-slate-400 mt-2">Executions</div>
        </div>

        <div class="glass-panel p-4 flex flex-col justify-between hover:scale-[1.02] transition-transform">
            <div>
                <i class="ph ph-chats-circle text-2xl text-slate-600 dark:text-slate-400"></i>
                <span class="text-3xl font-bold text-slate-900 dark:text-slate-100 mt-2">{{ stats.conversations }}</span>
            </div>
            <div class="text-sm text-slate-600 dark:text-slate-400 mt-2">Conversations</div>
        </div>

        <div class="glass-panel p-4 flex flex-col justify-between hover:scale-[1.02] transition-transform">
            <div>
                <i class="ph ph-cpu text-2xl text-slate-600 dark:text-slate-400"></i>
                <span class="text-3xl font-bold text-slate-900 dark:text-slate-100 mt-2">{{ stats.llmConfigurations }}</span>
            </div>
            <div class="text-sm text-slate-600 dark:text-slate-400 mt-2">LLM Configs</div>
        </div>

        <div class="glass-panel p-4 flex flex-col justify-between hover:scale-[1.02] transition-transform">
            <div>
                <i class="ph ph-puzzle-piece text-2xl text-slate-600 dark:text-slate-400"></i>
                <span class="text-3xl font-bold text-slate-900 dark:text-slate-100 mt-2">{{ stats.capabilities }}</span>
            </div>
            <div class="text-sm text-slate-600 dark:text-slate-400 mt-2">Capabilities</div>
        </div>

        <div class="glass-panel p-4 flex flex-col justify-between hover:scale-[1.02] transition-transform">
            <div>
                <i class="ph ph-plug text-2xl text-slate-600 dark:text-slate-400"></i>
                <span class="text-3xl font-bold text-slate-900 dark:text-slate-100 mt-2">{{ stats.integrations }}</span>
            </div>
            <div class="text-sm text-slate-600 dark:text-slate-400 mt-2">Integrations</div>
        </div>

        <div class="glass-panel p-4 flex flex-col justify-between hover:scale-[1.02] transition-transform">
            <div>
                <i class="ph ph-server text-2xl text-slate-600 dark:text-slate-400"></i>
                <span class="text-3xl font-bold text-slate-900 dark:text-slate-100 mt-2">{{ stats.mcpServers }}</span>
            </div>
            <div class="text-sm text-slate-600 dark:text-slate-400 mt-2">MCP Servers</div>
        </div>

        <div class="glass-panel p-4 flex flex-col justify-between hover:scale-[1.02] transition-transform">
            <div>
                <i class="ph ph-shield-check text-2xl text-slate-600 dark:text-slate-400"></i>
                <span class="text-3xl font-bold text-slate-900 dark:text-slate-100 mt-2">{{ stats.policies }}</span>
            </div>
            <div class="text-sm text-slate-600 dark:text-slate-400 mt-2">Policies</div>
        </div>
    </div>

    {# Main Content Grid #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {# Left Column - Recent Executions #}
        <div class="glass-panel">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Recent Executions</h2>
                <a href="{{ path('admin_executions') }}" class="text-sm text-primary hover:underline">View all</a>
            </div>
            
            {% if recentExecutions|length > 0 %}
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="text-left text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-700">
                            <tr>
                                <th class="pb-2 pr-4">ID</th>
                                <th class="pb-2 pr-4">Agent</th>
                                <th class="pb-2 pr-4">Status</th>
                                <th class="pb-2 pr-4">Duration</th>
                                <th class="pb-2">Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for execution in recentExecutions %}
                                <tr class="border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-900/50">
                                    <td class="py-2 pr-4">
                                        <code class="text-xs">{{ execution.id|slice(0, 8) }}</code>
                                    </td>
                                    <td class="py-2 pr-4 font-medium text-slate-900 dark:text-slate-100">
                                        {{ execution.agent }}
                                    </td>
                                    <td class="py-2 pr-4">
                                        <span class="px-2 py-1 rounded-full text-xs font-medium {% if execution.status == 'completed' %}bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300{% elseif execution.status == 'failed' %}bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300{% elseif execution.status == 'running' %}bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300{% else %}bg-slate-100 dark:bg-slate-800/30 text-slate-700 dark:text-slate-300{% endif %}">
                                            {{ execution.status }}
                                        </span>
                                    </td>
                                    <td class="py-2 pr-4">
                                        {% if execution.duration %}
                                            {{ execution.duration }}s
                                        {% else %}
                                            <span class="text-slate-400 dark:text-slate-500">-</span>
                                        {% endif %}
                                    </td>
                                    <td class="py-2 text-slate-500 dark:text-slate-400">
                                        {{ execution.createdAt|date('M d, H:i') }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-8 text-slate-500 dark:text-slate-400">
                    <i class="ph ph-inbox text-4xl mb-2"></i>
                    <p>No recent executions found</p>
                </div>
            {% endif %}
        </div>

        {# Right Column - Capability & Policy Status #}
        <div class="space-y-6">
            {# Capability Status #}
            <div class="glass-panel">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Capabilities</h2>
                    <a href="{{ path('admin_capabilities') }}" class="text-sm text-primary hover:underline">Manage</a>
                </div>
                
                <div class="space-y-3">
                    <div class="flex justify-between items-center">
                        <span class="text-slate-600 dark:text-slate-400">Total</span>
                        <span class="font-medium text-slate-900 dark:text-slate-100">{{ capabilityStats.total ?? 0 }}</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-600 dark:text-slate-400">Enabled</span>
                        <span class="font-medium text-slate-900 dark:text-slate-100">{{ capabilityStats.enabled ?? 0 }}</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-600 dark:text-slate-400">Installed</span>
                        <span class="font-medium text-slate-900 dark:text-slate-100">{{ capabilityStats.installed ?? 0 }}</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-600 dark:text-slate-400">Configured</span>
                        <span class="font-medium text-slate-900 dark:text-slate-100">{{ capabilityStats.configured ?? 0 }}</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-600 dark:text-slate-400">Ready</span>
                        <span class="font-medium text-emerald-600 dark:text-emerald-400">{{ capabilityStats.ready ?? 0 }}</span>
                    </div>
                </div>
            </div>

            {# Policy Status #}
            <div class="glass-panel">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Policies</h2>
                    <a href="{{ path('admin_policies') }}" class="text-sm text-primary hover:underline">Manage</a>
                </div>
                
                <div class="space-y-3">
                    <div class="flex justify-between items-center">
                        <span class="text-slate-600 dark:text-slate-400">Total</span>
                        <span class="font-medium text-slate-900 dark:text-slate-100">{{ policyStats.total ?? 0 }}</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-600 dark:text-slate-400">Enabled</span>
                        <span class="font-medium text-slate-900 dark:text-slate-100">{{ policyStats.enabled ?? 0 }}</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-600 dark:text-slate-400">Allow</span>
                        <span class="font-medium text-emerald-600 dark:text-emerald-400">{{ policyStats.allow_policies ?? 0 }}</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-600 dark:text-slate-400">Deny</span>
                        <span class="font-medium text-red-600 dark:text-red-400">{{ policyStats.deny_policies ?? 0 }}</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-600 dark:text-slate-400">Ask (HITL)</span>
                        <span class="font-medium text-amber-600 dark:text-amber-400">{{ policyStats.ask_policies ?? 0 }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Integration Status #}
    <div class="glass-panel mt-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Ready Integrations</h2>
            <a href="{{ path('admin_integrations') }}" class="text-sm text-primary hover:underline">Manage</a>
        </div>
        
        {% if readyIntegrations|length > 0 %}
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                {% for integration in readyIntegrations %}
                    <div class="flex items-center gap-3 p-3 bg-slate-50 dark:bg-slate-900/30 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800/50 transition-colors">
                        <div class="w-10 h-10 rounded-full bg-primary/10 dark:bg-primary/20 flex items-center justify-center">
                            <i class="ph ph-plug text-primary text-lg"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="font-medium text-slate-900 dark:text-slate-100 truncate">{{ integration.name }}</div>
                            <div class="text-xs text-slate-500 dark:text-slate-400 truncate">{{ integration.type }}:{{ integration.identifier }}</div>
                        </div>
                        <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-8 text-slate-500 dark:text-slate-400">
                <i class="ph ph-plug text-4xl mb-2"></i>
                <p>No ready integrations found</p>
                <a href="{{ path('admin_integrations') }}" class="text-primary hover:underline mt-2 inline-block">Set up integrations</a>
            </div>
        {% endif %}
    </div>
</div>

{% block javascripts %}
<script>
    // Additional JavaScript for the dashboard
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize any additional components
    });
</script>
{% endblock %}
{% endblock %}
