{# templates/decision/dashboard.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}EVIE – Entscheidungs-Dashboard{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto space-y-6">
    <h1 class="text-2xl md:text-3xl font-bold text-content">Entscheidungs-Dashboard</h1>

    {# Übersicht #}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {# Ausstehende Entscheidungen #}
        <div class="card p-6">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-xl bg-warning-soft flex items-center justify-center shrink-0">
                    <i class="ph ph-hourglass text-warning text-xl"></i>
                </div>
                <h2 class="font-bold text-content">Ausstehend</h2>
            </div>
            <p class="text-4xl font-bold text-content">{{ statistics.pending }}</p>
            <p class="text-sm text-content-muted mt-1">Entscheidungen warten auf Freigabe</p>
        </div>

        {# Genehmigte Entscheidungen #}
        <div class="card p-6">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-xl bg-success-soft flex items-center justify-center shrink-0">
                    <i class="ph ph-check-circle text-success text-xl"></i>
                </div>
                <h2 class="font-bold text-content">Genehmigt</h2>
            </div>
            <p class="text-4xl font-bold text-content">{{ statistics.approved }}</p>
            <p class="text-sm text-content-muted mt-1">Entscheidungen wurden genehmigt</p>
        </div>

        {# Abgelehnte Entscheidungen #}
        <div class="card p-6">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-xl bg-danger-soft flex items-center justify-center shrink-0">
                    <i class="ph ph-x-circle text-danger text-xl"></i>
                </div>
                <h2 class="font-bold text-content">Abgelehnt</h2>
            </div>
            <p class="text-4xl font-bold text-content">{{ statistics.rejected }}</p>
            <p class="text-sm text-content-muted mt-1">Entscheidungen wurden abgelehnt</p>
        </div>
    </div>

    {# Ausstehende Entscheidungen #}
    <div class="card p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-content">Ausstehende Entscheidungen</h2>
            <span class="badge badge-pending">
                {{ pendingDecisions|length }} neu
            </span>
        </div>

        {% if pendingDecisions|length > 0 %}
            <div class="space-y-4">
                {% for decision in pendingDecisions %}
                    <div class="bg-warning-soft p-4 rounded-xl border-l-4 border-warning decision-item"
                         data-decision-id="{{ decision.id }}">
                        <div class="flex justify-between items-start">
                            <div class="flex-1">
                                <h3 class="font-bold text-lg text-content">{{ decision.description }}</h3>
                                <p class="text-sm text-content-muted mt-1">
                                    Typ: <span class="font-medium">{{ decision.type }}</span> |
                                    Erstellt: {{ decision.created_at }}
                                </p>
                                {% if decision.context %}
                                    <div class="mt-2 p-3 bg-surface rounded-lg border border-border">
                                        <h4 class="text-sm font-medium text-content mb-1">Kontext:</h4>
                                        <pre class="text-xs text-content-muted overflow-auto">{{ decision.context|json_encode|raw }}</pre>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        <div class="mt-4 flex flex-wrap gap-2">
                            <button class="btn btn-success approve-decision"
                                    data-decision-id="{{ decision.id }}">
                                <i class="ph ph-check"></i>
                                Genehmigen
                            </button>
                            <button class="btn btn-danger reject-decision"
                                    data-decision-id="{{ decision.id }}">
                                <i class="ph ph-x"></i>
                                Ablehnen
                            </button>
                            <button class="btn btn-ghost details-decision"
                                    data-decision-id="{{ decision.id }}">
                                <i class="ph ph-file-text"></i>
                                Details
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-content-muted text-center py-8">Keine ausstehenden Entscheidungen.</p>
        {% endif %}
    </div>

    {# Letzte Entscheidungen #}
    <div class="card p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-content">Letzte Entscheidungen</h2>
            <a href="#" class="text-primary hover:underline text-sm">Alle anzeigen →</a>
        </div>

        {% if recentDecisions|length > 0 %}
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Typ</th>
                            <th>Beschreibung</th>
                            <th>Status</th>
                            <th>Erstellt am</th>
                            <th>Genehmigt von</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for decision in recentDecisions %}
                            <tr>
                                <td class="font-medium text-content">#{{ decision.id }}</td>
                                <td>
                                    <span class="badge {% if decision.type|lower == 'tool_approval' %}badge-approved{% elseif decision.type|lower == 'api_access' %}badge-pending{% else %}badge-pending{% endif %}">
                                        {{ decision.type }}
                                    </span>
                                </td>
                                <td class="max-w-xs truncate" title="{{ decision.description }}">
                                    {{ decision.description }}
                                </td>
                                <td>
                                    <span class="badge {% if decision.status == 'approved' %}badge-approved{% elseif decision.status == 'rejected' %}badge-rejected{% else %}badge-pending{% endif %}">
                                        {{ decision.status }}
                                    </span>
                                </td>
                                <td>{{ decision.created_at }}</td>
                                <td>
                                    {{ decision.approved_by ?? '-' }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="text-content-muted text-center py-8">Keine Entscheidungen gefunden.</p>
        {% endif %}
    </div>

    {# Statistiken nach Typ #}
    <div class="card p-6">
        <h2 class="text-xl font-bold text-content mb-4">Statistiken nach Typ</h2>

        {% if statistics.by_type|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for type, stats in statistics.by_type %}
                    <div class="bg-surface-muted p-4 rounded-xl border border-border">
                        <h3 class="font-bold text-lg text-content mb-2">{{ type }}</h3>
                        <div class="space-y-1 text-sm">
                            <div class="flex justify-between">
                                <span class="text-content-muted">Gesamt:</span>
                                <span class="font-medium text-content">{{ stats.total }}</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-content-muted">Ausstehend:</span>
                                <span class="font-medium text-content">{{ stats.pending }}</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-content-muted">Genehmigt:</span>
                                <span class="font-medium text-success">{{ stats.approved }}</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-content-muted">Abgelehnt:</span>
                                <span class="font-medium text-danger">{{ stats.rejected }}</span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-content-muted text-center py-8">Keine Statistiken nach Typ verfügbar.</p>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Entscheidung-Handler
        document.querySelectorAll('.approve-decision').forEach(button => {
            button.addEventListener('click', function() {
                const decisionId = this.getAttribute('data-decision-id');
                const container = this.closest('.decision-item');
                approveDecision(decisionId, container);
            });
        });

        document.querySelectorAll('.reject-decision').forEach(button => {
            button.addEventListener('click', function() {
                const decisionId = this.getAttribute('data-decision-id');
                const container = this.closest('.decision-item');
                rejectDecision(decisionId, container);
            });
        });

        document.querySelectorAll('.details-decision').forEach(button => {
            button.addEventListener('click', function() {
                const decisionId = this.getAttribute('data-decision-id');
                showDecisionDetails(decisionId);
            });
        });
    });

    // Globale Funktionen für Entscheidungen
    function approveDecision(decisionId, container) {
        fetch(`/api/decisions/${decisionId}/approve`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json',
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.status === 'success') {
                showNotification('Entscheidung genehmigt!', 'success');
                if (container) container.remove();
                
                // Aktualisiere die Statistiken
                updateStatistics();
            } else {
                showNotification('Fehler beim Genehmigen', 'error');
            }
        })
        .catch(error => {
            showNotification('Fehler: ' + error.message, 'error');
        });
    }

    function rejectDecision(decisionId, container) {
        const reason = prompt('Begründung für die Ablehnung:');
        if (!reason) return;

        fetch(`/api/decisions/${decisionId}/reject`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json',
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ reason: reason })
        })
        .then(response => response.json())
        .then(data => {
            if (data.status === 'success') {
                showNotification('Entscheidung abgelehnt', 'info');
                if (container) container.remove();
                
                // Aktualisiere die Statistiken
                updateStatistics();
            } else {
                showNotification('Fehler beim Ablehnen', 'error');
            }
        })
        .catch(error => {
            showNotification('Fehler: ' + error.message, 'error');
        });
    }

    function showDecisionDetails(decisionId) {
        fetch(`/api/decisions/${decisionId}`, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json',
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.status === 'success') {
                const decision = data.decision;
                alert(`Entscheidungs-Details:\n\nID: ${decision.id}\nTyp: ${decision.type}\nStatus: ${decision.status}\nBeschreibung: ${decision.description}\nErstellt: ${decision.created_at}`);
            } else {
                showNotification('Fehler beim Laden der Details', 'error');
            }
        })
        .catch(error => {
            showNotification('Fehler: ' + error.message, 'error');
        });
    }

    function updateStatistics() {
        // Lade die Seite neu, um die Statistiken zu aktualisieren
        location.reload();
    }
    </script>
{% endblock %}