{# templates/audit_logs/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Audit-Logs{% endblock %}

{% block content %}
    <div class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-content">
                    <i class="ph ph-file-text"></i>
                    Audit-Logs
                </h1>
                <p class="text-sm text-content-subtle mt-1">
                    Nachverfolgung aller kritischen Aktionen im System (P0-9 Observability)
                </p>
            </div>
            <div class="flex gap-2">
                <a href="{{ path('app_audit_logs_export') }}" 
                   class="btn btn-secondary px-4 py-2 text-sm">
                    <i class="ph ph-download-simple"></i>
                    CSV Export
                </a>
            </div>
        </div>

        {# Filter-Formular #}
        <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-4 mb-6">
            <form method="get" action="{{ path('app_audit_logs') }}" class="flex flex-wrap gap-4 items-center">
                <div class="flex-1 min-w-48">
                    <label class="block text-xs text-content-subtle mb-1">Aktion</label>
                    <select name="action" class="w-full p-2 border border-border rounded-lg bg-white dark:bg-slate-700 text-content">
                        <option value="">Alle Aktionen</option>
                        <option value="tool_registration" {{ filters.action == 'tool_registration' ? 'selected' : '' }}>Tool-Registrierung</option>
                        <option value="tool_execution" {{ filters.action == 'tool_execution' ? 'selected' : '' }}>Tool-Ausfhrung</option>
                        <option value="tool_approval" {{ filters.action == 'tool_approval' ? 'selected' : '' }}>Tool-Freigabe</option>
                        <option value="hitl" {{ filters.action == 'hitl' ? 'selected' : '' }}>HITL</option>
                        <option value="ALLOW" {{ filters.action == 'ALLOW' ? 'selected' : '' }}>ALLOW</option>
                        <option value="DENY" {{ filters.action == 'DENY' ? 'selected' : '' }}>DENY</option>
                        <option value="ASK_USER" {{ filters.action == 'ASK_USER' ? 'selected' : '' }}>ASK_USER</option>
                    </select>
                </div>
                <div class="flex-1 min-w-48">
                    <label class="block text-xs text-content-subtle mb-1">Status</label>
                    <select name="status" class="w-full p-2 border border-border rounded-lg bg-white dark:bg-slate-700 text-content">
                        <option value="">Alle Status</option>
                        <option value="success" {{ filters.status == 'success' ? 'selected' : '' }}>Erfolgreich</option>
                        <option value="failure" {{ filters.status == 'failure' ? 'selected' : '' }}>Fehlgeschlagen</option>
                    </select>
                </div>
                <div class="flex-1 min-w-48">
                    <label class="block text-xs text-content-subtle mb-1">Entity-Typ</label>
                    <select name="entity_type" class="w-full p-2 border border-border rounded-lg bg-white dark:bg-slate-700 text-content">
                        <option value="">Alle Typen</option>
                        <option value="ToolDefinition" {{ filters.entity_type == 'ToolDefinition' ? 'selected' : '' }}>ToolDefinition</option>
                        <option value="DecisionLog" {{ filters.entity_type == 'DecisionLog' ? 'selected' : '' }}>DecisionLog</option>
                    </select>
                </div>
                <div class="flex items-end">
                    <button type="submit" class="btn btn-primary px-6 py-2">
                        <i class="ph ph-funnel"></i>
                        Filtern
                    </button>
                </div>
            </form>
        </div>

        {# Statistiken #}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-4">
                <div class="flex items-center gap-2 text-content-subtle mb-1">
                    <i class="ph ph-file-text"></i>
                    <span class="text-sm">Gesamt</span>
                </div>
                <div class="text-2xl font-bold text-content">{{ total }}</div>
            </div>
            <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-4">
                <div class="flex items-center gap-2 text-content-subtle mb-1">
                    <i class="ph ph-check-circle"></i>
                    <span class="text-sm">Erfolgreich</span>
                </div>
                <div class="text-2xl font-bold text-green-600 dark:text-green-400">{{ logs|filter(l => l.status == 'success')|length }}</div>
            </div>
            <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-4">
                <div class="flex items-center gap-2 text-content-subtle mb-1">
                    <i class="ph ph-x-circle"></i>
                    <span class="text-sm">Fehlgeschlagen</span>
                </div>
                <div class="text-2xl font-bold text-red-600 dark:text-red-400">{{ logs|filter(l => l.status == 'failure')|length }}</div>
            </div>
            <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-4">
                <div class="flex items-center gap-2 text-content-subtle mb-1">
                    <i class="ph ph-clock"></i>
                    <span class="text-sm">Heute</span>
                </div>
                <div class="text-2xl font-bold text-content">{{ logs|filter(l => l.createdAt|date('Y-m-d') == 'now'|date('Y-m-d'))|length }}</div>
            </div>
        </div>

        {# Log-Tabelle #}
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-border overflow-hidden">
            <table class="w-full">
                <thead class="bg-slate-50 dark:bg-slate-900">
                    <tr>
                        <th class="text-left p-4 text-xs font-semibold text-content-subtle uppercase">Aktion</th>
                        <th class="text-left p-4 text-xs font-semibold text-content-subtle uppercase">Entity</th>
                        <th class="text-left p-4 text-xs font-semibold text-content-subtle uppercase">User</th>
                        <th class="text-left p-4 text-xs font-semibold text-content-subtle uppercase">Status</th>
                        <th class="text-left p-4 text-xs font-semibold text-content-subtle uppercase">IP-Adresse</th>
                        <th class="text-left p-4 text-xs font-semibold text-content-subtle uppercase">Zeitpunkt</th>
                        <th class="text-right p-4 text-xs font-semibold text-content-subtle uppercase">Aktionen</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    {% for log in logs %}
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/50 transition-colors">
                            <td class="p-4">
                                <span class="inline-flex items-center gap-1">
                                    {% if log.action == 'tool_registration' %}
                                        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                                    {% elseif log.action == 'tool_execution' %}
                                        <span class="w-2 h-2 rounded-full bg-green-500"></span>
                                    {% elseif log.action == 'DENY' %}
                                        <span class="w-2 h-2 rounded-full bg-red-500"></span>
                                    {% elseif log.action == 'ALLOW' %}
                                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                    {% else %}
                                        <span class="w-2 h-2 rounded-full bg-slate-400"></span>
                                    {% endif %}
                                    <span class="font-medium text-content">{{ log.action }}</span>
                                </span>
                            </td>
                            <td class="p-4 text-content-subtle">
                                {{ log.entityType }}#{{ log.entityId }}
                            </td>
                            <td class="p-4 text-content-subtle">
                                {{ log.userId }}
                            </td>
                            <td class="p-4">
                                {% if log.status == 'success' %}
                                    <span class="px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-xs font-medium rounded-full">
                                        Erfolgreich
                                    </span>
                                {% elseif log.status == 'failure' %}
                                    <span class="px-2 py-1 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 text-xs font-medium rounded-full">
                                        Fehlgeschlagen
                                    </span>
                                {% else %}
                                    <span class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-medium rounded-full">
                                        {{ log.status }}
                                    </span>
                                {% endif %}
                            </td>
                            <td class="p-4 text-content-subtle text-xs">
                                {{ log.ipAddress }}
                            </td>
                            <td class="p-4 text-content-subtle text-xs whitespace-nowrap">
                                {{ log.createdAt|date('Y-m-d H:i:s') }}
                            </td>
                            <td class="p-4">
                                <div class="flex justify-end gap-2">
                                    <a href="{{ path('app_audit_log_show', {'id': log.id}) }}"
                                       class="btn btn-ghost btn-sm text-content-subtle hover:text-content">
                                        <i class="ph ph-eye"></i>
                                        Anzeigen
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="p-8 text-center text-content-subtle">
                                <i class="ph ph-inbox text-2xl mb-2"></i>
                                <p>Keine Audit-Logs gefunden.</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Pagination (einfach, da wir client-seitig filtern) #}
        {% if total > limit %}
            <div class="flex justify-center mt-6">
                <nav class="flex gap-2">
                    <a href="{{ path('app_audit_logs', {'page': currentPage - 1, 'limit': limit, 'action': filters.action, 'status': filters.status, 'entity_type': filters.entity_type}) }}"
                       class="btn btn-ghost {{ currentPage <= 1 ? 'opacity-50 cursor-not-allowed' : '' }}">
                        <i class="ph ph-caret-left"></i>
                        Zurck
                    </a>
                    <span class="btn btn-ghost px-4">
                        Seite {{ currentPage }} von {{ (total / limit)|round(0, 'ceil') }}
                    </span>
                    <a href="{{ path('app_audit_logs', {'page': currentPage + 1, 'limit': limit, 'action': filters.action, 'status': filters.status, 'entity_type': filters.entity_type}) }}"
                       class="btn btn-ghost {{ currentPage >= (total / limit)|round(0, 'ceil') ? 'opacity-50 cursor-not-allowed' : '' }}">
                        Nchste
                        <i class="ph ph-caret-right"></i>
                    </a>
                </nav>
            </div>
        {% endif %}
    </div>
{% endblock %}
