<!DOCTYPE html>
<html lang="de" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EVIE - AI Agent Workspace{% endblock %}</title>

    <link rel="stylesheet" href="{{ asset('assets/styles/tailwind.css') }}">
    <script src="https://unpkg.com/@phosphor-icons/web"></script>


    <style>
        :root {
            --color-primary: #6366f1;
            --color-primary-hover: #4f46e5;
            --color-surface: #ffffff;
            --color-surface-muted: #f8fafc;
            --color-surface-elevated: #f1f5f9;
            --color-content: #1e293b;
            --color-content-muted: #64748b;
            --color-border: #e2e8f0;
            --radius-card: 0.75rem;
            --radius-button: 0.5rem;
            --shadow-card: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -2px rgba(0,0,0,0.05);
        }
        .dark {
            --color-primary: #818cf8;
            --color-primary-hover: #a5b4fc;
            --color-surface: #1e293b;
            --color-surface-muted: #0f172a;
            --color-surface-elevated: #334155;
            --color-content: #f1f5f9;
            --color-content-muted: #94a3b8;
            --color-border: #334155;
        }

        body { font-family: ui-sans-serif, system-ui, sans-serif; }
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .dark ::-webkit-scrollbar-thumb { background: #334155; }

        .auth-card {
            background-color: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-card);
            box-shadow: var(--shadow-card);
        }
        .btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
            padding: 0.5rem 1rem; border-radius: var(--radius-button);
            font-weight: 500; font-size: 0.875rem; transition: all 0.2s ease;
            border: 1px solid transparent; cursor: pointer;
        }
        .btn-primary { background-color: var(--color-primary); color: #fff; }
        .btn-primary:hover { background-color: var(--color-primary-hover); transform: translateY(-1px); }
        .btn-ghost { background-color: transparent; color: var(--color-content-muted); border-color: var(--color-border); }
        .btn-ghost:hover { background-color: var(--color-surface-elevated); color: var(--color-content); }

        .auth-input {
            width: 100%;
            background-color: var(--color-surface-muted);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-button);
            padding: 0.625rem 0.875rem;
            font-size: 0.9rem;
            color: var(--color-content);
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .auth-input:focus {
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 20%, transparent);
        }
        .auth-input::placeholder { color: var(--color-content-muted); }

        label.auth-label {
            display: block;
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--color-content);
            margin-bottom: 0.35rem;
        }
    </style>
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-300 min-h-screen flex items-center justify-center p-4 relative overflow-hidden">
    <!-- Hintergrund Effekte -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none">
        <div class="absolute top-[-10%] left-[-10%] w-72 h-72 md:w-96 md:h-96 bg-primary opacity-30 dark:opacity-20 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[100px] animate-blob"></div>
        <div class="absolute top-[20%] right-[-10%] w-72 h-72 md:w-96 md:h-96 bg-secondary opacity-30 dark:opacity-20 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[100px] animate-blob" style="animation-delay: 2s;"></div>
        <div class="absolute bottom-[-20%] left-[20%] w-72 h-72 md:w-96 md:h-96 bg-emerald-500 opacity-20 dark:opacity-10 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[100px] animate-blob" style="animation-delay: 4s;"></div>
    </div>

    <!-- Auth Content -->
    <div class="w-full max-w-md z-10 relative">
        <!-- Logo -->
        <div class="flex items-center justify-center gap-3 mb-8">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-primary to-secondary flex items-center justify-center shadow-lg shadow-primary/30">
                <i class="ph ph-brain text-white text-2xl"></i>
            </div>
            <div class="text-left">
                <h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-wide">EVIE</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">AI Agent System</p>
            </div>
        </div>

        {% block body %}{% endblock %}

        <!-- Footer -->
        <p class="text-center text-xs text-slate-500 dark:text-slate-500 mt-8">
            &copy; {{ 'now'|date('Y') }} EVIE &middot; Vision Gastro / AiCabs
        </p>
    </div>

    {% block javascripts %}{% endblock %}
</body>
</html>
