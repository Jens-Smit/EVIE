{# templates/frontend/settings/scheduled_tasks/edit.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Aufgabe bearbeiten{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {# Seitenleiste #}
        {% include 'frontend/settings/_sidebar.html.twig' %}
        
        {# Hauptinhalt #}
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Aufgabe bearbeiten</h1>
            </div>

            {# Erfolgreich/Fehler-Meldungen #}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
            
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            <div class="card mb-4">
                <div class="card-header">
                    <h5>Aktuelle Aufgabe</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">ID:</dt>
                        <dd class="col-sm-9">{{ task.id }}</dd>
                        
                        <dt class="col-sm-3">Erstellt:</dt>
                        <dd class="col-sm-9">{{ task.createdAt|date('d.m.Y H:i') }}</dd>
                        
                        <dt class="col-sm-3">Status:</dt>
                        <dd class="col-sm-9">
                            <span class="badge 
                                {% if task.isPending %}bg-secondary
                                {% elseif task.isExecuted %}bg-success
                                {% elseif task.isFailed %}bg-danger
                                {% elseif task.isExecuting %}bg-primary
                                {% else %}bg-warning{% endif %}">
                                {{ task.getStatusLabel() }}
                            </span>
                        </dd>
                        
                        <dt class="col-sm-3">Wiederkehrend:</dt>
                        <dd class="col-sm-9">{{ task.getRecurrenceLabel() }}</dd>
                    </dl>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5>Aufgabe bearbeiten</h5>
                </div>
                <div class="card-body">
                    <form method="post" action="{{ path('app_scheduled_task_edit', {'id': task.id}) }}">
                        <div class="mb-3">
                            <label for="task_description" class="form-label">Aufgabenbeschreibung *</label>
                            <textarea class="form-control" id="task_description" name="task_description" rows="3" required>{{ task.taskDescription }}</textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="task_type" class="form-label">Aufgabentyp *</label>
                                    <select class="form-select" id="task_type" name="task_type" required>
                                        <option value="">Bitte wählen</option>
                                        {% for type, label in taskTypes %}
                                            <option value="{{ type }}" {% if task.taskType == type %}selected{% endif %}>
                                                {{ label }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="scheduled_at" class="form-label">Datum und Uhrzeit *</label>
                                    <input type="datetime-local" class="form-control" id="scheduled_at" name="scheduled_at" 
                                           value="{{ task.scheduledAt|date('Y-m-d\TH:i') }}" required>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="is_recurring" name="is_recurring" value="1"
                                       {% if task.isRecurring %}checked{% endif %}>
                                <label class="form-check-label" for="is_recurring">
                                    Wiederkehrende Aufgabe
                                </label>
                            </div>
                        </div>

                        <div id="recurrence-section" style="display: {% if task.isRecurring %}block{% else %}none{% endif %};">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="recurrence_pattern" class="form-label">Wiederholungsmuster</label>
                                        <select class="form-select" id="recurrence_pattern" name="recurrence_pattern">
                                            <option value="">Bitte wählen</option>
                                            {% for pattern, label in recurrencePatterns %}
                                                <option value="{{ pattern }}" {% if task.recurrencePattern == pattern %}selected{% endif %}>
                                                    {{ label }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="recurrence_interval" class="form-label">Intervall</label>
                                        <input type="number" class="form-control" id="recurrence_interval" name="recurrence_interval" 
                                               value="{{ task.recurrenceInterval ?? 1 }}" min="1">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="{{ path('app_scheduled_tasks') }}" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Zurück
                            </a>
                            <div>
                                <a href="{{ path('app_scheduled_task_show', {'id': task.id}) }}" class="btn btn-outline-info me-2">
                                    <i class="fas fa-eye"></i> Anzeigen
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Speichern
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>
</div>

<script>
// Wiederkehrende Aufgabe Toggle
const isRecurringCheckbox = document.getElementById('is_recurring');
const recurrenceSection = document.getElementById('recurrence-section');

isRecurringCheckbox.addEventListener('change', function() {
    recurrenceSection.style.display = this.checked ? 'block' : 'none';
});
</script>
{% endblock %}
