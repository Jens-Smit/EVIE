{# templates/frontend/settings/scheduled_tasks/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Geplante Aufgaben{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {# Seitenleiste #}
        {% include 'frontend/settings/_sidebar.html.twig' %}
        
        {# Hauptinhalt #}
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Geplante Aufgaben</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <div class="btn-group me-2">
                        <a href="{{ path('app_scheduled_task_create') }}" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> Neue Aufgabe
                        </a>
                    </div>
                </div>
            </div>

            {# Erfolgreich/Fehler-Meldungen #}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
            
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            {# Statistik #}
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card text-white bg-primary mb-3">
                        <div class="card-body">
                            <h5 class="card-title">{{ tasks|length }}</h5>
                            <p class="card-text">Gesamt</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-warning mb-3">
                        <div class="card-body">
                            <h5 class="card-title">{{ pending_tasks|length }}</h5>
                            <p class="card-text">Ausstehend</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-success mb-3">
                        <div class="card-body">
                            <h5 class="card-title">0</h5>
                            <p class="card-text">Erfolgreich</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-info mb-3">
                        <div class="card-body">
                            <h5 class="card-title">{{ recurring_tasks|length }}</h5>
                            <p class="card-text">Wiederkehrend</p>
                        </div>
                    </div>
                </div>
            </div>

            {% if tasks|length > 0 %}
            <div class="card mb-4">
                <div class="card-header">
                    <h5>Alle geplanten Aufgaben</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Beschreibung</th>
                                    <th>Typ</th>
                                    <th>Geplant für</th>
                                    <th>Status</th>
                                    <th>Wiederkehrend</th>
                                    <th>Aktiv</th>
                                    <th>Aktionen</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for task in tasks %}
                                <tr class="{% if task.isOverdue %}table-warning{% endif %}">
                                    <td>
                                        <strong>{{ task.taskDescription|slice(0, 50) }}{% if task.taskDescription|length > 50 %}...{% endif %}</strong>
                                    </td>
                                    <td>{{ task.getTaskTypeLabel() }}</td>
                                    <td>
                                        {{ task.scheduledAt|date('d.m.Y H:i') }}
                                        {% if task.isRecurring and task.nextExecutionAt %}
                                            <br>
                                            <small class="text-muted">
                                                Nächste: {{ task.nextExecutionAt|date('d.m.Y H:i') }}
                                            </small>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge 
                                            {% if task.isPending %}bg-secondary
                                            {% elseif task.isExecuted %}bg-success
                                            {% elseif task.isFailed %}bg-danger
                                            {% elseif task.isExecuting %}bg-primary
                                            {% else %}bg-warning{% endif %}">
                                            {{ task.getStatusLabel() }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if task.isRecurring %}
                                            <span class="badge bg-info" title="{{ task.getRecurrenceLabel() }}">
                                                Ja
                                            </span>
                                        {% else %}
                                            <span class="badge bg-secondary">Nein</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if task.isActive %}
                                            <span class="badge bg-success">Ja</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Nein</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a href="{{ path('app_scheduled_task_show', {'id': task.id}) }}" 
                                               class="btn btn-sm btn-outline-info" title="Anzeigen">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="{{ path('app_scheduled_task_edit', {'id': task.id}) }}" 
                                               class="btn btn-sm btn-outline-primary" title="Bearbeiten">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form method="post" action="{{ path('app_scheduled_task_toggle', {'id': task.id}) }}" 
                                                  onsubmit="return confirm('Soll diese Aufgabe {{ task.isActive ? 'deaktiviert' : 'aktiviert' }} werden?')">
                                                <button type="submit" class="btn btn-sm 
                                                    {% if task.isActive %}btn-outline-warning{% else %}btn-outline-success{% endif %}" 
                                                        title="{{ task.isActive ? 'Deaktivieren' : 'Aktivieren' }}">
                                                    {% if task.isActive %}
                                                        <i class="fas fa-pause"></i>
                                                    {% else %}
                                                        <i class="fas fa-play"></i>
                                                    {% endif %}
                                                </button>
                                            </form>
                                            <form method="post" action="{{ path('app_scheduled_task_delete', {'id': task.id}) }}" 
                                                  onsubmit="return confirm('Sind Sie sicher, dass Sie diese Aufgabe löschen möchten?')">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Löschen">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="card">
                <div class="card-body text-center">
                    <i class="fas fa-calendar-alt fa-3x text-muted mb-3"></i>
                    <h5>Keine geplanten Aufgaben</h5>
                    <p>Sie haben noch keine geplanten Aufgaben erstellt.</p>
                    <a href="{{ path('app_scheduled_task_create') }}" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Erste Aufgabe erstellen
                    </a>
                </div>
            </div>
            {% endif %}
        </main>
    </div>
</div>
{% endblock %}
