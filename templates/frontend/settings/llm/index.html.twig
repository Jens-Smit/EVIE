{# templates/frontend/settings/llm/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}LLM-Einstellungen{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {# Seitenleiste #}
        {% include 'frontend/settings/_sidebar.html.twig' %}
        
        {# Hauptinhalt #}
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">LLM-Einstellungen</h1>
            </div>

            {# Erfolgreich/Fehler-Meldungen #}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
            
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Aktuelle LLM-Konfiguration</h5>
                    <p class="card-text">
                        Hier können Sie Ihren bevorzugten LLM-Anbieter und das Modell auswählen. 
                        Falls Sie keinen API-Key angeben, wird der Standard-Key aus der Systemkonfiguration verwendet.
                    </p>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Aktueller Anbieter:</dt>
                                <dd class="col-sm-8">
                                    <strong>{{ currentProvider|capitalize }}</strong>
                                    {% if currentProvider == 'custom' %}
                                        <span class="badge bg-info">Benutzerdefiniert</span>
                                    {% endif %}
                                </dd>
                                
                                <dt class="col-sm-4">Aktuelles Modell:</dt>
                                <dd class="col-sm-8"><code>{{ currentModel }}</code></dd>
                                
                                <dt class="col-sm-4">Standard-Konfiguration:</dt>
                                <dd class="col-sm-8">
                                    {% if defaultConfig %}
                                        <span class="badge bg-success">Ja</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Nein (System-Default)</span>
                                    {% endif %}
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <h6 class="card-title">Schnellauswahl</h6>
                                    <div class="d-grid gap-2">
                                        <a href="#create-form" class="btn btn-primary btn-sm">
                                            <i class="fas fa-plus"></i> Neue Konfiguration hinzufügen
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {% if configurations|length > 0 %}
            <div class="card mb-4">
                <div class="card-header">
                    <h5>Ihre LLM-Konfigurationen</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Anbieter</th>
                                    <th>Modell</th>
                                    <th>API-Key</th>
                                    <th>Standard</th>
                                    <th>Aktionen</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for config in configurations %}
                                <tr>
                                    <td>
                                        <strong>{{ config.provider|capitalize }}</strong>
                                        {% if config.isCustom() %}
                                            <br>
                                            <small class="text-muted">{{ config.customProviderName ?: 'Benutzerdefiniert' }}</small>
                                        {% endif %}
                                    </td>
                                    <td><code>{{ config.model }}</code></td>
                                    <td>
                                        {% if config.apiKey %}
                                            <span class="badge bg-success">✓ Hinterlegt</span>
                                        {% else %}
                                            <span class="badge bg-secondary">System-Default</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if config.isDefault %}
                                            <span class="badge bg-success">Ja</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Nein</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            {% if not config.isDefault %}
                                                <form method="post" action="{{ path('app_llm_set_default', {'id': config.id}) }}" 
                                                      onsubmit="return confirm('Soll diese Konfiguration als Standard gesetzt werden?')">
                                                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Als Standard setzen">
                                                        <i class="fas fa-star"></i>
                                                    </button>
                                                </form>
                                            {% endif %}
                                            <form method="post" action="{{ path('app_llm_delete', {'id': config.id}) }}" 
                                                  onsubmit="return confirm('Sind Sie sicher, dass Sie diese Konfiguration löschen möchten?')">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Löschen">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {% endif %}

            <div class="card" id="create-form">
                <div class="card-header">
                    <h5>Neue LLM-Konfiguration hinzufügen</h5>
                </div>
                <div class="card-body">
                    <form method="post" action="{{ path('app_llm_save') }}">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="provider" class="form-label">Anbieter *</label>
                                    <select class="form-select" id="provider" name="provider" required>
                                        <option value="">Bitte wählen</option>
                                        {% for provider in providers %}
                                            <option value="{{ provider }}" 
                                                    {% if currentProvider == provider %}selected{% endif %}>
                                                {{ provider|capitalize }}
                                            </option>
                                        {% endfor %}
                                        <option value="custom" {% if currentProvider == 'custom' %}selected{% endif %}>Selbstgehostet (Custom)</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="model" class="form-label">Modell *</label>
                                    <select class="form-select" id="model" name="model" required disabled>
                                        <option value="">Bitte zuerst Anbieter wählen</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="api_key" class="form-label">API-Key (optional)</label>
                            <input type="password" class="form-control" id="api_key" name="api_key" 
                                   placeholder="Falls nicht angegeben, wird der System-Default-Key verwendet">
                            <div class="form-text">
                                Falls kein API-Key angegeben wird, wird der Default-Key aus der Systemkonfiguration verwendet.
                            </div>
                        </div>

                        <div id="custom-provider-section" style="display: none;">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="custom_provider_name" class="form-label">Custom Anbieter Name</label>
                                        <input type="text" class="form-control" id="custom_provider_name" name="custom_provider_name"
                                               placeholder="z.B. Mein LocalAI">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="custom_api_url" class="form-label">API-URL</label>
                                        <input type="url" class="form-control" id="custom_api_url" name="custom_api_url"
                                               placeholder="https://Ihre-API-URL/v1">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="is_default" name="is_default" value="1"
                                   {% if configurations|length == 0 %}checked{% endif %}>
                            <label class="form-check-label" for="is_default">Als Standard setzen</label>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Speichern
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h5>Verfügbare Anbieter und Modelle</h5>
                </div>
                <div class="card-body">
                    <div class="accordion" id="providerAccordion">
                        {% for provider in providers %}
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" 
                                        data-bs-toggle="collapse" 
                                        data-bs-target="#collapse-{{ provider }}" 
                                        aria-expanded="false" 
                                        aria-controls="collapse-{{ provider }}">
                                    {{ provider|capitalize }}
                                </button>
                            </h2>
                            <div id="collapse-{{ provider }}" class="accordion-collapse collapse" 
                                 data-bs-parent="#providerAccordion">
                                <div class="accordion-body">
                                    <ul class="list-unstyled">
                                        {% for model in modelsByProvider[provider] %}
                                        <li>
                                            <code>{{ model }}</code>
                                            {% if provider == 'mistral' and model == 'mistral-small-latest' %}
                                                <span class="badge bg-primary ms-2">Standard</span>
                                            {% endif %}
                                        </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<script>
// Dynamische Modell-Auswahl
const providerSelect = document.getElementById('provider');
const modelSelect = document.getElementById('model');
const customSection = document.getElementById('custom-provider-section');

const modelsByProvider = {{ modelsByProvider|json_encode|raw }};

providerSelect.addEventListener('change', function() {
    const provider = this.value;
    
    // Modelle aktualisieren
    modelSelect.innerHTML = '<option value="">Bitte wählen</option>';
    modelSelect.disabled = !provider;
    
    if (provider && modelsByProvider[provider]) {
        modelsByProvider[provider].forEach(model => {
            const option = document.createElement('option');
            option.value = model;
            option.textContent = model;
            modelSelect.appendChild(option);
        });
        modelSelect.disabled = false;
    }
    
    // Custom Section anzeigen/verstecken
    customSection.style.display = provider === 'custom' ? 'block' : 'none';
});

// Initialen Zustand setzen
if (providerSelect.value) {
    const event = new Event('change');
    providerSelect.dispatchEvent(event);
}
</script>
{% endblock %}
