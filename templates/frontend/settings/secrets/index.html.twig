{# templates/frontend/settings/secrets/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}API-Keys & Secrets{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        {# Seitenleiste #}
        {% include 'frontend/settings/_sidebar.html.twig' %}
        
        {# Hauptinhalt #}
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">API-Keys & Secrets</h1>
            </div>

            {# Erfolgreich/Fehler-Meldungen #}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
            
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            {% if search_query %}
            <div class="alert alert-info">
                <i class="fas fa-search"></i> Suchergebnisse für: <strong>{{ search_query }}</strong>
                <a href="{{ path('app_user_secrets') }}" class="btn btn-sm btn-outline-secondary ms-3">
                    <i class="fas fa-times"></i> Suche zurücksetzen
                </a>
            </div>
            {% endif %}

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Hinterlegte Secrets</h5>
                    <p class="card-text">
                        Hier können Sie API-Keys und Security-Tokens für Tools hinterlegen. 
                        Diese werden verschlüsselt gespeichert und sind nur für Sie sichtbar.
                    </p>
                    
                    {% if secrets|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Schlüssel</th>
                                    <th>Beschreibung</th>
                                    <th>Tool</th>
                                    <th>Status</th>
                                    <th>Aktionen</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for secret in secrets %}
                                <tr>
                                    <td>
                                        <code>{{ secret.getMaskedKey() }}</code>
                                        {% if secret.isForTool() %}
                                            <br>
                                            <small class="text-muted">Für: {{ secret.toolName }}</small>
                                        {% endif %}
                                    </td>
                                    <td>{{ secret.description ?: '-' }}</td>
                                    <td>{{ secret.toolName ?: '-' }}</td>
                                    <td>
                                        {% if secret.isActive %}
                                            <span class="badge bg-success">Aktiv</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Inaktiv</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            {% if secret.isActive %}
                                                <form method="post" action="{{ path('app_user_secret_deactivate', {'id': secret.id}) }}" 
                                                      onsubmit="return confirm('Soll dieses Secret deaktiviert werden?')">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Deaktivieren">
                                                        <i class="fas fa-pause"></i>
                                                    </button>
                                                </form>
                                            {% else %}
                                                <form method="post" action="{{ path('app_user_secret_activate', {'id': secret.id}) }}" 
                                                      onsubmit="return confirm('Soll dieses Secret aktiviert werden?')">
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Aktivieren">
                                                        <i class="fas fa-play"></i>
                                                    </button>
                                                </form>
                                            {% endif %}
                                            <form method="post" action="{{ path('app_user_secret_delete', {'id': secret.id}) }}" 
                                                  onsubmit="return confirm('Sind Sie sicher, dass Sie dieses Secret löschen möchten?')">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Löschen">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> Keine Secrets hinterlegt.
                    </div>
                    {% endif %}
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5>Neues Secret hinzufügen</h5>
                </div>
                <div class="card-body">
                    <form method="post" action="{{ path('app_user_secret_save') }}">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="key" class="form-label">Schlüssel *</label>
                                    <input type="text" class="form-control" id="key" name="key" required
                                           placeholder="z.B. github_token, openai_api_key">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="tool_name" class="form-label">Tool (optional)</label>
                                    <input type="text" class="form-control" id="tool_name" name="tool_name"
                                           placeholder="z.B. github_tool">
                                </div>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="value" class="form-label">Wert *</label>
                            <input type="password" class="form-control" id="value" name="value" required
                                   placeholder="Ihr API-Key oder Token">
                        </div>
                        
                        <div class="mb-3">
                            <label for="description" class="form-label">Beschreibung (optional)</label>
                            <textarea class="form-control" id="description" name="description" rows="2"
                                      placeholder="z.B. Persönlicher GitHub Access Token für Repository-Zugriff"></textarea>
                        </div>
                        
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Speichern
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            {% if tools_with_secrets|length > 0 %}
            <div class="card">
                <div class="card-header">
                    <h5>Tools mit Secret-Anforderungen</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Tool</th>
                                    <th>Benötigte Secrets</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in tools_with_secrets %}
                                <tr>
                                    <td>
                                        <strong>{{ item.tool.name }}</strong>
                                        <br>
                                        <small class="text-muted">{{ item.tool.description|slice(0, 50) }}...</small>
                                    </td>
                                    <td>
                                        {% for secret in item.required_secrets %}
                                            <code>{{ secret.secretKey }}</code>
                                            {% if not loop.last %}, {% endif %}
                                            <br>
                                        {% endfor %}
                                    </td>
                                    <td>
                                        {% if item.has_all_secrets %}
                                            <span class="badge bg-success">Alle Secrets vorhanden</span>
                                        {% else %}
                                            <span class="badge bg-warning text-dark">Secrets fehlen</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {% endif %}

            {% if missing_secrets|length > 0 %}
            <div class="card mt-4">
                <div class="card-header bg-warning text-dark">
                    <h5>Fehlende Secrets</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i> 
                        Die folgenden Tools können nicht verwendet werden, weil fehlende Secrets benötigt werden:
                    </div>
                    
                    <ul class="list-group">
                        {% for secret in missing_secrets %}
                        <li class="list-group-item">
                            <strong>{{ secret.tool }}</strong>: 
                            Benötigt <code>{{ secret.key }}</code> - {{ secret.description }}
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            {% endif %}
        </main>
    </div>
</div>
{% endblock %}
