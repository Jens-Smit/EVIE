{# templates/tools/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}EVIE – Tools verwalten{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto space-y-6">
    <h1 class="text-2xl md:text-3xl font-bold text-content">Tools verwalten</h1>

    {# Ausstehende Tools #}
    <div class="card p-6">
        <h2 class="card-title flex items-center gap-2">
            <i class="ph ph-hourglass text-warning"></i>
            Ausstehende Tools
        </h2>
        
        {% if pending_tools is defined and pending_tools|length > 0 %}
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Tool ID</th>
                            <th>Name</th>
                            <th>Beschreibung</th>
                            <th>Angefragt von</th>
                            <th>Datum</th>
                            <th>Status</th>
                            <th>Aktionen</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for tool in pending_tools %}
                            <tr>
                                <td>{{ tool.id }}</td>
                                <td class="font-medium">{{ tool.name }}</td>
                                <td class="max-w-xs truncate" title="{{ tool.description }}">{{ tool.description }}</td>
                                <td>{{ tool.requestedBy }}</td>
                                <td>{{ tool.requestedAt|date('d.m.Y H:i') }}</td>
                                <td>
                                    <span class="badge badge-pending">Ausstehend</span>
                                </td>
                                <td>
                                    <div class="flex gap-2">
                                        <button class="btn btn-success btn-sm approve-tool"
                                                data-tool-id="{{ tool.id }}">
                                            <i class="ph ph-check"></i>
                                            Genehmigen
                                        </button>
                                        <button class="btn btn-danger btn-sm reject-tool"
                                                data-tool-id="{{ tool.id }}">
                                            <i class="ph ph-x"></i>
                                            Ablehnen
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="text-content-muted text-center py-8">Keine ausstehenden Tools gefunden.</p>
        {% endif %}
    </div>

    {# Genehmigte Tools #}
    <div class="card p-6">
        <h2 class="card-title flex items-center gap-2">
            <i class="ph ph-check-circle text-success"></i>
            Genehmigte Tools
        </h2>
        
        {% if approved_tools is defined and approved_tools|length > 0 %}
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Tool ID</th>
                            <th>Name</th>
                            <th>Beschreibung</th>
                            <th>Genehmigt von</th>
                            <th>Datum</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for tool in approved_tools %}
                            <tr>
                                <td>{{ tool.id }}</td>
                                <td class="font-medium">{{ tool.name }}</td>
                                <td class="max-w-xs truncate" title="{{ tool.description }}">{{ tool.description }}</td>
                                <td>{{ tool.approvedBy }}</td>
                                <td>{{ tool.approvedAt|date('d.m.Y H:i') }}</td>
                                <td>
                                    <span class="badge badge-approved">Genehmigt</span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="text-content-muted text-center py-8">Keine genehmigten Tools gefunden.</p>
        {% endif %}
    </div>

    {# Abgelehnte Tools #}
    <div class="card p-6">
        <h2 class="card-title flex items-center gap-2">
            <i class="ph ph-x-circle text-danger"></i>
            Abgelehnte Tools
        </h2>
        
        {% if rejected_tools is defined and rejected_tools|length > 0 %}
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Tool ID</th>
                            <th>Name</th>
                            <th>Beschreibung</th>
                            <th>Abgelehnt von</th>
                            <th>Datum</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for tool in rejected_tools %}
                            <tr>
                                <td>{{ tool.id }}</td>
                                <td class="font-medium">{{ tool.name }}</td>
                                <td class="max-w-xs truncate" title="{{ tool.description }}">{{ tool.description }}</td>
                                <td>{{ tool.rejectedBy }}</td>
                                <td>{{ tool.rejectedAt|date('d.m.Y H:i') }}</td>
                                <td>
                                    <span class="badge badge-rejected">Abgelehnt</span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="text-content-muted text-center py-8">Keine abgelehnten Tools gefunden.</p>
        {% endif %}
    </div>
</div>
{% endblock %}