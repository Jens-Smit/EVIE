{% extends 'base.html.twig' %}

{% block title %}EVIE - Tools verwalten{% endblock %}

{% block body %}
<div class="card">
    <h2 class="card-title">Ausstehende Tools</h2>
    
    {% if pending_tools is defined and pending_tools|length > 0 %}
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Tool ID</th>
                        <th>Name</th>
                        <th>Beschreibung</th>
                        <th>Angefragt von</th>
                        <th>Datum</th>
                        <th>Status</th>
                        <th>Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    {% for tool in pending_tools %}
                        <tr>
                            <td>{{ tool.id }}</td>
                            <td>{{ tool.name }}</td>
                            <td>{{ tool.description }}</td>
                            <td>{{ tool.requestedBy }}</td>
                            <td>{{ tool.requestedAt|date('d.m.Y H:i') }}</td>
                            <td>
                                <span class="badge badge-pending">Ausstehend</span>
                            </td>
                            <td>
                                <button 
                                    class="btn btn-success approve-tool"
                                    data-tool-id="{{ tool.id }}"
                                >
                                    Genehmigen
                                </button>
                                <button 
                                    class="btn btn-error reject-tool"
                                    data-tool-id="{{ tool.id }}"
                                >
                                    Ablehnen
                                </button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="text-center">Keine ausstehenden Tools gefunden.</p>
    {% endif %}
</div>

<div class="card mt-3">
    <h2 class="card-title">Genehmigte Tools</h2>
    
    {% if approved_tools is defined and approved_tools|length > 0 %}
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Tool ID</th>
                        <th>Name</th>
                        <th>Beschreibung</th>
                        <th>Genehmigt von</th>
                        <th>Datum</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for tool in approved_tools %}
                        <tr>
                            <td>{{ tool.id }}</td>
                            <td>{{ tool.name }}</td>
                            <td>{{ tool.description }}</td>
                            <td>{{ tool.approvedBy }}</td>
                            <td>{{ tool.approvedAt|date('d.m.Y H:i') }}</td>
                            <td>
                                <span class="badge badge-approved">Genehmigt</span>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="text-center">Keine genehmigten Tools gefunden.</p>
    {% endif %}
</div>

<div class="card mt-3">
    <h2 class="card-title">Abgelehnte Tools</h2>
    
    {% if rejected_tools is defined and rejected_tools|length > 0 %}
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Tool ID</th>
                        <th>Name</th>
                        <th>Beschreibung</th>
                        <th>Abgelehnt von</th>
                        <th>Datum</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for tool in rejected_tools %}
                        <tr>
                            <td>{{ tool.id }}</td>
                            <td>{{ tool.name }}</td>
                            <td>{{ tool.description }}</td>
                            <td>{{ tool.rejectedBy }}</td>
                            <td>{{ tool.rejectedAt|date('d.m.Y H:i') }}</td>
                            <td>
                                <span class="badge badge-rejected">Abgelehnt</span>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="text-center">Keine abgelehnten Tools gefunden.</p>
    {% endif %}
</div>
{% endblock %}