{% extends 'base.html.twig' %}

{% block title %}EVIE - Ausstehende Tools{% endblock %}

{% block body %}
    <div class="bg-white rounded-lg shadow p-6">
        <h1 class="text-2xl font-bold text-secondary mb-4">Ausstehende Tools</h1>
        <p class="text-gray-700 mb-6">Hier siehst du Tools, die auf deine Freigabe warten.</p>

        {% if tools is defined and tools|length > 0 %}
            <div class="space-y-4">
                {% for tool in tools %}
                    <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                        <h3 class="text-lg font-bold text-secondary mb-2">{{ tool.name }}</h3>
                        <p class="text-gray-700 mb-2">{{ tool.description }}</p>
                        <p class="text-sm text-gray-500 mb-4">
                            Anfragt von: <strong>{{ tool.requester }}</strong> |
                            {{ tool.timestamp is not null ? tool.timestamp|date('d.m.Y H:i') : 'Unbekannt' }}
                        </p>
                        <div class="flex gap-2">
                            <button
                                class="bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 transition approve-tool"
                                data-tool-id="{{ tool.id }}"
                            >
                                Freigeben
                            </button>
                            <button
                                class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition reject-tool"
                                data-tool-id="{{ tool.id }}"
                            >
                                Ablehnen
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded-lg">
                <strong>Hinweis:</strong> Es sind keine Tools zur Freigabe verfügbar.
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    // Tool Approval Handler
    document.addEventListener('DOMContentLoaded', function() {
        // Approve Tool
        document.querySelectorAll('.approve-tool').forEach(button => {
            button.addEventListener('click', function() {
                const toolId = this.getAttribute('data-tool-id');
                approveTool(toolId, this.closest('.bg-gray-50'));
            });
        });
        
        // Reject Tool
        document.querySelectorAll('.reject-tool').forEach(button => {
            button.addEventListener('click', function() {
                const toolId = this.getAttribute('data-tool-id');
                rejectTool(toolId, this.closest('.bg-gray-50'));
            });
        });
    });
    </script>
{% endblock %}
