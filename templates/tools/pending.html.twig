{# templates/tools/pending.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}EVIE – Freigaben{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <div class="card p-6">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-content">Freigaben</h1>
                <p class="text-content-muted mt-1">
                    Fähigkeiten, die EVIE für deine Aufgaben benötigt – prüfe und gib frei.
                </p>
            </div>
            {% if tools is defined and tools|length > 0 %}
                <span class="badge badge-pending" id="pending-tools-total">{{ tools|length }} offen</span>
            {% endif %}
        </div>

        {% if tools is defined and tools|length > 0 %}
            <div class="space-y-4" id="pending-tools-list">
                {% for tool in tools %}
                    <div class="bg-surface-muted rounded-xl p-4 border border-border tool-item"
                         data-tool-id="{{ tool.id }}">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex-1 min-w-0">
                                <h3 class="text-lg font-bold text-content mb-2">{{ tool.name }}</h3>
                                <p class="text-content-muted mb-3">{{ tool.description }}</p>

                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-sm mb-3">
                                    <div class="bg-surface rounded-lg p-2 border border-border">
                                        <p class="text-xs text-content-subtle uppercase">Angefragt von</p>
                                        <p class="text-content font-medium">{{ tool.requester ?? 'EVIE' }}</p>
                                    </div>
                                    <div class="bg-surface rounded-lg p-2 border border-border">
                                        <p class="text-xs text-content-subtle uppercase">Risiko</p>
                                        <p class="font-medium {% if tool.security_level == 'high' %}text-danger{% elseif tool.security_level == 'medium' %}text-warning{% else %}text-success{% endif %}">
                                            {% if tool.security_level == 'high' %}Hoch{% elseif tool.security_level == 'medium' %}Mittel{% else %}Niedrig{% endif %}
                                        </p>
                                    </div>
                                    <div class="bg-surface rounded-lg p-2 border border-border">
                                        <p class="text-xs text-content-subtle uppercase">Erstellt</p>
                                        <p class="text-content font-medium">
                                            {{ tool.timestamp is not null ? tool.timestamp|date('d.m.Y H:i') : 'Unbekannt' }}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <button type="button"
                                    class="btn btn-success approve-tool"
                                    data-tool-id="{{ tool.id }}"
                                    data-token="{{ csrf_token('tool_approval') }}"
                                    data-action="approve">
                                <i class="ph ph-check"></i>
                                Freigeben
                            </button>
                            <button type="button"
                                    class="btn btn-danger reject-tool"
                                    data-tool-id="{{ tool.id }}"
                                    data-token="{{ csrf_token('tool_approval') }}"
                                    data-action="reject">
                                <i class="ph ph-x"></i>
                                Ablehnen
                            </button>
                            <a href="{{ path('app_tool_pending_show', {'id': tool.id}) }}"
                               class="btn btn-ghost">
                                <i class="ph ph-info"></i>
                                Details
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="bg-info-soft border border-info/20 text-info px-4 py-3 rounded-xl flex items-center gap-2">
                <i class="ph ph-info text-lg"></i>
                <div>
                    <strong>Alles erledigt.</strong> Es warten keine Fähigkeiten auf deine Freigabe.
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    window.EVIE = window.EVIE || {};
    window.EVIE.initToolApproval = function() {
        document.querySelectorAll('.tool-item').forEach(function(item) {
            if (item.dataset.initialized === 'true') return;
            item.dataset.initialized = 'true';

            const approveBtn = item.querySelector('.approve-tool');
            const rejectBtn = item.querySelector('.reject-tool');
            if (!approveBtn || !rejectBtn) return;

            approveBtn.addEventListener('click', async function() {
                await window.EVIE.handleToolAction(approveBtn.dataset.toolId, 'approve', approveBtn, item);
            });
            rejectBtn.addEventListener('click', async function() {
                await window.EVIE.handleToolAction(rejectBtn.dataset.toolId, 'reject', rejectBtn, item);
            });
        });
    };

    window.EVIE.handleToolAction = async function(toolId, action, button, toolItem) {
        const approveBtn = toolItem.querySelector('.approve-tool');
        const rejectBtn = toolItem.querySelector('.reject-tool');
        const originalHtml = button.innerHTML;

        approveBtn.disabled = true;
        rejectBtn.disabled = true;
        button.innerHTML = '<i class="ph ph-spinner"></i> Verarbeiten...';

        try {
            const body = new URLSearchParams();
            body.set('_token', button.dataset.token || '');
            if (action === 'reject') {
                const reason = prompt('Warum lehnst du diese Fähigkeit ab? (optional)');
                if (reason) body.set('reason', reason);
            }

            const response = await fetch('/tools/pending/' + toolId + '/' + action, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'X-CSRF-TOKEN': button.dataset.token || ''
                },
                body: body.toString()
            });

            const data = await response.json();

            if (!response.ok || data.status !== 'success') {
                throw new Error(data.message || 'Server antwortete mit Status ' + response.status);
            }

            showToast(data.message || (action === 'approve'
                ? 'Fähigkeit freigegeben'
                : 'Fähigkeit abgelehnt'), 'success');

            toolItem.style.opacity = '0.5';
            setTimeout(function() {
                toolItem.remove();
                window.EVIE.refreshPendingToolsBadge && window.EVIE.refreshPendingToolsBadge();

                const remaining = document.querySelectorAll('.tool-item').length;
                const counter = document.getElementById('pending-tools-total');
                if (counter) {
                    if (remaining === 0) {
                        counter.remove();
                    } else {
                        counter.textContent = remaining + ' offen';
                    }
                }
            }, 500);
        } catch (error) {
            showToast(error.message || 'Fehler bei der Aktion', 'error');
            approveBtn.disabled = false;
            rejectBtn.disabled = false;
            button.innerHTML = originalHtml;
        }
    };

    document.addEventListener('DOMContentLoaded', function() { window.EVIE.initToolApproval(); });
    </script>
{% endblock %}
