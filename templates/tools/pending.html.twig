{# templates/tools/pending.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}EVIE – Ausstehende Tools{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <div class="card p-6">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-content">Ausstehende Tools</h1>
                <p class="text-content-muted mt-1">Hier siehst du Tools, die auf deine Freigabe warten.</p>
            </div>
            {% if tools is defined and tools|length > 0 %}
                <span class="badge badge-pending">{{ tools|length }} offen</span>
            {% endif %}
        </div>

        {% if tools is defined and tools|length > 0 %}
            <div class="space-y-4">
                {% for tool in tools %}
                    <div class="bg-surface-muted rounded-xl p-4 border border-border tool-item">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex-1 min-w-0">
                                <h3 class="text-lg font-bold text-content mb-2">{{ tool.name }}</h3>
                                <p class="text-content-muted mb-2">{{ tool.description }}</p>
                                <p class="text-sm text-content-subtle mb-4">
                                    Anfragt von: <strong class="text-content">{{ tool.requester }}</strong> |
                                    {{ tool.timestamp is not null ? tool.timestamp|date('d.m.Y H:i') : 'Unbekannt' }}
                                </p>
                            </div>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <button
                                class="btn btn-success approve-tool"
                                data-tool-id="{{ tool.id }}"
                            >
                                <i class="ph ph-check"></i>
                                Freigeben
                            </button>
                            <button
                                class="btn btn-danger reject-tool"
                                data-tool-id="{{ tool.id }}"
                            >
                                <i class="ph ph-x"></i>
                                Ablehnen
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="bg-info-soft border border-info/20 text-info px-4 py-3 rounded-xl flex items-center gap-2">
                <i class="ph ph-info text-lg"></i>
                <div>
                    <strong>Hinweis:</strong> Es sind keine Tools zur Freigabe verfügbar.
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}