{# templates/approvals/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}EVIE – Freigaben{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto space-y-6">
    <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-content">Freigaben</h1>
            <p class="text-sm text-content-muted mt-1">
                Alles, worauf EVIE gerade von dir wartet – an einem Ort.
            </p>
        </div>
        <span class="badge badge-pending" id="approvals-total">
            {{ items|length }} offen
        </span>
    </div>

    {% if items|length > 0 %}
        <div class="space-y-4" id="approvals-list">
            {% for item in items %}
                <div class="card p-5 approval-item" data-kind="{{ item.kind }}" data-id="{{ item.id }}">
                    <div class="flex items-start justify-between gap-4 flex-wrap">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1">
                                {% if item.kind == 'tool' %}
                                    <span class="badge badge-info">
                                        <i class="ph ph-lightning"></i>
                                        Neue Fähigkeit
                                    </span>
                                {% else %}
                                    <span class="badge badge-pending">
                                        <i class="ph ph-seal-question"></i>
                                        Entscheidung
                                    </span>
                                {% endif %}
                                <span class="text-xs text-content-subtle">
                                    {% if item.risk == 'high' %}
                                        <span class="text-danger font-medium">Risiko: Hoch</span>
                                    {% elseif item.risk == 'medium' %}
                                        <span class="text-warning font-medium">Risiko: Mittel</span>
                                    {% else %}
                                        <span class="text-success font-medium">Risiko: Niedrig</span>
                                    {% endif %}
                                </span>
                            </div>
                            <h3 class="font-bold text-lg text-content">{{ item.title }}</h3>
                            <p class="text-sm text-content-muted mt-1">{{ item.detail }}</p>
                            {% if item.summary and item.summary != item.detail %}
                                <p class="text-sm text-content-subtle mt-1">{{ item.summary }}</p>
                            {% endif %}
                        </div>
                    </div>
                    <div class="mt-4 flex flex-wrap gap-2">
                        {% if item.kind == 'tool' %}
                            <a href="{{ path('app_tool_pending_show', {'id': item.id}) }}" class="btn btn-primary">
                                <i class="ph ph-eye"></i>
                                Prüfen
                            </a>
                        {% else %}
                            <a href="{{ path('app_decisions') }}" class="btn btn-primary">
                                <i class="ph ph-eye"></i>
                                Prüfen
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="card p-8 text-center">
            <div class="w-16 h-16 rounded-full bg-success-soft flex items-center justify-center mx-auto mb-4">
                <i class="ph ph-check-circle text-success text-3xl"></i>
            </div>
            <h2 class="text-xl font-bold text-content mb-2">Keine Freigaben erforderlich</h2>
            <p class="text-content-muted">
                EVIE wartet aktuell auf nichts. Neue Freigaben erscheinen hier,
                sobald EVIE eine Fähigkeit oder Aktion von dir braucht.
            </p>
            <div class="mt-6">
                <a href="{{ path('frontend_agent_dialog') }}" class="btn btn-primary">
                    <i class="ph ph-chats-teardrop"></i>
                    EVIE eine Aufgabe stellen
                </a>
            </div>
        </div>
    {% endif %}

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="card p-5">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-info-soft flex items-center justify-center shrink-0">
                    <i class="ph ph-lightning text-info text-xl"></i>
                </div>
                <div>
                    <p class="font-bold text-content">Fähigkeiten</p>
                    <p class="text-sm text-content-muted">{{ toolCount }} warten auf Freigabe</p>
                </div>
            </div>
            <a href="{{ path('app_tool_pending_list') }}" class="btn btn-ghost w-full mt-4">
                Alle Fähigkeits-Freigaben
                <i class="ph ph-arrow-right"></i>
            </a>
        </div>
        <div class="card p-5">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-warning-soft flex items-center justify-center shrink-0">
                    <i class="ph ph-seal-question text-warning text-xl"></i>
                </div>
                <div>
                    <p class="font-bold text-content">Entscheidungen</p>
                    <p class="text-sm text-content-muted">{{ decisionCount }} warten auf deine Entscheidung</p>
                </div>
            </div>
            <a href="{{ path('app_decisions') }}" class="btn btn-ghost w-full mt-4">
                Alle Entscheidungen
                <i class="ph ph-arrow-right"></i>
            </a>
        </div>
    </div>
</div>
{% endblock %}
