<!DOCTYPE html>
<html lang="de" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{% block title %}EVIE - AI Agent Workspace{% endblock %}</title>
    
    <!-- CSRF Token für AJAX-Anfragen -->
    <meta name="csrf-token" content="{{ csrf_token('') }}">
    
    <!-- Tailwind CSS (kompiliertes Design-System) -->
    <link rel="stylesheet" href="{{ asset('assets/styles/tailwind.css') }}">
    <!-- Phosphor Icons: lokal ausgeliefert (keine CDN-Abhaengigkeit, P2).
         Wichtig fuer Kanzleien/Sachverstaendige mit isolierten Netzwerken. -->
    <link rel="stylesheet" href="{{ asset('assets/vendor/phosphor/phosphor.css') }}">
    
    <!-- Custom Styles -->
    <style>
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { 
            background: #cbd5e1; 
            border-radius: 10px; 
        }
        .dark ::-webkit-scrollbar-thumb { background: #334155; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        body { 
            height: 100dvh; 
            -webkit-tap-highlight-color: transparent; 
        }
        .hide { display: none !important; }
        
        .fade-in { 
            animation: fadeIn 0.3s ease-in-out forwards; 
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .typing-dot { animation: typing 1.4s infinite ease-in-out; }
        .typing-dot:nth-child(1) { animation-delay: 0s; }
        .typing-dot:nth-child(2) { animation-delay: 0.2s; }
        .typing-dot:nth-child(3) { animation-delay: 0.4s; }
        @keyframes typing {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-3px); }
        }

        /* Reusable Glass Panel Class for Light/Dark Mode */
        .glass-panel {
            @apply bg-white/70 dark:bg-slate-800/70 backdrop-blur-xl border border-slate-200 dark:border-slate-700/50 shadow-sm dark:shadow-none;
        }
        .nav-btn.active {
            @apply bg-primary/10 dark:bg-primary/20 border-primary/30 text-primary dark:text-white;
        }
        .nav-btn.inactive {
            @apply text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 border-transparent;
        }
        
        /* HTMX Loading Indicator */
        .htmx-indicator {
            @apply opacity-0 transition-opacity duration-300;
        }
        .htmx-request .htmx-indicator {
            @apply opacity-100;
        }
        
        /* HTMX Transitions */
        .htmx-add,
        .htmx-swap,
        .htmx-settle {
            @apply transition-all duration-300 ease-in-out;
        }
        
        /* HTMX Swap Classes */
        .htmx-swap-innerHTML {
            @apply opacity-0;
        }
        .htmx-settled .htmx-swap-innerHTML {
            @apply opacity-100;
        }
    </style>
    
    {# HTMX Configuration #}
    <script>
        // HTMX muss vor Alpine.js geladen werden
        window.htmxConfig = {
            history: true,
            historyCacheSize: 10,
            debug: {{ app.debug ? 'true' : 'false' }},
            timeout: 10000,
            scroll: 'body',
            scrollBehavior: 'smooth',
            settle: 200,
            swap: 'innerHTML',
            transition: true,
            indicator: '.htmx-indicator',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        };
    </script>
    
    {# HTMX + Alpine.js Bibliotheken (im <head>, damit hx-boost sie nicht bei jeder Navigation neu ausfuehrt).
         Lokal ausgeliefert ueber public/assets/vendor (keine CDN-Abhaengigkeit, P2). #}
    <script src="{{ asset('assets/vendor/htmx/htmx.min.js') }}"></script>
    <script src="{{ asset('assets/vendor/htmx/json-enc.js') }}"></script>
    <script defer src="{{ asset('assets/vendor/alpine/alpine.min.js') }}"></script>

    {% block stylesheets %}{% endblock %}
</head>

<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-300 font-sans w-screen overflow-hidden flex selection:bg-primary selection:text-white relative transition-colors duration-300"
      hx-boost="true">
    
    <!-- Hintergrund Effekte -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none transition-opacity duration-300">
        <div class="absolute top-[-10%] left-[-10%] w-64 h-64 md:w-96 md:h-96 bg-primary opacity-30 dark:opacity-20 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[80px] md:blur-[100px] animate-blob"></div>
        <div class="absolute top-[20%] right-[-10%] w-64 h-64 md:w-96 md:h-96 bg-secondary opacity-30 dark:opacity-20 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[80px] md:blur-[100px] animate-blob" style="animation-delay: 2s;"></div>
        <div class="absolute bottom-[-20%] left-[20%] w-64 h-64 md:w-96 md:h-96 bg-emerald-500 opacity-20 dark:opacity-10 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[80px] md:blur-[100px] animate-blob" style="animation-delay: 4s;"></div>
    </div>

    <!-- Mobile Sidebar Backdrop -->
    <div id="sidebar-backdrop" class="fixed inset-0 bg-slate-900/60 z-40 hidden opacity-0 transition-opacity duration-300 backdrop-blur-sm" onclick="toggleSidebar()"></div>

    <!-- Sidebar Navigation -->
    {% include 'components/_sidebar.html.twig' %}
    
    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col h-full z-10 relative min-w-0">
        <!-- Header -->
        {% include 'components/_header.html.twig' %}
        
        <!-- Dynamic View Container -->
        <div class="flex-1 overflow-y-auto overflow-x-hidden p-4 md:p-8 relative" id="content-area">
            {% block body %}{% endblock %}
        </div>
    </main>
    
    <!-- Global Modal -->
    {% include 'components/_modal.html.twig' %}

    <!-- Toast Container -->
    <div id="toast-container" 
         class="fixed bottom-4 left-1/2 transform -translate-x-1/2 z-[110] 
                flex flex-col gap-2 pointer-events-none w-max"></div>
    
    <!-- HTMX Global Indicator -->
    <div id="htmx-global-indicator" 
         class="htmx-indicator fixed top-4 right-4 z-50">
        <div class="bg-slate-800 dark:bg-slate-700 text-white px-4 py-2 rounded-lg shadow-lg">
            <div class="flex items-center gap-2">
                <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></div>
                <span>Loading...</span>
            </div>
        </div>
    </div>
    
    <!-- JavaScript -->
    <script>
        // -- Theme Toggle Logic (persistent via localStorage, P2) --
        function toggleTheme() {
            const html = document.documentElement;
            const icon = document.getElementById('theme-icon');

            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                try { localStorage.setItem('evie-theme', 'light'); } catch (e) {}
                if (icon) icon.classList.replace('ph-sun', 'ph-moon');
                showToast('Light Mode aktiviert', 'info');
            } else {
                html.classList.add('dark');
                try { localStorage.setItem('evie-theme', 'dark'); } catch (e) {}
                if (icon) icon.classList.replace('ph-moon', 'ph-sun');
                showToast('Dark Mode aktiviert', 'info');
            }
        }

        // -- Theme beim Laden anwenden (vor erstem Paint, um Flackern zu verhindern) --
        (function () {
            try {
                var saved = localStorage.getItem('evie-theme');
                var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                var html = document.documentElement;
                var icon = document.getElementById('theme-icon');
                if (saved === 'light' || (saved === null && !prefersDark)) {
                    html.classList.remove('dark');
                    if (icon) icon.classList.replace('ph-sun', 'ph-moon');
                } else {
                    html.classList.add('dark');
                }
            } catch (e) { /* localStorage nicht verfuegbar -> Dark Default */ }
        })();

        // -- Zentrale, idempotente Initialisierungs-Registry (P2.3) --
        // Seiten registrieren ihre init-Funktionen unter window.EVIE.init<Name>.
        // reinit() ruft sie nach DOMContentLoaded UND nach jeder
        // htmx:afterSettle-Navigation auf; da init-Funktionen mit
        // data-initialized-Markern arbeiten, ist ein doppelter Aufruf harmlos.
        window.EVIE = window.EVIE || {};
        window.EVIE.reinit = function(root) {
            Object.keys(window.EVIE).forEach(function(key) {
                if (key.indexOf('init') === 0 && typeof window.EVIE[key] === 'function') {
                    try { window.EVIE[key](root); } catch (e) { console.error('EVIE init error in ' + key, e); }
                }
            });
        };

        // -- Modal Logic (P2: ersetzt Browser-Dialoge) --
        function openModal(title, icon, contentHtml, confirmLabel, confirmHandler) {
            var modal = document.getElementById('global-modal');
            var container = document.getElementById('modal-container');
            if (!modal || !container) return;

            document.getElementById('modal-title-text').textContent = title || '';
            var iconEl = document.getElementById('modal-icon');
            if (iconEl) iconEl.className = 'ph ' + (icon || 'ph-file-text');
            document.getElementById('modal-body').innerHTML = contentHtml || '';

            var confirmBtn = document.getElementById('modal-confirm-btn');
            if (confirmBtn) {
                confirmBtn.textContent = confirmLabel || 'Aktion ausfuehren';
                // Alter Handler entfernen und neuen setzen (idempotent)
                var clone = confirmBtn.cloneNode(true);
                confirmBtn.parentNode.replaceChild(clone, confirmBtn);
                clone.addEventListener('click', function () {
                    if (typeof confirmHandler === 'function') confirmHandler();
                    closeModal();
                });
            }

            modal.classList.remove('hidden');
            modal.style.display = 'flex';
            setTimeout(function () {
                modal.classList.remove('opacity-0');
                container.classList.remove('scale-95');
                container.classList.add('scale-100');
            }, 10);
        }

        function closeModal() {
            var modal = document.getElementById('global-modal');
            var container = document.getElementById('modal-container');
            if (!modal || !container) return;
            modal.classList.add('opacity-0');
            container.classList.remove('scale-100');
            container.classList.add('scale-95');
            setTimeout(function () {
                modal.classList.add('hidden');
                modal.style.display = 'none';
            }, 300);
        }

        // -- Toast Notification System --
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            let icon = 'ph-info';
            let colors = 'bg-slate-800 text-white border-slate-700';
            
            if(type === 'success') { 
                icon = 'ph-check-circle text-emerald-400'; 
                colors = 'bg-slate-900 text-white border-emerald-500/30'; 
            }
            if(type === 'error') { 
                icon = 'ph-warning-circle text-red-400'; 
                colors = 'bg-slate-900 text-white border-red-500/30'; 
            }

            toast.className = `flex items-center gap-2 px-4 py-2.5 rounded-full border shadow-xl text-sm font-medium animate-slide-up pointer-events-auto ${colors}`;
            toast.innerHTML = `<i class="ph ${icon} text-lg"></i> <span>${message}</span>`;
            
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translate(-50%, 20px)';
                toast.style.transition = 'all 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // -- Mobile Sidebar Logic --
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const backdrop = document.getElementById('sidebar-backdrop');
            const isClosed = sidebar.classList.contains('-translate-x-full');
            
            if (isClosed) {
                sidebar.classList.remove('-translate-x-full');
                backdrop.classList.remove('hidden');
                setTimeout(() => backdrop.classList.remove('opacity-0'), 10);
            } else {
                sidebar.classList.add('-translate-x-full');
                backdrop.classList.add('opacity-0');
                setTimeout(() => backdrop.classList.add('hidden'), 300);
            }
        }

        // -- View Switching Logic --
        function switchView(viewId) {
            document.querySelectorAll('.view-section').forEach(el => {
                el.classList.add('hide');
                el.classList.remove('fade-in');
            });
            
            document.querySelectorAll('.nav-btn').forEach(el => {
                el.classList.remove('active');
                el.classList.add('inactive');
            });

            const target = document.getElementById('view-' + viewId);
            if(target) {
                target.classList.remove('hide');
                target.classList.add('fade-in');
                document.getElementById('content-area').scrollTop = 0;
            }

            const navBtn = document.querySelector(`.nav-btn[data-target="${viewId}"]`);
            if(navBtn) {
                navBtn.classList.remove('inactive');
                navBtn.classList.add('active');
            }

            if(window.innerWidth < 768 && !document.getElementById('sidebar').classList.contains('-translate-x-full')) {
                toggleSidebar();
            }
        }

        // -- Window Resize Handler --
        window.addEventListener('resize', () => {
            if(window.innerWidth >= 768) {
                document.getElementById('sidebar-backdrop').classList.add('hidden', 'opacity-0');
            }
        });
    </script>
    
    {# HTMX Configuration Script #}
    <script>
        // HTMX Configuration
        document.addEventListener('DOMContentLoaded', function() {
            // HTMX Debugging
            {% if app.debug %}
                htmx.logAll();
                console.log('HTMX Debug Mode: ENABLED');
            {% endif %}
            
            // HTMX Global Settings
            htmx.config.timeout = 10000;
            htmx.config.indicatorClass = 'htmx-indicator';
            htmx.config.defaultSwapStyle = 'innerHTML';
            htmx.config.scrollBehavior = 'smooth';
            
          
            // HTMX Event Listeners
            htmx.onLoad(function(content) {
                // Auto-refresh für bestimmte Elemente
                const autoRefreshElements = content.querySelectorAll('[data-auto-refresh]');
                autoRefreshElements.forEach(function(element) {
                    const interval = parseInt(element.getAttribute('data-auto-refresh')) || 5000;
                    setInterval(function() {
                        htmx.trigger(element, 'load');
                    }, interval);
                });
            });
            
            // HTMX Before Request
            htmx.on('htmx:beforeRequest', function(evt) {
                const indicator = document.getElementById('htmx-global-indicator');
                if (indicator) {
                    indicator.classList.remove('htmx-indicator');
                }
            });
            
            // HTMX After Request
            htmx.on('htmx:afterRequest', function(evt) {
                const indicator = document.getElementById('htmx-global-indicator');
                if (indicator) {
                    indicator.classList.add('htmx-indicator');
                }
            });
            
            // HTMX Error Handling
            htmx.on('htmx:responseError', function(evt) {
                console.error('HTMX Error:', evt.detail.xhr.status, evt.detail.xhr.statusText);
                showToast('Fehler: ' + evt.detail.xhr.status + ' - ' + evt.detail.xhr.statusText, 'error');
            });
            
            // HTMX Before Swap - Add fade-out class
            htmx.on('htmx:beforeSwap', function(evt) {
                evt.detail.elt.classList.add('opacity-0', 'transition-opacity', 'duration-300');
            });
            
            // HTMX After Swap - Remove fade-out class and add fade-in
            htmx.on('htmx:afterSwap', function(evt) {
                evt.detail.elt.classList.remove('opacity-0');
                evt.detail.elt.classList.add('opacity-100');
            });

            // HTMX After Settle - Initialize components inserted by boosted
            // navigation. Alpine only walks the DOM once on load; new x-data
            // elements swapped in afterwards must be initialized explicitly,
            // otherwise their reactive properties stay undefined
            // (ReferenceError: currentStep, loading, ...).
            // Zusaetzlich werden alle Seiten-Initialisierungen
            // (window.EVIE.init*) erneut ausgefuehrt: DOMContentLoaded feuert
            // bei HTMX-Boost-Navigation nicht erneut, deshalb ist dies der
            // zentrale Hook. Alle init-Funktionen sind idempotent.
            document.addEventListener('htmx:afterSettle', function(evt) {
                if (typeof Alpine !== 'undefined') {
                    Alpine.initTree(evt.detail.target);
                }
                if (window.EVIE && typeof window.EVIE.reinit === 'function') {
                    window.EVIE.reinit(evt.detail.target);
                }
            });
        });
    </script>
    
    {% block javascripts %}{% endblock %}
</body>
</html>
