<!DOCTYPE html>
<html lang="de" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EVIE - AI Agent{% endblock %}</title>
    
    <!-- CSRF Token für AJAX-Anfragen -->
    <meta name="csrf-token" content="{{ csrf_token('') }}">
    
    <!-- Tailwind CSS (nur lokal, kein CDN) -->
    <link href="{{ asset('assets/styles/tailwind.css') }}" rel="stylesheet">
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    
    <!-- Custom Styles (Glass-Panels, Scrollbar, etc.) -->
    <link href="{{ asset('assets/styles/app.css') }}" rel="stylesheet">
    
    <!-- Theme Script (inline für schnelles Laden) -->
    <script>
        // Theme initialisieren (aus localStorage oder System-Präferenz)
        (function() {
            const savedTheme = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (savedTheme === 'light' || (!savedTheme && !prefersDark)) {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
    
    {% block stylesheets %}{% endblock %}
</head>

<body class="bg-surface-muted text-content font-sans w-screen overflow-hidden flex
       relative transition-colors duration-300 selection:bg-primary selection:text-white">
    
    <!-- Hintergrund-Effekte -->
    {% include 'components/_background_effects.html.twig' %}
    
    <!-- Mobile Sidebar Backdrop -->
    <div id="sidebar-backdrop" 
         class="fixed inset-0 bg-slate-900/60 z-40 hidden opacity-0 
                transition-opacity duration-300 backdrop-blur-sm" 
         onclick="toggleSidebar()"></div>
    
    <!-- Sidebar Navigation -->
    {% include 'components/_sidebar.html.twig' %}
    
    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col h-full z-10 relative min-w-0">
        <!-- Header -->
        {% include 'components/_header.html.twig' %}
        
        <!-- Dynamic View Container -->
        <div class="flex-1 overflow-y-auto overflow-x-hidden p-4 md:p-8 relative">
            {% block body %}{% endblock %}
        </div>
    </main>
    
    <!-- Toast Container -->
    <div id="toast-container" 
         class="fixed bottom-4 left-1/2 transform -translate-x-1/2 z-[110] 
                flex flex-col gap-2 pointer-events-none w-max"></div>
    
    <!-- Modal Container -->
    {% include 'components/_modal.html.twig' %}
    
    <!-- JavaScript -->
    {% block javascripts %}
        <script src="{{ asset('assets/scripts/theme.js') }}"></script>
        <script src="{{ asset('assets/scripts/toast.js') }}"></script>
        <script src="{{ asset('assets/scripts/app.js') }}"></script>
        <script src="https://unpkg.com/htmx.org@1.9.6"></script>
        <script src="https://unpkg.com/htmx.org@1.9.6/dist/ext/json-enc.js"></script>
    {% endblock %}
</body>
</html>
