{% extends 'base.html.twig' %}

{% block title %}EVIE - Willkommen{% endblock %}

{% block body %}
<div class="container">
    <div class="card">
        <h1 class="card-title">Willkommen bei EVIE</h1>
        <p>EVIE ist dein selbst-evolvierender AI-Agent, der auf dem Symfony AI Bundle basiert.</p>
        <p>Navigiere durch die Menüpunkte, um mit dem Agenten zu interagieren, den Verlauf einzusehen oder Tools zu verwalten.</p>
        
        <div class="mt-3">
            <a href="{{ path('agent_dialog') }}" class="btn">AI Dialog starten</a>
            <a href="{{ path('frontend_agent_history') }}" class="btn btn-secondary">Verlauf anzeigen</a>
            <a href="{{ path('tools_pending') }}" class="btn btn-secondary">Ausstehende Tools</a>
        </div>
    </div>
    
    <div class="card mt-3">
        <h2 class="card-title">Systemstatus</h2>
        <div class="alert alert-info">
            <strong>Status:</strong> Alle Systeme sind operativ.
        </div>
    </div>
</div>
{% endblock %}
