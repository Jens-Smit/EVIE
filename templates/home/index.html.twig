{% extends 'base.html.twig' %}

{% block title %}EVIE - Willkommen{% endblock %}

{% block body %}
    <div class="bg-white rounded-lg shadow p-6 mb-6">
        <h1 class="text-2xl font-bold text-secondary mb-4">Willkommen bei EVIE</h1>
        <p class="text-gray-700 mb-4">
            EVIE ist dein selbst-evolvierender AI-Agent, der auf dem Symfony AI Bundle basiert.
        </p>
        <p class="text-gray-700 mb-6">
            Navigiere durch die Menüpunkte, um mit dem Agenten zu interagieren, den Verlauf einzusehen oder Tools zu verwalten.
        </p>
        
        <div class="flex gap-4">
            <a href="{{ path('frontend_agent_dialog') }}" class="bg-primary text-white px-4 py-2 rounded hover:bg-secondary transition">
                AI Dialog starten
            </a>
            <a href="{{ path('frontend_agent_history') }}" class="bg-accent text-white px-4 py-2 rounded hover:bg-blue-600 transition">
                Verlauf anzeigen
            </a>
            <a href="{{ path('frontend_tools_pending') }}" class="bg-accent text-white px-4 py-2 rounded hover:bg-blue-600 transition">
                Ausstehende Tools
            </a>
        </div>
    </div>
    
    <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-xl font-bold text-secondary mb-4">Systemstatus</h2>
        <div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded">
            <strong>Status:</strong> Alle Systeme sind operativ.
        </div>
    </div>
{% endblock %}
