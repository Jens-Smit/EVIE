{# templates/htmx/partials/_mcp_tool_result.html.twig #}

<div class="mcp-tool-result border rounded p-3 mb-3 bg-light"
     hx-swap-oob="true"
     id="mcp-result-{{ timestamp|date('His') }}">
    
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0">
            <i class="fas fa-check-circle text-success me-2"></i>
            MCP-Ergebnis: {{ server_name }} / {{ tool_name }}
        </h6>
        <span class="badge bg-success">
            {{ timestamp|date('H:i:s') }}
        </span>
    </div>
    
    <div class="mcp-tool-result-content">
        {% if result is not empty %}
            {% set resultType = result is iterable and result is not string ? 'array' : result is string ? 'string' : result is object ? 'object' : 'scalar' %}
            
            {% if resultType == 'array' %}
                <pre class="bg-white dark:bg-slate-800 p-3 rounded border mb-0">{{ result|json_encode|raw }}</pre>
            {% elseif resultType == 'string' %}
                <div class="bg-white dark:bg-slate-800 p-3 rounded border">{{ result|nl2br }}</div>
            {% elseif resultType == 'object' %}
                <pre class="bg-white dark:bg-slate-800 p-3 rounded border mb-0">{{ result|json_encode|raw }}</pre>
            {% else %}
                <div class="bg-white dark:bg-slate-800 p-3 rounded border">{{ result|dump }}</div>
            {% endif %}
        {% else %}
            <div class="bg-white dark:bg-slate-800 p-3 rounded border text-muted">
                Kein Ergebnis zurückgegeben
            </div>
        {% endif %}
    </div>
    
    {% if arguments is defined and arguments|length > 0 %}
        <div class="mt-2 text-muted small">
            <strong>Argumente:</strong> {{ arguments|json_encode|raw }}
        </div>
    {% endif %}
</div>

<script>
// Auto-scroll zu neuem Ergebnis
const resultElement = document.getElementById('mcp-result-{{ timestamp|date('His') }}');
if (resultElement) {
    resultElement.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}
</script>
