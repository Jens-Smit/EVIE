{# templates/htmx/partials/_mcp_server_tools.html.twig #}

{% if server_name is defined and tools|length > 0 %}
    <label for="tool_name" class="form-label">Tool auswählen</label>
    <select class="form-select" id="tool_name" name="tool_name" required>
        <option value="" selected disabled>Tool auswählen...</option>
        {% for toolName, toolInfo in tools %}
            <option value="{{ toolName }}" 
                    {% if selected_tool == toolName %}selected{% endif %}>
                {{ toolName }}
                {% if toolInfo.description is defined %}
                    - {{ toolInfo.description|truncate(30) }}
                {% endif %}
            </option>
        {% else %}
            {% for toolName in tools %}
                <option value="{{ toolName }}" 
                        {% if selected_tool == toolName %}selected{% endif %}>
                    {{ toolName }}
                </option>
            {% endfor %}
        {% endfor %}
    </select>
{% elseif server_name is defined %}
    <label for="tool_name" class="form-label">Tool auswählen</label>
    <select class="form-select" id="tool_name" name="tool_name" disabled required>
        <option value="" selected disabled>Keine Tools für diesen Server verfügbar</option>
    </select>
{% else %}
    <label for="tool_name" class="form-label">Tool auswählen</label>
    <select class="form-select" id="tool_name" name="tool_name" disabled required>
        <option value="" selected disabled>Wähle zuerst einen Server</option>
    </select>
{% endif %}
