{# templates/htmx/partials/_mcp_server_list.html.twig #}

<div class="mcp-server-list">
    {% if servers|length > 0 %}
        <div class="list-group">
            {% for name, server in servers %}
                <a href="#"
                   hx-get="{{ path('htmx_mcp_server_tools', {'serverName': name}) }}"
                   hx-target="#mcp-server-tools-container"
                   hx-trigger="click"
                   hx-swap="innerHTML"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <strong>{{ name }}</strong>
                        <div class="text-content-muted small">{{ server.getType() }} Server</div>
                    </div>
                    <i class="fas fa-chevron-right text-muted"></i>
                </a>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info mb-0">
            <i class="fas fa-info-circle me-2"></i>
            Keine MCP-Server verfügbar
        </div>
    {% endif %}
</div>
