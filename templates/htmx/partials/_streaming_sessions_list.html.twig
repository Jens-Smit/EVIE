{# templates/htmx/partials/_streaming_sessions_list.html.twig #}

{% if sessions|length > 0 %}
    <div class="list-group">
        {% for session in sessions %}
            <a href="#"
               hx-get="{{ path('htmx_streaming_session_status', {'sessionId': session.sessionId}) }}"
               hx-target="#streaming-session-detail-container"
               hx-trigger="click"
               hx-swap="innerHTML"
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <div>
                    <div class="d-flex align-items-center gap-2">
                        {% set statusIcons = {
                            'pending': 'fa-clock text-secondary',
                            'running': 'fa-spinner fa-spin text-primary',
                            'completed': 'fa-check-circle text-success',
                            'failed': 'fa-exclamation-circle text-danger',
                            'cancelled': 'fa-times-circle text-warning'
                        } %}
                        <i class="fas {{ statusIcons[session.status] ?? 'fa-question-circle' }}"></i>
                        <div>
                            <strong>{{ session.toolName }}</strong>
                            <div class="text-content-muted small">
                                Session: {{ (session.sessionId|slice(0, 20)) ~ (session.sessionId|length > 20 ? '...') }}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    {% if session.progressPercentage is not null %}
                        <span class="badge bg-primary">{{ session.progressPercentage|round(1) }}%</span>
                    {% endif %}
                    <span class="text-content-muted small">{{ session.createdAt|date('H:i') }}</span>
                </div>
            </a>
        {% endfor %}
    </div>
{% else %}
    <div class="alert alert-info mb-0">
        <i class="fas fa-info-circle me-2"></i>
        Keine aktiven Streaming-Sessions
    </div>
{% endif %}
