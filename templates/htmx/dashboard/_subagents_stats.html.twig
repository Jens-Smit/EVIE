{# templates/htmx/dashboard/_subagents_stats.html.twig #}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">
            <i class="fas fa-chart-bar me-2 text-info"></i>
            Sub-Agenten Statistik
        </h6>
        <button type="button" class="btn-close" 
                hx-get="{{ path('htmx_dashboard') }}"
                hx-target="#subagents-stats-container"
                hx-trigger="click"></button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Typ</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for name, subAgent in available_subagents %}
                        <tr>
                            <td>
                                <code>{{ name }}</code>
                            </td>
                            <td>
                                {% if subAgent.getType() is defined %}
                                    <span class="badge bg-{{ subAgent.getType() == 'filesystem' ? 'primary' : subAgent.getType() == 'playwright' ? 'success' : subAgent.getType() == 'github' ? 'info' : 'secondary' }}">
                                        {{ subAgent.getType() }}
                                    </span>
                                {% else %}
                                    <span class="text-muted">Custom</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if subAgent.isActive() %}
                                    <span class="badge bg-success">Aktiv</span>
                                {% else %}
                                    <span class="badge bg-secondary">Inaktiv</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-transparent">
        <strong>{{ subagent_count }}</strong> Sub-Agenten insgesamt
    </div>
</div>
