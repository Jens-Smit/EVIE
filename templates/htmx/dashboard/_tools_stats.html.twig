{# templates/htmx/dashboard/_tools_stats.html.twig #}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">
            <i class="fas fa-chart-bar me-2 text-primary"></i>
            Tools Statistik
        </h6>
        <button type="button" class="btn-close" 
                hx-get="{{ path('htmx_dashboard') }}"
                hx-target="#tools-stats-container"
                hx-trigger="click"></button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tool-Name</th>
                        <th>Typ</th>
                    </tr>
                </thead>
                <tbody>
                    {% for toolName in available_tools|keys %}
                        <tr>
                            <td>
                                <code>{{ toolName }}</code>
                            </td>
                            <td>
                                {% if available_tools[toolName].type is defined %}
                                    {{ available_tools[toolName].type }}
                                {% else %}
                                    <span class="text-muted">Custom</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-transparent">
        <strong>{{ tool_count }}</strong> Tools insgesamt
    </div>
</div>
