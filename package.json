{
  "name": "evie",
  "version": "1.0.0",
  "description": "EVIE ist ein selbst-evolvierendes AI-Agenten-System, das auf Symfony und dem Symfony AI Bundle basiert. Es ermoeglicht die Interaktion mit einem KI-Agenten, speichert Dialogverlaeufe in einer Datenbank und unterstuetzt Tools mit Human-in-the-Loop (HITL) Freigabe.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build:css": "node build-tailwind.js",
    "watch:css": "node build-tailwind.js",
    "build": "npm run build:css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jens-Smit/EVIE.git"
  },
  "keywords": ["ai", "agent", "symfony", "php", "artificial-intelligence"],
  "author": "Jens Smit",
  "license": "AGPL-3.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Jens-Smit/EVIE/issues"
  },
  "homepage": "https://github.com/Jens-Smit/EVIE#readme",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.0"
  }
}
